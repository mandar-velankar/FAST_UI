<mvc:View
	controllerName="com.bayer.tender.landingspage.controller.App" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:tnt="sap.tnt" displayBlock="true" >

	<!-- Header tool is viewed on all apps -->
	<tnt:ToolHeader height="3rem">

		<!-- LOGO -->
		<!--<Button icon="{imageModel>/path}/Company-Logo-White.svg" type="Transparent" press="onPressLogo"/>-->
		<Image src="{imageModel>/path}/Company-Logo-White.svg" alt="logo" press="onPressLogo" height="3rem"></Image>
		
		<!-- space -->
		<!--<ToolbarSpacer/>-->
		
		<!-- Home button to go back to the tiles page -->
		<Button icon="sap-icon://home" type="Transparent" press="backHome"/>
		
		<!-- Title text -->
		<Text text="FAST Tender Framework" wrapping="false"/>

		<!-- space -->
		<ToolbarSpacer/>
		
		<!-- LOGO Project -->
		<Image src="{imageModel>/path}/FAST_LogoTransparent.png" alt="logo" width="6rem" height="3rem"></Image>
		
	</tnt:ToolHeader>

	<!-- Shell where all apps are shown -->
	<Shell title="FAST Tender Framework" appWidthLimited="false">
		<!-- height='96%' must be like this other wise the footer is not displayed -->
		<App id="app" width="100%" busyIndicatorDelay="100%" height="96%">
			<f:FlexibleColumnLayout id="flexibleColumnLayout" stateChange=".onStateChanged" layout="{/layout}"></f:FlexibleColumnLayout>
		</App>

	</Shell>
