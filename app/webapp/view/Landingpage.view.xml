<mvc:View id="MainViewId" controllerName="com.bayer.tender.landingspage.controller.Landingpage" displayBlock="true" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:tnt="sap.tnt">
	
	<!-- Icon tab bar for showing 2 tabs Business apps & Administration -->
	<IconTabBar id="navLevel0" stretchContentHeight="true" backgroundDesign="Transparent" applyContentPadding="false" class="sapUiResponsiveContentPadding" expandable="false">
		<items>
			
			<!-- Business apps tab-->		
			<IconTabFilter id="navLevel0Tab0" text="Business Apps">
				
				<!-- Use a scrollbar on a smaller screen -->
				<ScrollContainer height="100%" width="100%" horizontal="false" vertical="true">
					
                    <!-- Transactional tiles -->
                    <Panel headerText="Transactional">

						<l:VerticalLayout>
							<l:HorizontalLayout id="TileContainerExpanded0" allowWrapping="true">

								<!-- Tender management-->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Tender Management" 
									press="onTileTenderManagementPress" 
									appShortcut = "shortcut" systemInfo = "systeminfo"
									visible="{tiles>/tender}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://request" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>

								<!-- Pricing management -->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Pricing Management" 
									press="onTileEpaManagementPress"
									visible="{tiles>/epa}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://business-one" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>

								<!-- Pricing Policy management -->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Pricing Policy Management" 
									press="onTilePpaManagementPress" 
									visible="{tiles>/ppa}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://business-one" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>

								<!-- Contract management -->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Contract Management" 
									press="onTileContractManagementPress" 
									visible="{tiles>/contract}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://batch-payments" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>

								<!-- Bank Guarantees -->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Bank Guarantees" 
									press="onTileBankGuaranteesPress" 
									visible="{tiles>/bankguarantees}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://credit-card" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>
								
								<!-- Price Agreements -->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Price Agreements" 
									press="onTilePriceAgreementsPress" 
									visible="{tiles>/priceagreements}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://decision" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>
								
								
							</l:HorizontalLayout>
						</l:VerticalLayout>
					</Panel>
					
					<!-- Sales tiles -->
					<Panel headerText="Sales">
						<l:VerticalLayout>
							
							<l:HorizontalLayout id="idSalesDash" allowWrapping="true">

								<!-- Sales opportunity (Mercado Publico)-->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Sales Opportunity (Mercado Publico)" 
									press="onTileSalesOpportunityPress" 
									visible="{tiles>/salesopportunity}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://sales-notification" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>

								<!-- Create Sales opportunity -->
								<GenericTile 
									class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
									header="Create Sales Opportunity" 
									press="onTileCreateSalesOpportunityPress" 
									visible="{tiles>/createsalesopportunity}">
									<TileContent footer="Go to application...">
										<ImageContent src="sap-icon://sales-notification" class="sapUiLargeMarginBeginEnd"/>
									</TileContent>
								</GenericTile>
								
							</l:HorizontalLayout>
						</l:VerticalLayout>											
					</Panel>

				</ScrollContainer>
				
			</IconTabFilter>
			
			<!-- Administration tab -->
			<IconTabFilter id="navLevel0Tab2" text="Analytics">

				<!-- Masterdata tiles-->
				<Panel headerText="Analytics">
					<l:VerticalLayout>
							<l:HorizontalLayout id="idTransactionalDash" allowWrapping="true">
								<GenericTile 
									class="sapUiTinyMarginBegin 
									sapUiTinyMarginTop tileLayout" 
									header="Transactional Dashboard" 
									press="onTileTransDashPress">
									<TileContent footer="Go to tableau...">
										<ImageContent src="{imageModel>/path}/tableau_logo.jpg"/>
									</TileContent>
								</GenericTile>
							</l:HorizontalLayout>
						</l:VerticalLayout>

					<!-- Tender Manager Dashboard-->
						<l:VerticalLayout>
							<l:HorizontalLayout id="idTenderManagementDash" allowWrapping="true">
								<GenericTile 
									class="sapUiTinyMarginBegin 
									sapUiTinyMarginTop tileLayout" 
									header="Tender Manager Dashboard" 
									press="onTileTenderManagerDashPress">
									<TileContent footer="Go to tableau...">
										<ImageContent src="{imageModel>/path}/tableau_logo.jpg"/>
									</TileContent>
								</GenericTile>
							</l:HorizontalLayout>
						</l:VerticalLayout>	

						<!-- Caliber Connect -->
						<l:VerticalLayout>
							<l:HorizontalLayout id="idCaliberConnect" allowWrapping="true">
								<GenericTile 
									class="sapUiTinyMarginBegin 
									sapUiTinyMarginTop tileLayout" 
									header="Caliber Connect" 
									press="onTileCaliberConnectPress">
									<TileContent footer="Go to tableau...">
										<ImageContent src="{imageModel>/path}/tableau_logo.jpg"/>
									</TileContent>
								</GenericTile>
							</l:HorizontalLayout>
						</l:VerticalLayout>	

						<!-- Analytics Dashboard-->
						<l:VerticalLayout>
							<l:HorizontalLayout id="idAnalyticsDash" allowWrapping="true">
								<GenericTile
								class="sapUiTinyMarginBegin
								sapUiTinyMarginTop tileLayout"
								header="Analytics Dashboard"
								press="onTileAnalyticsDashPress">
								<TileContent footer="Go to tableau...">
									<ImageContent src="{imageModel>/path}/tableau_logo.jpg"/>
								</TileContent>
								</GenericTile>
							</l:HorizontalLayout>
						</l:VerticalLayout>
				</Panel>
			</IconTabFilter>
			
			<!-- Administration tab -->
			<IconTabFilter id="navLevel0Tab3" text="Administration" visible="{tiles>/masterdata}">

				<!-- Masterdata tiles-->
				<Panel headerText="Masterdata">
					<l:VerticalLayout>
						<l:HorizontalLayout id="TileContainerExpanded2" allowWrapping="true">
							
							<!-- Admin tile -->
							<GenericTile 
										class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" 
										header="Admin app" 
										press="onTileAdminPress"
										visible="{tiles>/masterdata}">
										<TileContent footer="Go to application...">
											<ImageContent src="sap-icon://key-user-settings" class="sapUiLargeMarginBeginEnd"/>
										</TileContent>
							</GenericTile>
							
						</l:HorizontalLayout>
					</l:VerticalLayout>
				</Panel>
			</IconTabFilter>
			
		</items>
	</IconTabBar>
</mvc:View>