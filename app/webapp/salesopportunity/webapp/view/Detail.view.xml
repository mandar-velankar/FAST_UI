<mvc:View
	controllerName="com.bayer.tender.salesopportunity.controller.Detail"
	xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" 
	xmlns:viz="sap.viz.ui5.controls" 
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:tnt="sap.tnt">

	<!-- ObjectPage Layout -->
	<ObjectPageLayout 
		id="DetailPage" 
		showTitleInHeaderContent="true" 
		alwaysShowContentHeader="true" 
		preserveHeaderStateOnScroll="false"
		headerContentPinnable="true" 
		isChildPage="true" 
		toggleHeaderOnTitleClick="true" 
		showFooter="false" 
		upperCaseAnchorBar="false"
		enableLazyLoading="false" 
		useIconTabBar="true" 
		navigate="onNavigate"
		selectedSection="basicInformationId"
		showAnchorBarPopover="false">

	<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				
				<!-- Heading part that is used when heading is not collapsed -->
				<expandedHeading>
					<m:Title text="{fastData>TenderID}" id="tenderId" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>

				<!-- WINDOW ACTIONS -->
				<navigationActions>
					<m:OverflowToolbarButton id="enterFullScreenButton" type="Transparent" icon="sap-icon://full-screen" press=".toggleFullScreen"
						tooltip="Enter Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}" />
					<m:OverflowToolbarButton id="exitFullScreenButton" type="Transparent" icon="sap-icon://exit-full-screen" press=".toggleFullScreen"
						tooltip="Exit Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"/>
					<m:OverflowToolbarButton id="closeScreenButton" type="Transparent" icon="sap-icon://decline" press=".onCloseDetailPress" tooltip="Close column"
						visible="true"/>
				</navigationActions>
				
				<!-- ACTIONS -->
				<actions>
					<m:Button id="participateButtonId" icon="sap-icon://action" text="{= ${soa>/selectedOpportunity/mainStatus}==='Participated'?${i18n>goToTender}:${i18n>participate}}" type="Emphasized" press="onParticipateOpportunityPress" enabled="true" />
					<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditModePress" enabled="{= ${soa>/editMode} === false ? true : false }"/>
				</actions>
				
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
				
				<!-- LOGO 
				<f:Avatar src="{imageModel>/path}/Company-Logo-Blue.svg" displaySize="L" displayShape="Square" class="sapUiTinyMarginEnd"></f:Avatar>
				-->
				
				<!-- INSTITUTE INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="Code"/>
					<m:Text id="idhdrInstNme" text="{soa>/selectedOpportunity/codigoExterno}"/>
				</m:VBox>

				<!-- SELECTED CONTRACT -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="Name"/>
					<m:Text  text="{soa>/selectedOpportunity/name}"/>
				</m:VBox>

				<!-- SELECTED CONTRACT INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="Institute"/>
					<m:Text text="{soa>/selectedOpportunity/buyer/organismNumber}"/>
				</m:VBox>				
				
				<!-- SELECTED PRODUCT INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="Closing Date"/>
					<m:Text text="{
										path: 'soa>/selectedOpportunity/closingDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
				</m:VBox>	
			</m:FlexBox>
		</headerContent>

		<sections>
			<!-- OPPORTUNITY INFORMATION TAB -->
			<ObjectPageSection id="opportunityInfoId" title="Opportunity Info"  visible="true">
					<ObjectPageSubSection mode="Expanded" title="Comment">
						<actions>
							<m:Switch state="{= ${soa>/selectedOpportunity/tenderMatchingStatus} === 'In' ? true : false }" change="onTenderMatchingStatusChange" customTextOn="In" customTextOff="Out" enabled="{= ${soa>/editMode} === true }">
								<m:layoutData>
									<m:FlexItemData growFactor="1" />
								</m:layoutData>
							</m:Switch>
						</actions>
						<form:SimpleForm id="opportunityCommentFormId" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout"  labelSpanL="12" labelSpanM="12"
								emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="true" backgroundDesign="Solid">
								<form:content>
									<!-- <core:Title text="Comment"/>-->
									<m:TextArea value="{soa>/selectedOpportunity/description}" growing="true" width="100%" enabled="{= ${soa>/editMode} === true }"/>
								</form:content>
						</form:SimpleForm>
					</ObjectPageSubSection>	

					<ObjectPageSubSection mode="Expanded" title="Opportunity Details">
						<form:SimpleForm editable="true" title="" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
										adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
										singleContainerFullSize="false" backgroundDesign="Solid" id="opportunityDetailsFormId">
							<form:content>
								<core:Title text="Opportunity Details &amp; Type"/>
								<m:Label text="{i18n>extnCode}" design="Bold"  required="true"/>
								<m:Input value="{soa>/selectedOpportunity/codigoExterno}"  enabled="false"/>

								<m:Label text="{i18n>Name}" design="Bold" required="true"/>
								<m:Input  value="{soa>/selectedOpportunity/name}"  enabled="false" />

								<m:Label text="{i18n>Description}" design="Bold" required="true"/>
								<m:Input  value="{soa>/selectedOpportunity/description}"  enabled="false" />

								<m:Label text="{i18n>Status}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/status}"  enabled="false" />

								<m:Label text="{i18n>StatusCode}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/stateCode}"  enabled="false" />

								<m:Label text="{i18n>Type}" design="Bold" required="true"/>
								<m:Input  value="{soa>/selectedOpportunity/tenderType}"  enabled="false" />

								<m:Label text="{i18n>CallType}" design="Bold" required="true"/>
								<m:Input  value="{soa>/selectedOpportunity/callType}"  enabled="false" />

								<m:Label text="{i18n>currency}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/currency}"  enabled="false" />

								<m:Label text="{i18n>stages}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/stages}"  enabled="false" />

								<m:Label text="{i18n>reason}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/reason}"  enabled="false" />

								<m:Label text="{i18n>contract}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/contract}"  enabled="false" />

								<m:Label text="{i18n>visitAddr}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/visitAddress}"  enabled="false" />
								
								<m:Label text="{i18n>delivAddr}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/deliveryAddress}"  enabled="false" />

								<m:Label text="{i18n>estimate}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/estimate}"  enabled="false" />

								<m:Label text="{i18n>financingSource}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/financingSource}"  enabled="false" />

								<m:Label text="{i18n>amountVisi}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/visibilityAmount}"  enabled="false" />

								<m:Label text="{i18n>estimatedAmount}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/estimatedAmount}"  enabled="false" />

								<m:Label text="{i18n>Tiempo}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/tenderTime}"  enabled="false" />

								<m:Label text="{i18n>tiempoUnit}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/unitTime}"  enabled="false" />

								<m:Label text="{i18n>modality}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/modality}" type="Number" enabled="false" />

								<m:Label text="{i18n>paymentType}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/paymentType}"  enabled="false" />

								<m:Label text="{i18n>ContractingProhibition}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/contractingProhibition}"  enabled="false" />
								
								<m:Label text="{i18n>SubContracting}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/subContracting}"  enabled="false" />

								<m:Label text="{i18n>EstimatedJustificationAmount}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/estimatedJustificationAmount}"  enabled="false" />

								<m:Label text="{i18n>ContractObservation}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/contractObservation}"  enabled="false" />

								<m:Label text="{i18n>extensionTerm}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/extensionTerm}"  enabled="false" />

								<m:Label text="{i18n>IsBaseType}" design="Bold" required="true"/>
								<m:CheckBox selected="{= ${soa>/selectedOpportunity/isBaseType} === 0 || ${soa>/selectedOpportunity/isBaseType} === undefined ? false : true }" enabled="false" />

								<m:Label text="{i18n>IsRenewable}" design="Bold" required="true"/>
								<m:CheckBox selected="{= ${soa>/selectedOpportunity/isRenewable} === 0 || ${soa>/selectedOpportunity/isRenewable} === undefined ? false : true }" enabled="false" />

								<m:Label text="{i18n>RenewalTimePeriod}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/renewalTimePeriod}"  enabled="false" />

								<m:Label text="{i18n>RenewalTimeValue}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/renewalTimeValue}"  enabled="false" />
								<core:Title text="Timeline"/>
								<m:Label text="{i18n>creationDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/createdAt', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>ClosingDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/closingDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>startDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/startDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>endDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/finalDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>DatePubAnswers}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/datePubAnswers', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>
								
								<m:Label text="{i18n>TechnicalOpeningActDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/technicalOpeningActDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>EconomicOpeningActDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/economicOpeningActDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>pubcndte}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/publicationDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>PhysicalSupportDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/physicalSupportDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>EstimatedSignatureDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false"  value="{path :'soa>/selectedOpportunity/estimatedSignatureDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>evaluationDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/dateTimeEvaluation', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>estSignatureDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/estimatedSignatureDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>userDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/userDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>bgDelivDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/deliveryBackgroundDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<core:Title text="Responsible Employees"/>
								<m:Label text="{i18n>ResponsiblePaymentName}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/responsiblePaymentName}"  enabled="false"/>

								<m:Label text="{i18n>ResponsiblePaymentEmail}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/responsiblePaymentEmail}"  enabled="false"/>

								<m:Label text="{i18n>ResponsibleContractName}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/responsibleContractName}"  enabled="false"/>

								<m:Label text="{i18n>ResponsibleContractEmail}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/responsibleContractEmail}"  enabled="false"/>

								<m:Label text="{i18n>ResponsibleContractPhone}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/responsibleContractPhone}"  enabled="false"/>

								<core:Title text="Contract Duration"/>
								<m:Label text="{i18n>ContractDurationTime}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/contractDurationTime}"  enabled="false"/>

								<m:Label text="{i18n>UnitTimeContractDuration}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/unitTimeContractDuration}" type="Number" enabled="false"/>

								<m:Label text="{i18n>ContractDurationType}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/contractDurationType}"  enabled="false"/>

								<m:Label text="{i18n>contractLength}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/contractLength}"  enabled="false"/>

								<m:Label text="{i18n>contractExtension}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/contractExtension}"  enabled="false"/>

								<core:Title text="Award Details"/>
								<m:Label text="{i18n>AwardType}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/awardType}"  enabled="false"/>

								<m:Label text="{i18n>AwardNumber}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/awardNumber}"  enabled="false"/>

								<m:Label text="{i18n>AwardNumberOfBidders}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/awardNumberOfBidders}"  enabled="false"/>

								<m:Label text="{i18n>AwardMinutesURL}" design="Bold" required="true"/>
								<m:Input value="{soa>/selectedOpportunity/awardMinutesURL}"  enabled="false"/>

								<m:Label text="{i18n>AwardDate}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/awardDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

								<m:Label text="{i18n>expctawdte}" design="Bold" required="true"/>
								<m:DatePicker enabled="false" value="{path :'soa>/selectedOpportunity/estimatedAwardDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>

							</form:content>
					</form:SimpleForm>
					</ObjectPageSubSection>

					<ObjectPageSubSection mode="Expanded" title="Buyer Details">
						<form:SimpleForm editable="true" title="" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
											adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
											singleContainerFullSize="false" backgroundDesign="Solid" id="opportunityBuyerInfoId">
								<form:content>
									<core:Title text="Unit Details"/>
										<m:Label text="{i18n>OrganismCode}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/organismCode}"  enabled="false"/>

										<m:Label text="{i18n>OrganismName}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/organismNumber}"  enabled="false"/>

										<m:Label text="{i18n>UnitID}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/unitID}"  enabled="false"/>

										<m:Label text="{i18n>UnitCode}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/unitCode}"  enabled="false"/>

										<m:Label text="{i18n>UnitName}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/unitName}"  enabled="false"/>

										<m:Label text="{i18n>UnitAddress}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/unitAddress}"  enabled="false"/>

										<m:Label text="{i18n>UnitCommunity}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/unitCommunity}"  enabled="false"/>

										<m:Label text="{i18n>UnitRegion}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/unitRegion}"  enabled="false"/>

									<core:Title text="User Info"/>
										<m:Label text="{i18n>UserID}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/userID}"  enabled="false"/>

										<m:Label text="{i18n>UserName}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/userNumber}"  enabled="false"/>

										<m:Label text="{i18n>UserTitle}" design="Bold" required="true"/>
										<m:Input value="{soa>/selectedOpportunity/buyer/userTitle}"  enabled="false"/>
								</form:content>
						</form:SimpleForm>
					</ObjectPageSubSection>
			</ObjectPageSection>

			<!-- OPPORTUNITY PRODUCTS TAB -->
			<ObjectPageSection id="opportunityProductsId" title="Products"  visible="true">
					<ObjectPageSubSection mode="Expanded">
						<m:VBox fitContainer="true">
							<m:Table id="ProductsTableID" 
										mode="SingleSelectMaster"
										delete="onDeleteProduct"
										selectionChange=".onProductItemSelect"
										items="{
											path: 'soa>/selectedOpportunity/products',
											sorter: { path: 'soa>matchedProductName', descending: true} 
									}"
							>
								<m:columns>
									<m:Column >
										<m:Label text="Correlative" wrapping="true"/>  
									</m:Column>
									<m:Column >
										<m:Label text="Code" wrapping="true"/>  
									</m:Column>
									<m:Column >
										<m:Label text="Product" wrapping="true"/>  <!-- NAME -->
									</m:Column>
									<m:Column >
										<m:Label text="UoM" wrapping="true"/>
									</m:Column>
									<m:Column>
										<m:Label text="Quantity" wrapping="true"/> <!-- Quantity -->
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" width="150px" popinDisplay="Inline">
										<m:Label text="SupplierAwardName" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="AwardAmount" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="AwardCurrency" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="Matched" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="Matched Product" wrapping="true"/>
									</m:Column>
								</m:columns>
								<m:items>
									<m:ColumnListItem id="productTableListID" 
										type="{= ${soa>/editMode} === true ? 'DetailAndActive' : 'Navigation'}"
										press="onProductItemSelect"
										detailPress="onProductItemSelect">
										<m:cells>
											<m:Text text="{soa>correlative}"/>
											<m:Text text="{soa>productCode}"/>
											<m:Text id="productNameId" text="{soa>productName}"/> 
											<m:Text text="{soa>uoM}"/>
											<m:Text id="productQtyId" text="{soa>quantity}"/> 
											<m:Text text="{soa>supplierAwardName}"/>
											<m:Text text="{soa>awardAmount}"/>
											<m:Text text="{soa>awardCurrency}"/>
											<tnt:InfoLabel
												text="{= ${soa>matchedProductName}.length > 0 ? 'Yes' : 'No'}"
												displayOnly="true"
												colorScheme= "{
													parts: [
														{path: 'soa>matchedProductName'}
													],
													formatter: '.formatter.productMachedState'
												}" 
											/>
											<m:Text text="{soa>matchedProductName}"/>
										</m:cells>
									</m:ColumnListItem>
								</m:items>
							</m:Table>
						</m:VBox> 
					</ObjectPageSubSection>
					<!-- FORM WITH EXTRA DATA -->
					<ObjectPageSubSection id="idProductDetailSection" title="Product Details" visible="{detailView>/isProductDetailVisible}">
						<blocks>
							<m:VBox width="100%">
								<form:SimpleForm  editable="true" maxContainerCols="1" layout="ColumnLayout" columnsL="1" columnsM="1"
									class="editableForm" visible="true">
									<form:content>
										<m:Label text="SupplierAwardID" />
										<m:Text text="{soa>supplierAwardID}"/>
										<m:Label text="Comment" />
										<m:TextArea value="{soa>description}" growing="true" width="100%" enabled="{= ${soa>/editMode} === true }"/>
									</form:content>
								</form:SimpleForm>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
			</ObjectPageSection>
		</sections>

		<!-- footer bar-->
		<footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer />
				<m:Button type="Accept" text="Save" press="onFooterSavePress()"/>
				<m:Button type="Reject" text="Cancel" press="onFooterCancelPress()"/>
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>

</mvc:View>