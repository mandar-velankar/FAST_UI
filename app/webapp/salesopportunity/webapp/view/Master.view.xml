<mvc:View
	controllerName="com.bayer.tender.salesopportunity.controller.Master"
	xmlns="sap.m"
	xmlns:semantic="sap.f.semantic"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{masterView>/title}"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<VBox fitContainer="true">
			<OverflowToolbar class="sapFDynamicPageAlignContent">
					
					<ToolbarSpacer/>
					
					<SearchField id="idSearch" search=".setFilter" width="17.5rem"/>
					<OverflowToolbarButton icon="sap-icon://filter" text="Filter" type="Transparent" press=".onFilter"/>
					<OverflowToolbarButton icon="sap-icon://sort" text="Sort" type="Transparent" press=".onOpenViewSettings"/>
				</OverflowToolbar>
				<Table
						id="list"
						inset="false"
						items="{
							path: '/PublicMarketTenders',
							sorter: {
								path: 'CodigoExterno',
								descending: false
							},
							parameters: {
								expand: 'Buyer,Items'
							}
						}"
						class="sapFDynamicPageAlignContent"
						width="auto"
						updateFinished=".onUpdateFinished"
						alternateRowColors="true"
						contextualWidth="Auto" 
						popinLayout="Block"
						growing="true"
						growingThreshold="15"
						growingScrollToLoad="false">
					<columns>
						<Column width="10%" visible="true">
							<header>
								<ObjectIdentifier title="{i18n>Code}" />
							</header>
						</Column>
						<Column width="25%" minScreenWidth="920px" demandPopin="true" popinDisplay="Inline" visible="true">
							<header>
								<ObjectIdentifier title="{i18n>Name}" />
							</header>
						</Column>
						<Column width="25%" visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="{i18n>Institute}" />
							</header>
						</Column>
						<Column width="20%"  visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="{i18n>Products}" />
							</header>
						</Column>
						<Column width="15%"  visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="Publ. Closing" />
							</header>
						</Column>
						<Column width="5%"  visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="" />
							</header>
						</Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onSelectionChange" highlight="Success">
							<cells>
								<Text text="{CodigoExterno}"/>
								<Text text="{Name}"/>
								<Text text="{Buyer/OrganismNumber}"/>
								<Text text="Products"/>
								<Text text="{
										path: 'ClosingDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
								<Button text="Participate" type="Emphasized" press="onParticipateOpportunityPress"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>