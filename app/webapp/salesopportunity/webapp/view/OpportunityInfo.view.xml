<mvc:View
	controllerName="com.bayer.tender.contracts.controller.Master"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	<f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Contracts"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
            <VBox>
                <form:SimpleForm editable="true" title="" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
                        adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
                        singleContainerFullSize="false" backgroundDesign="Solid">
                    <form:content>
                        <!-- Block - institute & type  -->
                        <core:Title text="Institute &amp; Type"/>
                        <Input value="{fastData>TenderID}" visible="false"/>
                        <Input id="idInstituteID" value="{fastData>InstituteID}" visible="false"/>
                        <Label text="Tender Reference" design="Bold" required="true"/>
                        <Input id="idTenderName" value="{fastData>TenderName}" />
                        <Label text="{i18n>clasficn}" design="Bold" required="true"/>
                        <Select id="idClassification" selectedKey="{fastData>Classification}" enabled="false" items="{ path: 'fastAppData>/CountryClassifications'}" change="onClassificationChange" >
                            <items><!--RFQ/Tender/Budgetary Quote/Patient Access Programme-->
                                <core:Item text="{fastAppData>CLASSIFICATION}" key="{fastAppData>CLASSIFICATION}" app:classificationId="{fastAppData>ID}"/>
                            </items>
                        </Select>
                    </form:content>
                </form:SimpleForm>

                <!-- Tender Information Only for Chile-->
                <form:SimpleForm id="idTenderInformationSimpleForm" editable="true" title="" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
                    adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
                    singleContainerFullSize="false" backgroundDesign="Solid" visible="true">
                    <form:content>
                        <!-- Block - Tender Information BEGIN-->
                        <core:Title text="{i18n>tenderInformation}" />
                        <Label />
                        <Button xmlns="sap.m" icon="sap-icon://document" text="{i18n>btnDocuments}" type="Emphasized" width="9em" press="onDocumentsPress"/>
                        <Label text="{i18n>Institute}" design="Bold"/>
                        <Input value="{fastData>CountrySpecificInformation/Institute}" enabled="false"/>
                        <Label text="{i18n>tenderref}" design="Bold"/>
                        <Input value="{fastData>CountrySpecificInformation/TenderReference}" enabled="false"/>
                        <Label text="{i18n>pubcndte}" design="Bold" required="true"/>
                        <DatePicker enabled="false" value="{path :'fastData>CountrySpecificInformation/PublicationDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>
                        <Label text="{i18n>ClosingDate}" design="Bold" required="true"/>
                        <DatePicker  enabled="false" value="{path :'fastData>CountrySpecificInformation/ClosingDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" />
                    </form:content>
                </form:SimpleForm>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>