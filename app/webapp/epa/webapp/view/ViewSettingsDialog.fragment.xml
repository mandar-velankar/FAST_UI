<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<ViewSettingsDialog
		id="viewSettingsDialog"
		confirm=".onConfirmViewSettingsDialog">
		<sortItems>
			<ViewSettingsItem
				text="{i18n>masterSort1}"
				key="CountryCode"
				selected="true"/>
			<!--<ViewSettingsItem
				text="{i18n>masterSort2}"
				key="Region"/>-->
		</sortItems>
		<filterItems>
			<ViewSettingsFilterItem
				id="filterItems"
				text="{i18n>masterFilterName}"
				multiSelect="false"
				items="{path: '/CountriesUser'}">
				<items>
					<ViewSettingsItem key="{CountryCode}"
									  text="{CountryName}" />
					<!--<ViewSettingsItem
						id="viewFilter1"
						text="TH"
						key="Filter1"/>
					<ViewSettingsItem
						id="viewFilter2"
						text="MX"
						key="Filter2"/>-->
				</items>
			</ViewSettingsFilterItem>
		</filterItems>
		<groupItems>
			<ViewSettingsItem
				text="{i18n>masterGroup1}"
				key="CountryCode"/>
		</groupItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>