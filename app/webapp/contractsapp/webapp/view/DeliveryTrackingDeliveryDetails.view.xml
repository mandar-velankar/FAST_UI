<mvc:View controllerName="com.bayer.tender.contracts.controller.DeliveryTracking" xmlns="sap.uxap" xmlns:m="sap.m" xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	
			<m:VBox width="100%">
				<form:SimpleForm id="idDeliveryDetailForm" editable="true" maxContainerCols="1" layout="ColumnLayout" columnsL="1" columnsM="1"
					class="editableForm" visible="true">
					<form:content>
						<!-- Institute or the childeren -->
						<m:Label text="{i18n>Institute}" required="{= ${ctr>/editMode} === true ? true : false}" visible="{= ${ctr>/currentContract/groupPurchasing} === 1 || ${ctr>/currentContract/groupPurchasing} === 2 ? true : false}" />
						<m:Select id="idDeliveryDetailInstituteID" items="{ path: 'ctr>/institutesChildren', sorter: { path: 'instituteName' }  }" selectedKey="{ctr>/currentContract/selectedProduct/selectedDelivery/instituteId}" visible="{= ${ctr>/currentContract/groupPurchasing} === 1 || ${ctr>/currentContract/groupPurchasing} === 2 ? true : false}" enabled="{= ${ctr>/editMode} === true ? true : false}">		
							<core:Item key="{ctr>instituteID}" text="{ctr>instituteName}"/>
						</m:Select>

						<m:Label text="{i18n>Penalty}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						<m:Select id="idPenaltyDrop" selectedKey="{ctr>/currentContract/selectedProduct/selectedDelivery/penalty}" change="onChangePenalty" enabled="{= ${ctr>/editMode} === true ? true : false}">
							<m:items>
								<core:Item text="No" key="false"/>
								<core:Item text="Yes" key="true"/>
							</m:items>
						</m:Select>

						<!--<m:Title level="H4" text="Penalty Details:" width="100%"/>-->
						<m:Label text="{i18n>PenaltyValue}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						<m:Input id="idPenaltyValueTab" 
							value="{ctr>/currentContract/selectedProduct/selectedDelivery/penaltyValue}" 
							type="Number"
							enabled="{= ${ctr>/editMode} === true &amp;&amp; ( ${ctr>/currentContract/selectedProduct/selectedDelivery/penalty} === true || ${ctr>/currentContract/selectedProduct/selectedDelivery/penalty} === 'true' ) ? true : false}"
						/>
						<m:Select
							id="idDeliveryDetailPenaltyCurrency" 
							selectedKey="{ctr>/currentContract/selectedProduct/selectedDelivery/currency}"
							items="{ path: 'ctr>/currencies/', sorter: { path: 'cOUNTRY_CODE' } }"
							enabled="{= ${ctr>/editMode} === true &amp;&amp; ( ${ctr>/currentContract/selectedProduct/selectedDelivery/penalty} === true || ${ctr>/currentContract/selectedProduct/selectedDelivery/penalty} === 'true' ) ? true : false}">
							<core:Item key="{ctr>cURRENCY}" text="{ctr>cURRENCY}"/>
						</m:Select>
						<m:Label text="{i18n>PenaltyReason}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						<m:Select 
							id="idDeliveryDetailPenaltyReason" 
							selectedKey="{ctr>/currentContract/selectedProduct/selectedDelivery/penaltyReason}"
							items="{ path: 'ctr>/penaltyReasons/', sorter: { path: 'PenaltyReasons' } }"
							enabled="{= ${ctr>/editMode} === true &amp;&amp; ( ${ctr>/currentContract/selectedProduct/selectedDelivery/penalty} === true || ${ctr>/currentContract/selectedProduct/selectedDelivery/penalty} === 'true' ) ? true : false}">
							<core:Item key="{ctr>PenaltyReasons}" text="{ctr>PenaltyReasons}"/>
						</m:Select>

						<m:Label text="{i18n>PaidOrFree}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						<m:Select selectedKey="{ctr>/currentContract/selectedProduct/selectedDelivery/paidOrFree}" enabled="{= ${ctr>/editMode} === true ? true : false}">
							<m:items>
								<core:Item text="Paid" key="Paid"/>
								<core:Item text="Free" key="Free"/>
							</m:items>
						</m:Select>
						
						<!--<m:Title level="H4" text="Compensated Details:" />-->
						<m:Label text="{i18n>UndertakingLetters}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						<m:Select 
							id="idDeliveryDetailUndertakingLetters" 
							selectedKey="{ctr>/currentContract/selectedProduct/selectedDelivery/undertakingLetters}"
							enabled="{= ${ctr>/editMode} === true ? true : false}">
							<m:items>
								<core:Item text="Yes" key="Yes"/>
								<core:Item text="No" key="No"/>
							</m:items>
						</m:Select>

						<m:Label text="{i18n>Compensated}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						<m:Select id="idCompensatedDrop" selectedKey="{ctr>/currentContract/selectedProduct/selectedDelivery/compensated}" change="onChangeCompensated" enabled="{= ${ctr>/editMode} === true ? true : false}">
							<m:items>
								<core:Item text="Yes" key="Yes"/>
								<core:Item text="No" key="No"/>
							</m:items>
						</m:Select>

						<m:Label text="{i18n>CompensationComment}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						<m:Input 
							id="idDeliveryDetailCompensationComment" 
							value="{ctr>/currentContract/selectedProduct/selectedDelivery/compensationComment}"
							enabled="{= ${ctr>/editMode} === true &amp;&amp; ${ctr>/currentContract/selectedProduct/selectedDelivery/compensated} === 'Yes' ? true : false}" />
						<m:Label text="" required="false"/>
						<m:SegmentedButton selectedKey="competitor" class="sapUiSmallMarginBottom">
							<m:items>
								<m:SegmentedButtonItem icon="sap-icon://accept" text="Close" press="onConfirmDelivery"
									visible="{= ${ctr>/editMode} === true ? true : false}"/>
								<!--<m:SegmentedButtonItem icon="sap-icon://sys-cancel" text="Cancel" press="onCancelDeliveryEdit" visible="{= ${ctr>/editMode} === true ? true : false}" />-->
							</m:items>
						</m:SegmentedButton>
					</form:content>
				</form:SimpleForm>
			</m:VBox>
		

	
</mvc:View>