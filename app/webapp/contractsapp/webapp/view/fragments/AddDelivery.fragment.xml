<!-- Fragment for Adding a delivery to the product on delivery tracking tab -->
<core:FragmentDefinition xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core">

	<Dialog title="Add Delivery" stretch="false" contentWidth="50%" binding="{ctr>/currentContract/selectedProduct/temporaryDelivery}">

		<buttons>
			<Button text="Add Delivery" press="onAddDeliveryDialogConfirm" />
			<Button text="Cancel" press="onAddDeliveryDialogCancel" />
		</buttons>

		<content>
			<l:Grid defaultSpan="L12 M6 S12" width="auto" class="sapUiSizeCompact" position="Center">
				<l:content>
					<l:form.SimpleForm maxContainerCols="2" visible="true" id="idDeliverieForm" editable="true" labelMinWidth="0" layout="ResponsiveGridLayout" labelSpanL="5" labelSpanM="1" emptySpanL="1" emptySpanM="1" columnsL="2" columnsM="2">
						<l:content>
							<core:Title text="Add Information for Delivery below"/>

							<!-- Local or direct delivery -->
							<Label text="{i18n>LocalOrDicectDelivery}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idLocalorDirectDelivery" selectedKey="{ctr>localOrDirect}">
								<items>
									<core:Item text="Direct" key="D"/>
									<core:Item text="Local" key="L"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>

							<!-- Planned In APO -->
							<Label text="{i18n>PlannedInAPO}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idPlannedInAPO" selectedKey="{ctr>plannedInApo}">
								<items>
									<core:Item text="Yes" key="Yes"/>
									<core:Item text="No" key="No"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>

							<!-- Requested Delivery Date -->
							<Label text="{i18n>RequestedDeliveryDate}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<!--
						<DatePicker valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" placeholder="{i18n>Select_date}" tooltip="{i18n>EffDate}" value="" id="idRequestedDeliveryDate" required="true">
							<layoutData>
								<l:GridData span="L6 M6 S6"/>
							</layoutData>
						</DatePicker>
						-->
							<DatePicker id="idRequestedDeliveryDate" value="{path :'ctr>requestedDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" tooltip="{i18n>EffDate}" placeholder="{i18n>Select_date}" required="true">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</DatePicker>

							<!-- Requested Quantity -->
							<Label text="{i18n>RequestedQuantity}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Input id="idRequestedQuantity" value="{ctr>requestedDeliveryQuantity}" type="Number" required="true">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Input>

							<!-- Actual delivery Date -->
							<Label text="{i18n>ActualDeliveryDate}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<!--
						<DatePicker valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" placeholder="{i18n>Select_date}" tooltip="{i18n>EffDate}" value="" id="idActualDeliveryDate" required="true">
							<layoutData>
								<l:GridData span="L6 M6 S6"/>
							</layoutData>
						</DatePicker>
						-->
							<DatePicker id="idActualDeliveryDate" value="{path :'ctr>actualDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" tooltip="{i18n>EffDate}" placeholder="{i18n>Select_date}" required="true">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</DatePicker>

							<!-- Actual Delivery Quantity -->
							<Label text="{i18n>ActualDeliveryQuantity}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Input id="idActualDeliveryQuantity" value="{ctr>actualDeliveryQuantity}" type="Number" required="true">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Input>

							<!-- Penalty -->
							<Label text="{i18n>Penalty}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idPenalty" selectedKey="{ctr>penalty}" change="onChangePenalty">
								<items>
									<core:Item text="No" key="false"/>
									<core:Item text="Yes" key="true"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>

							<!-- Penalty Value if Penalty is yes -->
							<Label text="{i18n>PenaltyValue}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Input id="idPenaltyValue" value="{ctr>penaltyValue}" type="Number">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Input>

							<!-- Currency -->
							<Label text="{i18n>Currency}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idCurrency" items="{ path: 'ctr>/currencies/', sorter: { path: 'cOUNTRY_CODE' } }">
								<core:Item key="{ctr>cURRENCY}" text="{ctr>cURRENCY}"/>

								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>

							</Select>

							<!-- PenaltyReason -->
							<Label text="{i18n>PenaltyReason}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idPenaltyReason" items="{ path: 'ctr>/penaltyReasons/', sorter: { path: 'PenaltyReasons' } }" selectedKey="{ctr>penaltyReason}">

								<core:Item key="{ctr>PenaltyReasons}" text="{ctr>PenaltyReasons}" />

								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>

							</Select>

							<!-- Undertaking Letters -->
							<Label text="{i18n>UndertakingLetters}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idUndertakingLetters" selectedKey="{ctr>undertakingLetters}">
								<items>
									<core:Item text="No" key="No"/>
									<core:Item text="Yes" key="Yes"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>

							<!-- Compensated -->
							<Label text="{i18n>Compensated}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idCompensated" change="onChangeCompensated" selectedKey="{ctr>compensated}">
								<items>
									<core:Item text="No" key="No"/>
									<core:Item text="Yes" key="Yes"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>

							<!-- Compensation Comment -->
							<Label text="{i18n>CompensationComment}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Input id="idCompensationComment" value="{ctr>compensationComment}">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Input>

							<!-- Paid or Free -->
							<Label text="{i18n>PaidOrFree}" required="true">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idPaidOrFree" selectedKey="{ctr>paidOrFree}">
								<items>
									<core:Item text="Paid" key="Paid"/>
									<core:Item text="Free" key="Free"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>

							<!-- Purchase order -->
							<Label text="{i18n>PO}">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Input value="{ctr>pO}" id="idPO">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Input>

							<!-- Invoice No -->
							<Label text="{i18n>InvoiceNo}">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Input value="{ctr>invoiceNo}" id="idInvoiceNo">
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Input>

							<!-- Institute or the childeren -->
							<Label text="{i18n>Institute}" required="true" visible="{= ${ctr>/currentContract/groupPurchasing} === 1 || ${ctr>/currentContract/groupPurchasing} === 2 ? true : false}">
								<layoutData>
									<l:GridData span="L4 M4 S4"/>
								</layoutData>
							</Label>
							<Select id="idInstituteDelivery" items="{ path: 'ctr>/institutesChildren', sorter: { path: 'instituteName' }  }" selectedKey="{ctr>instituteId}" visible="{= ${ctr>/currentContract/groupPurchasing} === 1 || ${ctr>/currentContract/groupPurchasing} === 2 ? true : false}">
								<items>
									<core:Item key="{ctr>instituteID}" text="{ctr>instituteName}"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>

						</l:content>
					</l:form.SimpleForm>
				</l:content>
			</l:Grid>
		</content>
	</Dialog>

</core:FragmentDefinition>