<mvc:View controllerName="com.bayer.tender.contracts.controller.DeliveryTracking" xmlns="sap.uxap" xmlns:m="sap.m" xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	
		
			<m:VBox>
				<m:Toolbar>
					<m:ToolbarSpacer/>
					<m:Button id="idAddLtr" visible="{ctr>/editMode}" text="{i18n>AddLetter}" icon="sap-icon://add" press="onAddLetter"/>
				</m:Toolbar>
				<!-- Letters table -->
				<m:Table 
					id="lettersTableID" 
					mode="{= ${ctr>/editMode} === true ? 'Delete' : 'SingleSelectMaster'}" 
					delete="onDeleteLetter"
					selectionChange="onLetterItemSelect"
					items="{
						path: 'ctr>/currentContract/selectedProduct/letters',
						filters: [
							{path: 'enabled', operator: 'EQ', value1: true}
						]
					}"
				>
					<m:columns>
						<!--<m:Column width="7rem">
							<m:Label text="Product SKU" wrapping="true"/>
						</m:Column>-->
						<m:Column width="7rem">
							<m:Label text="Reason for Letter" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="Quantity" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="Batch" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
						<!--<m:Column width="8.5rem">
							<m:Label text="Manufacturing date" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="8.5rem">
							<m:Label text="Expiry Date" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>-->
						<m:Column width="8.57rem">
							<m:Label text="Returned Date" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="Returned Quantity" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="UOM" wrapping="true" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
					</m:columns>
					<m:items>
						<m:ColumnListItem id="lettersTableListID" type="{= ${ctr>/editMode} === true ? 'DetailAndActive' : 'Navigation'}"
							detailPress="onLetterItemSelect" press="onLetterItemSelect">
							<m:cells>
								<!--<m:ObjectIdentifier title="{fastAppData>SKUCODE}"/>-->
								<!--<m:Input value="{fastAppData>SKUCODE}" enabled="false"/>-->
								<m:Input value="{ctr>reasonForLetter}" enabled="false"/>
								<m:Input value="{ctr>quantity}" enabled="false"/>
								<m:Input value="{ctr>batch}" enabled="false"/>
								<!--<m:DatePicker id="idManufacturingDate"-->
								<!--	placeholder="Manufacturing Date" -->
								<!--	tooltip="Manufacturing Date"-->
								<!--	dateValue="{fastAppData>MANUFACTURINGDATE}" -->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	enabled="false"/>-->
								<!--<m:DatePicker id="idManufacturingDate"
									value="{path :'ctr>manufacturingDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="Manufacturing Date" enabled="false" placeholder="Manufacturing Date"/>-->
								<!--<m:DatePicker id="idExpiryDate"-->
								<!--	placeholder="Expiration Date" -->
								<!--	tooltip="Expiration Date"-->
								<!--	dateValue="{fastAppData>EXPIRYDATE}"-->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	enabled="false"/>-->
								<!--<m:DatePicker id="idExpiryDate"
									value="{path :'ctr>expiryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="Expiration Date" enabled="false" placeholder="Expiration Date"/>-->
								<!--<m:DatePicker id="idReturnDate"-->
								<!--	placeholder="Return Date" -->
								<!--	tooltip="Return Date"-->
								<!--	dateValue="{fastAppData>RETURNDATE}"-->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	enabled="false"/>-->
								<m:DatePicker id="idReturnDate"
									value="{path :'ctr>returnDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="Return Date" enabled="false" placeholder="Return Date"/>
								<m:Input value="{ctr>returnedQuantity}" enabled="false"/>
								<m:Input value="{ctr>uoM}" enabled="false"/>
							</m:cells>
						</m:ColumnListItem>
					</m:items>
				</m:Table>
			</m:VBox>
		

	
</mvc:View>