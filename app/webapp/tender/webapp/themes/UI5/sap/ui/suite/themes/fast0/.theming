			"sEmbeddingMethod": "APPEND",
			"aScopes": [
				{
					"sLabel": "Contrast",
					"sSelector": "sapContrast",
					"sThemeIdSuffix": "Contrast",
					"sThemability": "PUBLIC",
					"aThemabilityFilter": [
						"Color"
					],
					"rExcludeSelector": "\\.sapContrastPlus\\W",
					"sEmbeddedFile": "fast0--Contrast.library",
					"sEmbeddedCompareFile": "library"
				}
			],
			"sBaseFile": "library"
		}
	}
}