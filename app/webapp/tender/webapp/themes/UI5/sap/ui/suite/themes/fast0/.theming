{
	"mVersionDependency": {
		"UI5.sap/ui/suite.sap_belize": "1.64.1",
		"UI5.sap/ui/suite": "1.64.1",
		"UI5": "1.64.1"
	},
	"sEntity": "Theme",
	"sId": "fast0",
	"sLabel": "FAST THEME",
	"oExtends": "UI5.sap/ui/suite.sap_belize",
	"aBundled": [
		"fast0--Contrast"
	],
	"sTextDirections": "LTR",
	"sType": "STANDARD",
	"sThemability": "PUBLIC",
	"mCssScopes": {
