<!-- Fragment for Adding a delivery to the product on delivery tracking tab -->
<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<l:Grid defaultSpan="L12 M6 S12" width="auto" class="sapUiSizeCompact" position="Center">
		<l:content>
			<l:form.SimpleForm maxContainerCols="2" visible="true" editable="true" labelMinWidth="0"
				layout="ResponsiveGridLayout" labelSpanL="5" labelSpanM="1" emptySpanL="1" emptySpanM="1" columnsL="2" columnsM="2">
				<l:content>
					<core:Title text="Add Information for Delivery below"/>
					 
					<!-- Local or direct delivery -->
					<Label text="{i18n>LocalOrDicectDelivery}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select selectedKey="{fastAppData>/EditDelivery/LocalOrDirectDelivery}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<items>
							<core:Item text="Direct" key="D"/>
							<core:Item text="Local" key="L"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>
					
					<!-- Planned In APO -->
					<Label text="{i18n>PlannedInAPO}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select  selectedKey="{fastAppData>/EditDelivery/PlannedInAPO}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<items>
							<core:Item text="Yes" key="Yes"/>
							<core:Item text="No" key="No"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>
					
					<!-- Requested Delivery Date -->
					<Label text="{i18n>RequestedDeliveryDate}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<!--
					<DatePicker 
						valueFormat="dd-MM-yyyy" 
						displayFormat="dd.MM.yyyy" 
						placeholder="{i18n>Select_date}" 
						tooltip="{i18n>EffDate}" 
						value=""
						id="idRequestedDeliveryDate"
						required="true">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</DatePicker>
					-->
					<DatePicker 
						value="{path :'fastAppData>/EditDelivery/RequestedDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
						tooltip="{i18n>EffDate}" 
						placeholder="{i18n>Select_date}"
						required="true"
						visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>	
					</DatePicker>
					
	        		<!-- Requested Quantity -->
					<Label text="{i18n>RequestedQuantity}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/RequestedQuantity}" type="Number" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>
					
					<!-- Actual delivery Date -->
					<Label text="{i18n>ActualDeliveryDate}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<!--
	        		<DatePicker 
						valueFormat="dd-MM-yyyy" 
						displayFormat="dd.MM.yyyy" 
						placeholder="{i18n>Select_date}" 
						tooltip="{i18n>EffDate}" 
						value="" 
						id="idActualDeliveryDate"
						required="true">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</DatePicker>
					-->
					<DatePicker 
						value="{path :'fastAppData>/EditDelivery/ActualDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
						tooltip="{i18n>EffDate}" 
						placeholder="{i18n>Select_date}"
						required="true"
						visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>	
					</DatePicker>
					
					<!-- Actual Delivery Quantity -->
					<Label text="{i18n>ActualDeliveryQuantity}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/ActualDeliveryQuantity}" type="Number" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }" >
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>
					
					<!-- Penalty -->
					<Label text="{i18n>Penalty}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select id="idPenalty" change="onChangePenalty" selectedKey="{fastAppData>/EditDelivery/Penalty}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<items>
							<core:Item text="No" key="No"/>
							<core:Item text="Yes" key="Yes"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>

					<!-- Penalty Value if Penalty is yes -->
					<Label text="{i18n>PenaltyValue}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input id="idPenaltyValue" value="{fastAppData>/EditDelivery/PenaltyValue}" type="Number" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>	
					
					<!-- Currency -->
					<Label text="{i18n>Currency}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select id="idCurrency" items="{ path: 'fastAppData>/CountryCurrency', sorter: { path: 'COUNTRY_CODE' } }" selectedKey="{fastAppData>/EditDelivery/Currency}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
					
						<core:Item key="{fastAppData>CURRENCY}" text="{fastAppData>CURRENCY}"/>
						
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					
					</Select>

					<!-- PenaltyReason -->
					<Label text="{i18n>PenaltyReason}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select id="idPenaltyReason" items="{ path: 'fastAppData>/PenaltyReasons/', sorter: { path: 'PenaltyReasons' } }" selectedKey="{fastAppData>/EditDelivery/PenaltyReason}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
					
						<core:Item key="{fastAppData>PenaltyReasons}" text="{fastAppData>PenaltyReasons}"/>
						
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					
					</Select>					
					
					<!-- Undertaking Letters -->
					<Label text="{i18n>UndertakingLetters}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select id="idUndertakingLetters" selectedKey="{fastAppData>/EditDelivery/UndertakingLetters}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<items>
							<core:Item text="No" key="No"/>
							<core:Item text="Yes" key="Yes"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>					

					<!-- Compensated -->
					<Label text="{i18n>Compensated}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }"> 
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select id="idCompensated" change="onChangeCompensated" selectedKey="{fastAppData>/EditDelivery/Compensated}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<items>
							<core:Item text="No" key="No"/>
							<core:Item text="Yes" key="Yes"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>

					<!-- Compensation Comment -->
					<Label text="{i18n>CompensationComment}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input id="idCompensationComment" value="{fastAppData>/EditDelivery/CompensationComment}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>					
					
					<!-- Paid or Free -->
					<Label text="{i18n>PaidOrFree}" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select id="idPaidOrFree" selectedKey="{fastAppData>/EditDelivery/PaidOrFree}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<items>
							<core:Item text="Paid" key="Paid"/>
							<core:Item text="Free" key="Free"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>

					<!-- Purchase order -->
					<Label text="{i18n>PO}">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/PO}" >
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>
					
					<!-- Invoice No -->
					<Label text="{i18n>InvoiceNo}" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/InvoiceNo}" id="idInvoiceNo" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>
					
					<!-- Institute or the childeren -->
					<Label text="{i18n>Institute}" required="true" >
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select id="idInstituteDelivery" items="{ path: 'fastAppData>/InstituteWithChildren/' }" selectedKey="{fastAppData>/EditDelivery/InstituteID}">
						<items>
							<core:Item key="{fastAppData>InstituteID}" text="{fastAppData>InstituteName}"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>

					<Label text="{i18n>BatchNumber}" visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false}">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/BatchNumber}" id="idBatchNumber" visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false}">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>

					<Label text="{i18n>CCReference}" visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false}">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/CCReference}" id="idCCReference" visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false}">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>
	
				</l:content>
			</l:form.SimpleForm>
		</l:content>
	</l:Grid>
</core:FragmentDefinition>