<!-- Fragment for Adding a delivery to the product on delivery tracking tab -->
<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<l:Grid defaultSpan="L12 M6 S12" width="auto" class="sapUiSizeCompact" position="Center">
		<l:content>
			<l:form.SimpleForm maxContainerCols="2" visible="true" editable="true" labelMinWidth="0"
				layout="ResponsiveGridLayout" labelSpanL="5" labelSpanM="1" emptySpanL="1" emptySpanM="1" columnsL="2" columnsM="2">
				<l:content>
					<core:Title text="Add Information for Purchase Order below"/>
					
					<!-- PO Date -->
					<Label text="{i18n>PoDate}" required="true">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					
					<DatePicker
						value="{path :'fastAppData>/EditDelivery/PoDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
						tooltip="{i18n>EffDate}" 
						placeholder="{i18n>Select_date}"
						required="true">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>	
					</DatePicker>
					
					<!-- Actual Delivery Quantity -->
					<Label text="{i18n>PoQty}" required="true">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/ActualDeliveryQuantity}" type="Number" required="true" >
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>
					
					<!-- Purchase order -->
					<Label text="{i18n>PO}">
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Input value="{fastAppData>/EditDelivery/PO}">
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Input>
					
					<!-- Institute or the childeren -->
					<Label text="{i18n>Institute}" required="true" >
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select items="{ path: 'fastAppData>/InstituteWithChildren/' }" selectedKey="{fastAppData>/EditDelivery/InstituteID}">
						<items>
							<core:Item key="{fastAppData>InstituteID}" text="{fastAppData>InstituteName}"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>

					<!-- Contract (yes/no) -->
					<Label text="{i18n>contract}" required="true" >
						<layoutData>
							<l:GridData span="L4 M4 S4"/>
						</layoutData>
					</Label>
					<Select selectedKey="{fastAppData>/EditDelivery/Contract}">
						<items>
							<core:Item key="Yes" text="Yes"/>
							<core:Item key="No" text="No"/>
						</items>
						<layoutData>
							<l:GridData span="L6 M6 S6"/>
						</layoutData>
					</Select>
	
				</l:content>
			</l:form.SimpleForm>
		</l:content>
	</l:Grid>
</core:FragmentDefinition>