<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core">

    <Dialog title="Send Quotation Mail" stretch="true">
        <buttons>
                    <Button text="Send" press="onSendQuotationMail" />
                    <Button text="Cancel" press="onCancelQuotationMail" />
        </buttons> 

			<form:SimpleForm editable="true" 
                            maxContainerCols="1" 
                            layout="ResponsiveGridLayout"  
                            labelSpanL="1" 
                            labelSpanM="1"
                            emptySpanL="0" 
                            emptySpanM="0" 
                            columnsL="1" 
                            columnsM="1" 
                            class="editableForm" 
                            visible="true">           
				<form:content>
					<core:Title/>

                   <Label text="{i18n>From}" required="true"/>
                   <MultiInput id="idFrom" width="70%" showValueHelp="false" required="true"/>

                    <Label text="{i18n>To}" required="true"/>
                    <MultiInput id="idTo" width="70%" showValueHelp="false" required="true"/>

                    <Label text="{i18n>Subject}" required="true"/>
                    <Input id="idSubject" type="Email" required="true"/>

                   <Label text="{i18n>Body}" required="true"/>
                   <TextArea value="" 
					         showExceededText="true"
							 enabled="true"
                             rows="40" />
                </form:content>
		</form:SimpleForm>
   	</Dialog>	
</core:FragmentDefinition>