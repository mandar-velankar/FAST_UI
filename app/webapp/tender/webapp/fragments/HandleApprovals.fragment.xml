<!-- Fragment for handeling approvals -->
<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core">
					
		<VBox fitContainer="true">
						
				<items>

						<!-- message strip -->
						<!--JH dunno what this is meant to show-->
						<!--<MessageStrip-->
						<!--		id="idRequiredActionStrip"-->
						<!--		text="{fastAppData>/ApprovalsSelectedOffer/REQUIRED_ACTION}"-->
						<!--		enableFormattedText="true"-->
						<!--		showIcon="true"-->
						<!--		showCloseButton="true">-->
						<!--</MessageStrip>-->
							
						<!-- Table with mandatory approvals -->
						<Table id="idMandatoryTable" 
							items="{path: 'fastAppData>/ApprovalsSelectedOffer', parameters: {'expand': 'ApproverList,ApproverTypes'}}" 
							alternateRowColors="true">
								
								<!-- table header with title & buttons -->
								<headerToolbar>
										<OverflowToolbar>
											<content>
												<Title text="Mandatory/Optional approvals" level="H2"/>
												<ToolbarSpacer />
												<!-- This will be handled outside this application 
												<Button icon="sap-icon://employee-approvals" text="{i18n>Approve}" type="Accept" press="onApprovePress"/>
												<Button icon="sap-icon://employee-rejections" text="{i18n>Reject}" type="Reject" press="onRejectPress"/>
												-->
												<Button icon="sap-icon://refresh" text="{i18n>Refresh}" type="Default" press="onRefreshApprovalsPress"/>
											</content>
										</OverflowToolbar>
								</headerToolbar>
								
								<!-- columns -->
								<columns>
									<Column minScreenWidth="Tablet" demandPopin="true" width="10rem">
										<Label text="{i18n>Approver}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" width="5rem">
										<Label text="{i18n>Hierarchy}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" width="7rem">
										<Label text="{i18n>Content}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" width="7rem">
										<Label text="{i18n>Status}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" width="7rem">
										<Label text="{i18n>Send}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" width="20rem">
										<Label text="{i18n>Name}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" width="9rem">
										<Label text="{i18n>RequiredAction}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true">
										<Label text="{i18n>SendersComment}"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true">
										<Label text="{i18n>ApproverComment}"/>
									</Column>
								</columns>
								
								<!-- rows -->
								<items>
									
									<ColumnListItem type="Inactive">
										
										<cells>
											
											<!-- Approver Type -->
											<Label text="{fastAppData>ApproverType}" wrapping = "true"/>

											<!-- Hierarchy -->
											<!--<Input value="{= ${fastAppData>Hierarchy} !== null &amp;&amp; ${fastAppData>Hierarchy} !== 0 ? ${fastAppData>Hierarchy} : ${fastAppData>ApproverTypes/results/0/hierarchy} }" required="true"/>-->
											<Input value="{fastAppData>ApproverTypes/results/0/Hierarchy}" required="true"/>

											<!-- Content -->
											<Label text="{fastAppData>ApprovalContent}"/>
										
											<!-- Status -->
											<ObjectStatus
												class="sapUiSmallMarginBottom"
												text="{fastAppData>ApprovalStatus}"
												state="{ parts:[{path:'fastAppData>ApprovalStatus'}],
														 formatter: '.formatter.status'}"
											/>
											
											<!-- Sending -->
											<!--
													selectedKey="{
														parts:[
																{path:'fastAppData>ApprovalStatus'},
																{path:'fastAppData>ApproverType'},
																{path:'fastAppData>send'}
															  ],
														formatter:'.formatter.sending_selectedKey'
													}" 
											-->
											
											<Select selectedKey="{fastAppData>send}"
													enabled="{ 
														parts:[
																{path:'fastAppData>ApprovalStatus'},
																{path:'fastAppData>ApproverTypeSection'}
															  ],
														formatter: '.formatter.sendingEnabled'
													}"
											        >
												<items>
													<core:Item text="No" key="No"/>
													<core:Item text="Yes" key="Yes"/>
												</items>
											</Select>
											
											<!-- Name -->
											<Select selectedKey="{fastAppData>ApproverEmailID}" 
													items="{ path: 'fastAppData>ApproverList/results', templateShareable: false }" 
													width="250px" 
													enabled="{= ${fastAppData>ApprovalStatus} !== 'Waiting' &amp;&amp; ${fastAppData>ApprovalStatus} !== 'Processing' &amp;&amp; ${fastAppData>ApprovalStatus} !== 'Cancelling'}">
												<core:Item text="{fastAppData>ApproverName}" key="{fastAppData>ApproverEmailID}"/>
											</Select>
											
											<!-- Content -->
											<!--<Label text="{fastAppData>REQUIRED_ACTION}"/>-->
											<Select id="idReqAction" selectedKey="{fastAppData>REQUIRED_ACTION}" enabled="{= ${fastAppData>ApprovalStatus} !== 'Waiting' &amp;&amp; ${fastAppData>ApprovalStatus} !== 'Processing' &amp;&amp; ${fastAppData>ApprovalStatus} !== 'Cancelling' &amp;&amp; ${fastAppData>ApproverTypeSection} !== 1 ? true : false}">
												<items>
													<core:Item text="Notification" key="Notification"/>
													<core:Item text="Approval" key="Approval"/>
												</items>
											</Select>
											
											<!-- Sender's Comment  -->
											<TextArea value="{fastAppData>SenderComment}" 
														showExceededText="true" 
														maxLength="500" 
														width="100%" 
														valueState="{= ${fastAppData>SenderComment}.length > 500 ? 'Warning' : 'None' }" 
														valueLiveUpdate="false" liveChange="handleLiveChange" 
														enabled="{= ${fastAppData>ApprovalStatus} !== 'Waiting' &amp;&amp; ${fastAppData>ApprovalStatus} !== 'Processing' &amp;&amp; ${fastAppData>ApprovalStatus} !== 'Cancelling'}"/>
											
											<!-- Approver's Comment  -->
											<TextArea value="{fastAppData>ApproverComment}" 
														showExceededText="true" 
														maxLength="500" 
														width="100%" 
														valueState="{= ${fastAppData>ApproverComment}.length > 500 ? 'Warning' : 'None' }" 
														valueLiveUpdate="false" 
														liveChange="handleLiveChange" 
														enabled="false"/>
											
										</cells>
										
									</ColumnListItem>
									
								</items>
								
						</Table>
							
				</items>
			
		</VBox>
					
</core:FragmentDefinition>