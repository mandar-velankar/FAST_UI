	<!-- DELIVERIES SUB SECTION PAGE -->

	<ObjectPageSubSection id="DelivTrackDeliveriesSubsection" title="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? 'Purchase Orders' : 'Deliveries' }">
		<blocks>
			<!-- <core:Fragment fragmentName="FAST_NS0FAST0.view.fragments.PurchaseOrder" type="XML"/>-->
		</blocks>
	</ObjectPageSubSection>

	<!-- FORM WITH DELIVERY DATA -->
	<ObjectPageSubSection id="idDeliveryDetailSection" title="Delivery Details" visible="false">
		<blocks>
			<m:VBox width="100%">
				<form:SimpleForm id="idDeliveryDetailForm" editable="true" maxContainerCols="1" layout="ColumnLayout" columnsL="1" columnsM="1"
					class="editableForm" visible="true">
					<form:content>
						<m:Label text="{i18n>Institute}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						<m:Select id="idDeliveryDetailInstituteID" selectedKey="{fastAppData>InstituteID}" items="{ path: 'fastAppData>/InstituteWithChildren/' }"
							enabled="{= ${fastAppData>/EditMode} === true ? true : false}" visible="{= ${fastAppData>/Tender/GroupPurchasing} !== 0 ? true : false}">
							<core:Item key="{fastAppData>InstituteID}" text="{fastAppData>InstituteName}"/>
						</m:Select>
						<!--<m:Title level="H4" text="Penalty Details:" width="100%"/>-->
						<m:Label text="{i18n>PenaltyValue}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						<m:Input id="idPenaltyValueTab" value="{fastAppData>PenaltyValue}" type="Number"
							enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>Penalty} === 'Yes' ? true : false}"
							visible="{= ${fastAppData>Penalty} === 'Yes' ? true : false}"/>
						<m:Select id="idDeliveryDetailPenaltyCurrency" selectedKey="{fastAppData>Currency}"
							items="{ path: 'fastAppData>/CountryCurrency/', sorter: { path: 'COUNTRY_CODE' } }"
							enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>Penalty} === 'Yes' ? true : false}"
							visible="{= ${fastAppData>Penalty} === 'Yes' ? true : false}">
							<core:Item key="{fastAppData>CURRENCY}" text="{fastAppData>CURRENCY}"/>
						</m:Select>
						<m:Label text="{i18n>PenaltyReason}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						<m:Select id="idDeliveryDetailPenaltyReason" selectedKey="{fastAppData>PenaltyReason}"
							items="{ path: 'fastAppData>/PenaltyReasons/', sorter: { path: 'PenaltyReasons' } }"
							enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>Penalty} === 'Yes' ? true : false}"
							visible="{= ${fastAppData>Penalty} === 'Yes' ? true : false}">
							<core:Item key="{fastAppData>PenaltyReasons}" text="{fastAppData>PenaltyReasons}"/>
						</m:Select>
						<!--<m:Title level="H4" text="Compensated Details:" />-->
						<m:Label text="{i18n>UndertakingLetters}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						<m:Select id="idDeliveryDetailUndertakingLetters" selectedKey="{fastAppData>UndertakingLetters}"
							enabled="{= ${fastAppData>/EditMode} === true ? true : false}">
							<m:items>
								<core:Item text="Yes" key="Yes"/>
								<core:Item text="No" key="No"/>
							</m:items>
						</m:Select>
						<m:Label text="{i18n>CompensationComment}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						<m:Input id="idDeliveryDetailCompensationComment" value="{fastAppData>CompensationComment}"
							enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>Compensated} === 'Yes' ? true : false}"
							visible="{= ${fastAppData>Compensated} === 'Yes' ? true : false}"/>
						<m:Label text="" required="false"/>
						<m:SegmentedButton selectedKey="competitor" class="sapUiSmallMarginBottom">
							<m:items>
								<m:SegmentedButtonItem icon="sap-icon://accept" text="Confirm" press="onConfirmDelivery"
									visible="{= ${fastAppData>/EditMode} === true ? true : false}"/>
								<!--<m:SegmentedButtonItem icon="sap-icon://sys-cancel" text="Cancel" press="onCancelDeliveryEdit" visible="{= ${fastAppData>/EditMode} === true ? true : false}" />-->
							</m:items>
						</m:SegmentedButton>
					</form:content>
				</form:SimpleForm>
			</m:VBox>
		</blocks>
	</ObjectPageSubSection>
	<!-- LETTERS SUB SECTION PAGE -->
	<ObjectPageSubSection id="DelivTrackLettersSubsection" title="Returns" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
		<blocks>
			<m:VBox visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? false : true }">
				<m:Toolbar>
					<m:ToolbarSpacer/>
					<m:Button id="idAddLtr" visible="{= ${fastAppData>/EditMode} === true ? true : false}" text="{i18n>AddLetter}" icon="sap-icon://add" press="onAddLetter"/>
				</m:Toolbar>
				<!-- Letters table -->
				<m:Table id="lettersTableID" mode="{= ${fastAppData>/EditMode} === true ? 'Delete' : 'SingleSelectMaster'}" delete=".onDeleteLetter"
					selectionChange=".onLetterItemSelect"
					items="{ 
						path: 'fastAppData>/SelectedDeliverieProduct/Letters/results/', 
						filters: [ 
							{ path : '_sOperation', operator : 'NE', value1 : 'DELETE' },
							{ path : 'ACTIVE', operator : 'NE', value1 : 0 }  
						] }">
					<m:columns>
						<!--<m:Column width="7rem">
							<m:Label text="Product SKU" wrapping="true"/>
						</m:Column>-->
						<m:Column width="7rem">
							<m:Label text="Reason for Return" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="Quantity" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="Batch" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="8.5rem">
							<m:Label text="Manufacturing date" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="8.5rem">
							<m:Label text="Expiry Date" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="8.57rem">
							<m:Label text="Returned Date" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="Returned Quantity" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="7rem">
							<m:Label text="UOM" wrapping="true" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
					</m:columns>
					<m:items>
						<m:ColumnListItem id="lettersTableListID" type="{= ${fastAppData>/EditMode} === true ? 'DetailAndActive' : 'Navigation'}"
							detailPress=".onLetterItemDetail" press="{= ${fastAppData>/EditMode} === true ? '.onLetterItemSelect' : ''}">
							<m:cells>
								<!--<m:ObjectIdentifier title="{fastAppData>SKUCODE}"/>-->
								<!--<m:Input value="{fastAppData>SKUCODE}" enabled="false"/>-->
								<m:Input value="{fastAppData>REASONFORLETTER}" enabled="false"/>
								<m:Input value="{fastAppData>QUANTITY}" enabled="false"/>
								<m:Input value="{fastAppData>BATCH}" enabled="false"/>
								<!--<m:DatePicker id="idManufacturingDate"-->
								<!--	placeholder="Manufacturing Date" -->
								<!--	tooltip="Manufacturing Date"-->
								<!--	dateValue="{fastAppData>MANUFACTURINGDATE}" -->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	enabled="false"/>-->
								<m:DatePicker id="idManufacturingDate"
									value="{path :'fastAppData>MANUFACTURINGDATE', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="Manufacturing Date" enabled="false" placeholder="Manufacturing Date"/>
								<!--<m:DatePicker id="idExpiryDate"-->
								<!--	placeholder="Expiration Date" -->
								<!--	tooltip="Expiration Date"-->
								<!--	dateValue="{fastAppData>EXPIRYDATE}"-->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	enabled="false"/>-->
								<m:DatePicker id="idExpiryDate"
									value="{path :'fastAppData>EXPIRYDATE', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="Expiration Date" enabled="false" placeholder="Expiration Date"/>
								<!--<m:DatePicker id="idReturnDate"-->
								<!--	placeholder="Return Date" -->
								<!--	tooltip="Return Date"-->
								<!--	dateValue="{fastAppData>RETURNDATE}"-->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	enabled="false"/>-->
								<m:DatePicker id="idReturnDate"
									value="{path :'fastAppData>RETURNDATE', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="Return Date" enabled="false" placeholder="Return Date"/>
								<m:Input value="{fastAppData>RETURNEDQTY}" enabled="false"/>
								<m:Input value="{fastAppData>UOM}" enabled="false"/>
							</m:cells>
						</m:ColumnListItem>
					</m:items>
				</m:Table>
			</m:VBox>
		</blocks>
	</ObjectPageSubSection>
	<!-- FORM WITH Letter DATA -->
	<ObjectPageSubSection id="idLetterDetailSection" title="Letter Details" visible="false">
		<blocks>
			<m:VBox width="100%">
				<form:SimpleForm id="idLetterDetailForm" editable="true" maxContainerCols="1" layout="ColumnLayout" columnsL="1" columnsM="1"
					class="editableForm" visible="true">
					<form:content>
						<m:Label text="{i18n>Institute}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						<m:Select id="idLetterDetailInstituteID" selectedKey="{fastAppData>INSTITUTEID}" items="{ path: 'fastAppData>/InstituteWithChildren/' }"
							enabled="{= ${fastAppData>/EditMode} === true ? true : false}" visible="{= ${fastAppData>/Tender/GroupPurchasing} !== 0 ? true : false}">
							<core:Item key="{fastAppData>InstituteID}" text="{fastAppData>InstituteName}"/>
						</m:Select>
						<m:Label text="" required="false"/>
						<m:SegmentedButton selectedKey="competitor" class="sapUiSmallMarginBottom">
							<m:items>
								<m:SegmentedButtonItem icon="sap-icon://accept" text="Confirm" press="onConfirmLetter"
									visible="{= ${fastAppData>/EditMode} === true ? true : false}"/>
								<!--<m:SegmentedButtonItem icon="sap-icon://sys-cancel" text="Cancel" press="onCancelDeliveryEdit" visible="{= ${fastAppData>/EditMode} === true ? true : false}" />-->
							</m:items>
						</m:SegmentedButton>
					</form:content>
				</form:SimpleForm>
			</m:VBox>
		</blocks>
	</ObjectPageSubSection>
</mvc:View>