					<m:VBox>
						<m:FormattedText htmlText="Offer not available for delivery tracking..."/>
					</m:VBox>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</ObjectPageSubSection>
