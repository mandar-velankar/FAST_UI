	<!-- TENDER OFFER -->
	<u:ObjectPageSubSection title="{i18n>tendrofr}" mode="Expanded">
		<u:actions>
			<Button text="Delete Offer" icon="sap-icon://delete" press="onDeleteProductOffer" enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>
			<Button text="New Offer" icon="sap-icon://add" press="onCreateProductOffer"/>
			<Button text="Revised Offer" icon="sap-icon://add" press="onReviewProductOffer" enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>
			<Button text="Continued Offer" icon="sap-icon://add" press="onContinuedProductOffer" enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>		
		</u:actions>
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell>
					<!--<VBox>-->
					
						<!-- Panel for offers so, we can hide the table 
						<Panel id="panelProductOfferTableID" expandable="true" width="auto" class="sapUiResponsiveMargin" expanded="false" expand="onExpandOfferTable" expandAnimation="false">
							

							<headerToolbar>
								<OverflowToolbar height="3rem">
									<Title level="H3" text="Offers"/>
								</OverflowToolbar>
							</headerToolbar>
							
							

							<content>

								<Table id="productOffersTableViewID" 
								       items="{ 
								    	path: 'fastAppData>/Tender/Offer/results',
								    	sorter: [
								    		{path: 'TenderOfferNo', descending: true},
								    		{path: 'RevisedOfferNo', descending: true}
								    	],
								    	filters: [
								    		{ path : 'Active', operator : 'EQ', value1 : '1'}, 
								    		{ path : 'ActiveOffer', operator : 'EQ', value1 : '1'}
								    	]}"  
								       inset="false"
									   class="sapFDynamicPageAlignContent" 
									   width="auto"
									   updateFinished="onProductOffersTableViewFinished"
									   > 
									   
									<columns>
										<Column id="productOffersTableOfferID" width="14rem">
											<Text text="{i18n>ofrid}"/>
										</Column>
										<Column>
											<Text text="{i18n>distbtr}"/>
										</Column>
										<Column width="6rem">
											<Text text="{i18n>ofrdte}"/>
										</Column>
										<Column width="10rem">
											<Text text="{i18n>OfferStatus}"/>
										</Column>
									</columns>
									
									<items>
										<ColumnListItem type="Navigation" press=".onProductOfferItemPress" >  
											<cells>
												
												<ObjectIdentifier title="{fastAppData>OfferID}"/>
