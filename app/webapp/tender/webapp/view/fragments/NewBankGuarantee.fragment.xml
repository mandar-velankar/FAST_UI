<!-- Fragment for Creating a new contract -->
<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:l="sap.ui.layout" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:core="sap.ui.core"
	xmlns:dnd="sap.ui.core.dnd">

	<Dialog title="Create Bank Guarantee" stretch="true">
		<buttons>
			<Button text="Save" press="onSaveNewBankGuarantee" />
			<Button text="Cancel" press="onCancelNewBankGuarantee" />
		</buttons>


		<!-- FORM WITH OFFER DATA -->
		<form:SimpleForm 
			id="idCreateBankGuaranteeForm" 
			editable="true" 
			maxContainerCols="1" 
			layout="ResponsiveGridLayout"  
			labelSpanL="12" 
			labelSpanM="12"
			emptySpanL="0" 
			emptySpanM="0" 
			columnsL="2" 
			columnsM="2" 
			class="editableForm" 
			visible="true">

			<form:content>
			<core:Title/>

				<!-- Reference -->
				<Label text="{i18n>reference}"/>
				<Input id="idBankGuaranteeReference"
					   value="{fastAppData>/newBankGuarantee/Reference}"
					   required="true"/>

				<!-- Type -->
				<Label text="{i18n>type}"/>
				<Select id="idCountrynewBankGuarantee" 
						selectedKey="{fastAppData>/newBankGuarantee/Type}"
						change=".onChangeGuaranteeType"
						enabled="true">
					<core:Item text="" key=""/>
					<core:Item text="Impegno" key="Impegno"/>
                    <core:Item text="Provisoria" key="Provisoria"/>
					<core:Item text="Definitiva" key="Definitiva"/>
				</Select>

				<!-- Amount -->
				<Label text="{i18n>amount}" required="true"/>
				<Input id="idBankGuaranteeAmount" 
					   value="{fastAppData>/newBankGuarantee/GuaranteedAmount}" 
					   required="true" 
					   type="Number"/>

				<!-- Currency -->
				<Label text="{i18n>Currency}" required="true" />
				<Select id="idCurrencynewBankGuarantee" selectedKey="{fastAppData>/newBankGuarantee/Currency}" items="{ path: 'fastAppData>/CountryCurrency/', sorter: { path: 'COUNTRY_CODE' } }">
					<core:Item key="{fastAppData>CURRENCY}" text="{fastAppData>CURRENCY}"/>
				</Select>

				<!-- Contract Date -->
				<Label text="{i18n>issueDate}" required="true"/>
				<DatePicker 
					id="idIssueDateNewBankGuarantee" 
					value="{
						path :'fastAppData>/newBankGuarantee/IssueDate', 
						type: 'sap.ui.model.type.Date', 
						formatOptions: { pattern: 'yyyy-MM-dd' , UTC:true}
					}" 
					enabled="true"/>

				<!-- Contract Date -->
				<Label text="{i18n>closingDate}" required="true"/>
				<DatePicker 
					id="idClosingDateNewBankGuarantee" 
					value="{
						path :'fastAppData>/newBankGuarantee/ClosingDate', 
						type: 'sap.ui.model.type.Date', 
						formatOptions: { pattern: 'yyyy-MM-dd' , UTC:true}
					}" 
					enabled="true"/>

                <Label text="{i18n>comment}"/>
				<TextArea value="{fastAppData>/newBankGuarantee/Comment}" 
								          		  showExceededText="true" 
										  		  maxLength="500" 
										  		  valueLiveUpdate="false" liveChange="handleLiveChange"
												  enabled="true"/>
				

			</form:content>
		</form:SimpleForm>

				
				


   	</Dialog>	
</core:FragmentDefinition>