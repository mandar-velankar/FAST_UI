<core:FragmentDefinition controllerName="FAST_NS0FAST0.controller.DeliveryTracking" xmlns="sap.uxap" xmlns:m="sap.m" xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	
	<!-- PO SUB SECTION PAGE -->

			<m:VBox>
				<!-- Buttons for editing -->
				<m:Toolbar id='deliveriesTableToolbarId' design="Solid">
					<m:ToolbarSpacer/>
					<m:Button visible="{= ${fastAppData>/EditMode} === true ? true : false}" text="{i18n>AddDelivery}" icon="sap-icon://add" press="onAddPurchaseOrder"/>
					<!--<m:Button id="idDelDelv" visible="false" text="{i18n>DeleteDelivery}" icon="sap-icon://delete" press="onDeleteDeliverie" enabled="{= ${fastAppData>/SelectedDeliverieProduct/Deliveries/results/length} > 0 }"/>-->
				</m:Toolbar>
				<!-- Deliveries table -->
				<m:Table id="deliveriesTableID" popinLayout="GridSmall" mode="{= ${fastAppData>/EditMode} === true ? 'Delete' : 'SingleSelectMaster'}"
					delete=".onDeleteDeliverie" selectionChange=".onDeliveryItemSelect"
					items="{ 
						path: 'fastAppData>/SelectedDeliverieProduct/Deliveries/results/', 
						filters: [ 
							{ path : '_sOperation', operator : 'NE', value1 : 'DELETE' },
							{ path : 'Active', operator : 'NE', value1 : 0 } 
						] 
					}">
					<m:columns>
						<m:Column width="8.5rem">
							<m:Label text="{i18n>PoDate}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>PoQty}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>PONumber}" wrapping="true"/>
						</m:Column>
                        <m:Column width="6rem">
							<m:Label text="{i18n>contract}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
                        <m:Column width="6rem">
							<m:Label text="{i18n>Institute}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
					</m:columns>
					<m:items>
						<m:ColumnListItem type="{= ${fastAppData>/EditMode} === true ? 'DetailAndActive' : 'Navigation'}"
							detailPress=".onDeliveryItemDetail" press="{= ${fastAppData>/EditMode} === true ? '.onDeliveryItemSelect' : ''}">
							<m:cells>
								<m:DatePicker
									value="{path :'fastAppData>PoDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="{i18n>PoDate}" enabled="false" placeholder="{i18n>Select_date}"/>
								
                                <m:Input value="{fastAppData>ActualDeliveryQuantity}" type="Number" enabled="false" required="true"/>

								<m:Input value="{fastAppData>PO}" enabled="false"/>

                                <m:Select selectedKey="{fastAppData>Contract}" change="onChangeContract" enabled="false">
									<m:items>
										<core:Item text="Yes" key="Yes"/>
										<core:Item text="No" key="No"/>
									</m:items>
								</m:Select>

                                <m:Select selectedKey="{fastAppData>InstituteID}" items="{ path: 'fastAppData>/InstituteWithChildren/' }"
                                        enabled="{= ${fastAppData>/EditMode} === true ? true : false}" visible="{= ${fastAppData>/Tender/GroupPurchasing} !== 0 ? true : false}">
                                        <core:Item key="{fastAppData>InstituteID}" text="{fastAppData>InstituteName}"/>
                                </m:Select>

							</m:cells>
						</m:ColumnListItem>
					</m:items>
				</m:Table>
			</m:VBox>
</core:FragmentDefinition>