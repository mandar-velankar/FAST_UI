<core:FragmentDefinition controllerName="FAST_NS0FAST0.controller.OfferProducts" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:t="sap.ui.table" xmlns:u="sap.uxap">
	
	<!-- Product OFFER - EDIT mode -->
	<u:ObjectPageSubSection >
		
		<!--<u:blocks>-->
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell >
					<VBox>
						
						<!-- FORM WITH INPUT FIELDS: Distributer name, Internal due date, WholeSaleOffer, Selling Company,... -->
						<form:SimpleForm editable="true" id="editForm" maxContainerCols="3" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
							emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm">
							<form:content>
								
								<core:Title/>
								
								<Label text="{i18n>didtrbtrnme}" design="Bold" required="true"/>
								
								<Select id="idDistributorName" 
									enabled="false"
									selectedKey="{fastAppData>/EditOffer/DistributorID}"
									items="{ path: 'fastData>/InstituteDistributor', sorter: { path: 'DISTRIBUTOR_NAME' } }"
									change="onChangeDistributor"
									visible="true">
									<core:Item text="{fastData>DISTRIBUTOR_NAME}" key="{fastData>DISTRIBUTOR_ID}"/>
								</Select>

								<Label text="{i18n>selncmpny}" design="Bold" required="true"/>
								<Select id="idSellingCompany" 
										selectedKey="{fastAppData>/EditOffer/SellingCompany}" 
										items="{ path: 'fastData>/CountryLegalEntity', sorter: { path: 'LegalEntityName' } }"
										change="onChangeSellingCompany">
									<core:Item text="{fastData>LegalEntityName}" key="{fastData>LegalEntityCode}"/>
								</Select>

                                <Label text="{i18n>bu}" design="Bold" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? true : false}"/>
							    <Input value="{fastAppData>/EditOffer/BU}"/>
                                <Label text="{i18n>offerNumber}" design="Bold" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? true : false}"/>
								<Input value="{fastAppData>/EditOffer/OfferNumber}" enabled="false"/>
                                
								<core:Title/>
								
								<Label text="{i18n>intrnlduedte}" required="{= ${fastAppData>/Tender/CountryCode} === 'ES' ? false : true}"/>
								<!--<DatePicker id="idintrDueDte" value="{path :'fastAppData>/EditOffer/InternalBidDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" />-->
								<DatePicker id="idintrDueDte" minDate="{dateModel>/minDate}" value="{path :'fastAppData>/EditOffer/InternalBidDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>
								
								<Label text="{i18n>ofrduedte}"/>
								<!--<Text text="{path :'fastData>BidDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}"/>-->
								<DatePicker id="idOrfDueDate" value="{path :'fastData>BidDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
								
								<core:Title/>
								
								<Label text="{i18n>whlseofr}" required="true"/>
								<Select id="idWhleSle" selectedKey="{fastAppData>/EditOffer/WholesaleOffer}" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH' || ${fastAppData>/Tender/CountryCode} === 'AR' || ${fastAppData>/Tender/CountryCode} === 'CL'  || ${fastAppData>/Tender/CountryCode} === 'IT' ? false : true}">
									<items>
										<core:Item text="No" key="No"/>
										<core:Item text="Yes" key="Yes"/>
									</items>
								</Select>

								<Label text="{i18n>newOfferDate}" required="true" visible="{= (${fastAppData>/NewOfferPressed} === false &amp;&amp; ((${fastAppData>/ReviewedOfferPressed} === true || ${fastAppData>/ContinuedOfferPressed} === true) || ( (${fastAppData>/ReviewedOfferPressed} === false &amp;&amp; ${fastAppData>/ContinuedOfferPressed} === false) &amp;&amp; (${fastAppData>/EditOffer/RevisedOfferNo} !== 0 || ${fastAppData>/EditOffer/ContinuationOfferNo} !== 0)))) ? true : false }"/>
								<DatePicker id="idNewOfferDate" minDate="{dateModel>/minDate}" required="true" value="{path :'fastAppData>/EditOffer/NewOfferDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" visible="{= (${fastAppData>/NewOfferPressed} === false &amp;&amp; ((${fastAppData>/ReviewedOfferPressed} === true || ${fastAppData>/ContinuedOfferPressed} === true) || ( (${fastAppData>/ReviewedOfferPressed} === false &amp;&amp; ${fastAppData>/ContinuedOfferPressed} === false) &amp;&amp; (${fastAppData>/EditOffer/RevisedOfferNo} !== 0 || ${fastAppData>/EditOffer/ContinuationOfferNo} !== 0)))) ? true : false }"/>

								<Label text="{i18n>Division}" required="true"/>
								<Select id="idProductOfferDivision" selectedKey="{fastAppData>/EditOffer/Division}" enabled="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? false : true}" change="onChangeDivision">
										<items>
											<core:Item text="" key=""/>
											<core:Item text="Pharma" key="Pharma"/>
											<core:Item text="Radiology" key="Radiology"/>
										</items>
								</Select>	
                                <!-- Spain only --> <!-- TODO: this is not a scalable solution. We should consider using a service to get the item values for Division -->
                                <Label text="{i18n>Division}" required="true"/>
                                <Select id="idProductOfferDivisionES" selectedKey="{fastAppData>/EditOffer/Division}" enabled="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? true : false}" change="onChangeDivision">
                                    <items>
                                        <core:Item text="" key=""/>
                                        <core:Item text="Pharma" key="Pharma"/>
                                        <core:Item text="Radiology" key="Radiology"/>
                                        <core:Item text="Consumer Health" key="Consumer Health"/>
                                    </items>
                                </Select>		
								<!-- <Text id="idDistID" text="{fastAppData>/EditOffer/Distributor/DistributorID}" visible="false"/> -->
								
							</form:content>
						</form:SimpleForm>
						
						<!-- Table with the products -->
							<!-- removed for When navigating back from QUOTATION to OFFER PRODUCTS, Edit mode doesn't show products
								 TBD w/ Nils why this should be here. Delete / display functionality seems to be working properly 
								 without this filter. -->
							<!--filters : [
                            		{ path : '_sOperation', operator : 'NE', value1 : 'DELETE'}
                        	  ]-->
						<t:Table id="editofferProductId" 
							   rows="{
									path : 'fastAppData>/EditOffer/Product/results/', 
									sorter : {
									            path : 'SORTER' 
									         }}"
							   visibleRowCount="15" 
							   alternateRowColors="true" 
							   width="100%">
							<t:toolbar>
								<Toolbar design="Solid">
									
									<ToolbarSpacer/>
									<Button text="{i18n>DeclineProduct}" icon="sap-icon://decline" press="onDeclineAllProductsForOffer" enabled="{= ${fastAppData>/EditOffer/Product/results/length} > 0 }"/>
									<Button text="{i18n>Addprod}" icon="sap-icon://add" press="onAddProductForOffer" enabled="{= ${fastAppData>/EditOffer/Division} ? true : false }"/>
									<Button text="{i18n>Deleteprod}" icon="sap-icon://delete" press="onDeleteProductForOffer" enabled="{= ${fastAppData>/EditOffer/Product/results/length} > 0 }"/>
								</Toolbar>
							</t:toolbar>
							<t:columns>
								<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/Line/visible}">
									<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Line/description',
												   formatter: '.formatter.offerProductsColumnName' }" 
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Line/required}"/>
									<t:template>
										<Input value="{fastAppData>Line}" maxLength="100"/>
									</t:template>
								</t:Column>
								<t:Column width="400px" visible="{fastAppData>/permissions/tables/editofferProductId/Product/visible}">
									<Label id="idProductLabel" text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Product/description',
												  					   formatter: '.formatter.offerProductsColumnName' }" 
												    		   wrapping="true" 
															   required="{fastAppData>/permissions/tables/editofferProductId/Product/required}"/>
									<t:template>
										<VBox>
											<Input value="{fastAppData>SKU/Product/HLEVEL6_NAME}" editable="false" maxLength="100" visible="{fastAppData>/permissions/tables/editofferProductId/Package/visible}" />
											<Input value="{fastAppData>SKU/PRODUCTPACKNAME}" editable="false" maxLength="100" visible="{= !${fastAppData>/permissions/tables/editofferProductId/Package/visible} }" />	
										</VBox>
									</t:template>
								</t:Column>

								<t:Column width="100px" visible="{fastAppData>/permissions/tables/editofferProductId/PackFactor/visible}">
									<Label id="idPackFactorLabel" text="{ path: 'fastAppData>/permissions/tables/editofferProductId/PackFactor/description',
												  					   formatter: '.formatter.offerProductsColumnName' }" 
												    		      wrapping="true" 
															      required="{fastAppData>/permissions/tables/editofferProductId/PackFactor/required}"/>
									<t:template>
										<VBox>
											<Input value="{fastAppData>SKU/PACKFACTOR}" editable="false" maxLength="100" visible="{fastAppData>/permissions/tables/editofferProductId/PackFactor/visible}" />
										</VBox>
									</t:template>
								</t:Column>

								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/OfferType/visible}">
									<Label id="idOfferTypeLabel" text="{ path: 'fastAppData>/permissions/tables/editofferProductId/OfferType/description',
												  					   formatter: '.formatter.offerProductsColumnName' }" 
												    		     wrapping="true" 
															     required="{fastAppData>/permissions/tables/editofferProductId/OfferType/required}"/>
									<t:template>
										<Select selectedKey="{fastAppData>OfferType}">
											<items>
												<core:Item text="" key=""/>
												<core:Item text="Selling" key="Selling"/>
												<core:Item text="Rental" key="Rental" enabled="{= ${fastAppData>/EditOffer/Division} === 'Radiology' }"/>
												<core:Item text="Comodato" key="Comodato" enabled="{= ${fastAppData>/EditOffer/Division} === 'Radiology' }"/>
											</items>
											<layoutData>
												<l:GridData span="L6 M6 S6"/>
											</layoutData>
										</Select>
									</t:template>
								</t:Column>
								<t:Column width="200px" visible="{fastAppData>/permissions/tables/editofferProductId/Reference/visible}">
									<Label id="idReferenceLabel" 
									       text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Reference/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Reference/required}"
									/>
									<t:template>
										<Input  id="idReference" value="{fastAppData>Reference}" placeholder="{i18n>reference}"  maxLength="255"/>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/AlternateOfferYN/visible}">
									<Label id="idAlternateOfferLabel" 
									       text="{ path: 'fastAppData>/permissions/tables/editofferProductId/AlternateOfferYN/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true"
										   required="{fastAppData>/permissions/tables/editofferProductId/AlternateOfferYN/required}"/>
									<t:template>
										<Select selectedKey="{fastAppData>AlternateOfferYN}">
											<items>
												<core:Item text="No" key="No"/>
												<core:Item text="Alternative to requested products" key="Alternative to requested products"/>
												<core:Item text="Alternative to quoted products" key="Alternative to quoted products"/>
											</items>
											<layoutData>
												<l:GridData span="L6 M6 S6"/>
											</layoutData>
										</Select>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/Requested/visible}">
									<Label id="idRequestedVolumeLabel"
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Requested/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Requested/required}"/>
									<t:template>
										<HBox>
											<Input type="Number" value="{fastAppData>RequestedVolume}" placeholder="{i18n>Requested}"  required="true" enabled="{= ${fastAppData>/Tender/GroupPurchasing} !== 2 ? true : false}"/>
											<Button icon="sap-icon://edit" press="onPressEditRequestedVolume" visible="{= ${fastAppData>/Tender/GroupPurchasing} === 2 ? true : false}"/>
										</HBox>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/Unitpack/visible}">
									<Label id="idUomLabel" 
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Unitpack/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Unitpack/required}"/>
									<t:template>
										<Select selectedKey="{fastAppData>UnitPerPack}">
											<items>
												<core:Item text="Unit" key="Unit"/>
												<core:Item text="Pack" key="Pack"/>
											</items>
											<layoutData>
												<l:GridData span="L6 M6 S6"/>
											</layoutData>
										</Select>
									</t:template>
								</t:Column>
								<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/SapNo/visible}">
									<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/SapNo/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/SapNo/required}"/>
									<t:template>
										<Input value="{fastAppData>SKUCountry/ProductPack/ProductPackSKUs/results/SKUCode}" editable="false" maxLength="100"/>
									</t:template>
								</t:Column>

								<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/CodeNational/visible}">
									<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/CodeNational/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/CodeNational/required}"/>
									<t:template>
										<Input value="{fastAppData>SKUCountry/GOV_CODE}" editable="false" maxLength="100"/>
									</t:template>
								</t:Column>

								<t:Column width="100px" visible="{fastAppData>/permissions/tables/editofferProductId/AicCnd/visible}">
									<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/AicCnd/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/AicCnd/required}"/>
									<t:template>
										<Input value="{fastAppData>SKUCountry/CODE1}" editable="false" maxLength="100"/>
									</t:template>
								</t:Column>

								<t:Column width="100px" visible="{fastAppData>/permissions/tables/editofferProductId/AtcRdm/visible}">
									<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/AtcRdm/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/AtcRdm/required}"/>
									<t:template>
										<Input value="{fastAppData>SKUCountry/CODE2}" editable="false" maxLength="100"/>
									</t:template>
								</t:Column>

								<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/Package/visible}">
									<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Package/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Package/required}"/>
									<t:template>
										<Input value="{fastAppData>SKU/PRODUCTPACKNAME}" editable="false" maxLength="100"/>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/Sample/visible}">
									<Label id="idSampleLabel" 
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Sample/description',
												   formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Sample/required}"/>
									<t:template>
										<Input type="Text" value="{fastAppData>SampleYN}" placeholder="{i18n>Sample}" editable="true" />
										<Select selectedKey="{fastAppData>SampleYN}" change="onChangeSampleYN">
											<items>
												<core:Item text="Yes" key="Yes"/>
												<core:Item text="No" key="No"/>
											</items>
											<layoutData>
												<l:GridData span="L6 M6 S6"/>
											</layoutData>
										</Select>
									</t:template>
								</t:Column>
								<t:Column width="100px" visible="{fastAppData>/permissions/tables/editofferProductId/Quantity/visible}">
									<Label id="idQuantityLabel" 
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Quantity/description',
											       formatter: '.formatter.offerProductsColumnName' }" 
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Quantity/required}"/>
									<t:template>
										<Input type="Number" value="{fastAppData>SampleQuantity}" placeholder="{i18n>Quantity}" editable="{= ${fastAppData>SampleYN} === 'Yes' }"/>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/Documents/visible}">
									<Label id="idDocumentsLabel"
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Documents/description',
											       formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Documents/required}"/>
									<t:template>
										<Select selectedKey="{fastAppData>DocumentsRequired}">
											<items>
												<core:Item text="Yes" key="Yes"/>
												<core:Item text="No" key="No"/>
											</items>
											<layoutData>
												<l:GridData span="L6 M6 S6"/>
											</layoutData>
										</Select>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/FirstShipment/visible}">
									<Label id="idFirstShipmentLabel"
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/FirstShipment/description',
											       formatter: '.formatter.offerProductsColumnName' }"
									       wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/FirstShipment/required}"/>
									<t:template>
										<Input type="Text" value="{fastAppData>FirstShipment}" placeholder="{i18n>FirstShipment}" editable="true" required="true"/>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/NoLots/visible}">
									<Label id="idNolotsLabel"
									       text="{ path: 'fastAppData>/permissions/tables/editofferProductId/NoLots/description',
											       formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/NoLots/required}"/>
									<t:template>
										<Input type="Number" value="{fastAppData>NoofLots}" placeholder="{i18n>NoLots}" editable="true" required="true"/>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/IntervalBetweenShipments/visible}">
									<Label id="idInShipmentsLabel"
									       text="{ path: 'fastAppData>/permissions/tables/editofferProductId/IntervalBetweenShipments/description',
											       formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/IntervalBetweenShipments/required}"/>
									<t:template>
										<Input type="Number" value="{fastAppData>IntervalBetweenShipments}" placeholder="{i18n>inshipmnths}" editable="true" required="true"/>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/PaymentTerms/visible}">
									<Label id="idPaymentTermsLabel" 
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/PaymentTerms/description',
											       formatter: '.formatter.offerProductsColumnName' }" 
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/PaymentTerms/required}"/>
									<t:template>
										<Input type="Text" value="{fastAppData>PaymentTerms}" placeholder="{i18n>PaymentTerms}" editable="true"/>
									</t:template>
								</t:Column>
								<t:Column width="150px" visible="{fastAppData>/permissions/tables/editofferProductId/INCOTerms/visible}">
									<Label id="idIncoTermsLabel"
										   text="{ path: 'fastAppData>/permissions/tables/editofferProductId/INCOTerms/description',
											       formatter: '.formatter.offerProductsColumnName' }"
									       wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/INCOTerms/required}"/>
									<t:template>
										<Input type="Text" value="{fastAppData>INCOTerms}" placeholder="{i18n>INCOTerms}" editable="true"/>
									</t:template>
								</t:Column>
								<t:Column width="200px" visible="{fastAppData>/permissions/tables/editofferProductId/Decline/visible}">
									<Label id="idDeclineLabel"
									       text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Decline/description',
											       formatter: '.formatter.offerProductsColumnName' }"
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Decline/required}"/>
									<t:template>
										<Select  selectedKey="{fastAppData>ActiveProduct}" change="onChangeDecline">
											<items>
												<core:Item text="Product Included" key="1"/>
												<core:Item text="Product Declined" key="2"/>
											</items>
											<layoutData>
												<l:GridData span="L6 M6 S6"/>
											</layoutData>
										</Select>
									</t:template>
								</t:Column>
								<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/Comment/visible}">
									<Label id="idCommentLabel"
									       text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Comment/description',
											       formatter: '.formatter.offerProductsColumnName' }"	   
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/Comment/required}"/>
									<t:template>
										<Input type="Text" 
											   value="{fastAppData>Comment}" 
											   placeholder="{i18n>Comment}" 
											   editable="{= ${fastAppData>/Tender/CountryCode} === 'CL' || (${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp; (${fastAppData>ActiveProduct} === 2 || ${fastAppData>ActiveProduct} === '2'))}"/>
									</t:template>
								</t:Column>

								<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/MinInvoiceAmount/visible}">
									<Label id="idMinInvoiceAmount"
									       text="{ path: 'fastAppData>/permissions/tables/editofferProductId/MinInvoiceAmount/description',
											       formatter: '.formatter.offerProductsColumnName' }"	   
										   wrapping="true" 
										   required="{fastAppData>/permissions/tables/editofferProductId/MinInvoiceAmount/required}"/>
									<t:template>
										<Input type="Number" value="{fastAppData>MinInvoiceAmount}" placeholder="{i18n>minInvoiceAmount}" editable="true"/>
									</t:template>
								</t:Column>

								<t:Column width="400px" visible="{fastAppData>/permissions/tables/editofferProductId/Brand/visible}">
