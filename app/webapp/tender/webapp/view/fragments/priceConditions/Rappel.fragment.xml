<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:l="sap.ui.layout" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <Panel expandable="true" expanded="{fastAppData>/RappelExpanded}">
		<headerToolbar>
			<OverflowToolbar>
				<Title text="Rappel"/>
				<ToolbarSpacer />
				<Switch state="{fastAppData>/RappelRequired}" visible="{fastAppData>/EditMode}" change=".onSwitchChanged($event,'Rappel')"/>
			</OverflowToolbar>
		</headerToolbar>
        <form:SimpleForm
            editable="true"
            class="editableForm"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="4"
            emptySpanL="4"
            emptySpanM="4"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="false" >
            <form:content>
                <Label text="{i18n>PVL}" required="true"/>
                <Input 
                    value="{= !${fastAppData>/EditMode} 
                        ? ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>PriceConditionPVL'},
                            {value: 2},
                            {path:'fastAppData>PriceConditionClassificationID'},
                            {path:'fastAppData>/ExistingAgreementInPlace'},
                            {path:'fastAppData>Conversion'}
                        ],
                        formatter: '.formatter.formatUoMPrice'}
                        : ${parts: [
                                {path:'fastAppData>ProductCode'},
                                {path:'fastAppData>/ProductPricingView'},
                                {path:'fastAppData>PVL'},
                                {value: 2}
                            ],
                            formatter: '.formatter.formatUoMCurrentPriceEsIt'}
                        }"
                    description="{fastAppData>masterPriceCurrency}" 
                    enabled="false" 
                    fieldWidth="80%"
                />
                <!-- <Label text="{i18n>RoyalDecree}" required="true"/> -->
                <Label text="{i18n>ConfidentialPrice}" required="true" visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}"/>
                <Input 
                    value="{= !${fastAppData>/EditMode}
                        ? ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>ConfidentialPrice'},
                            {value: 2},
                            {path:'fastAppData>PriceConditionClassificationID'},
                            {path:'fastAppData>/ExistingAgreementInPlace'},
                            {path:'fastAppData>Conversion'}
                        ],
                        formatter: '.formatter.formatUoMPrice'}
                        : ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>YLAP'},
                            {value: 2}
                        ],
                        formatter: '.formatter.formatUoMCurrentPriceEsIt'}
                        }"
                    visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}" 
                    description="{fastAppData>masterPriceCurrency}" 
                    enabled="false" 
                    fieldWidth="80%"
                />  
                <Label text="{i18n>RoyalDecreeApplies}"/>
                <Select selectedKey="{fastAppData>RoyalDecree}" enabled="false"> 
                    <items>
                        <core:Item key="No" text="No" />
                        <core:Item key="Yes" text="Yes" />									
                    </items>
                </Select>
                <Label text="{i18n>MainConditionPrice}"/>
                <Input value="{path:'fastAppData>MainPrice', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2, minFractionDigits: 2, groupingEnabled: false, groupingSeparator: ',', decimalSeparator: '.' }}" enabled="false" description="{fastAppData>masterPriceCurrency}" fieldWidth="80%"  type="Number"/>
                <Label text="{i18n>Liquidation}" required="true"/>
                <Select selectedKey="{fastAppData>Liquidation}" enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }"> 
                    <items>
                        <core:Item key="" text="" />
                        <core:Item key="Monthly" text="Monthly" />
                        <core:Item key="Quarterly" text="Quarterly" />
                        <core:Item key="HalfYearly" text="Half Yearly" />
                        <core:Item key="Annually" text="Yearly" />									
                    </items>
                </Select>
                
                <Label text="{i18n>PaymentBackDate}" required="true"/>
                <DatePicker
                        id="DP1"
                        value="{
                                path:'fastAppData>RefundDate',
                                type:'sap.ui.model.type.Date', 
                                formatOptions: { style: 'short', pattern: 'dd.MM.yyyy',UTC: true}
                        }"
                        placeholder="Enter Date"
                        change="handleChange"
                        enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }"
                        class="sapUiSmallMarginBottom"/>
                <Label text="{i18n>Settlement}" required="true"/>
                <Select selectedKey="{fastAppData>Settlement_ID}" 
                        enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }"
                        items="{fastData>/Settlements}"
                        forceSelection="false"> 
                    <items>
                        <core:Item key="{fastData>ID}" text="{fastData>Description}" />								
                    </items>
                </Select>
                <Label text="{i18n>VolTreshold}" required="true"/>
                <Button icon="sap-icon://value-help" press=".onVolumeTreshhold" enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }">
					<layoutData>
						<l:GridData span="XL1 L1 M1 S2" />
					</layoutData>
                </Button>
            </form:content>
        </form:SimpleForm>
    </Panel>
</core:FragmentDefinition>