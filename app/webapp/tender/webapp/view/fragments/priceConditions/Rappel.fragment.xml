<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:l="sap.ui.layout" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <Panel expandable="true" expanded="{fastAppData>/RappelExpanded}">
		<headerToolbar>
			<OverflowToolbar>
				<Title text="Rappel"/>
				<ToolbarSpacer />
				<Switch state="{fastAppData>/RappelRequired}" visible="{fastAppData>/EditMode}" change=".onSwitchChanged($event,'Rappel')"/>
			</OverflowToolbar>
		</headerToolbar>
        <form:SimpleForm
            editable="true"
            class="editableForm"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="4"
            emptySpanL="4"
            emptySpanM="4"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="false" >
            <form:content>
                <Label text="{i18n>PVL}" required="true"/>
                <Input value="{= ${fastAppData>/ProductPricingView/0/UOM} === 'Unit' ? ${fastAppData>PVL}/${fastAppData>/ProductPricingView/0/PACKFACTOR} : ${fastAppData>PVL} }"
                type="Number"  description="{fastAppData>Currency}" enabled="false" fieldWidth="80%"/><Label text="{i18n>RoyalDecree}" required="true"/>
                <Label text="{i18n>ConfidentialPrice}" required="true" visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}"/>
               <Input value="{= ${fastAppData>/ProductPricingView/0/UOM} === 'Unit' ? ${fastAppData>YLAP}/${fastAppData>/ProductPricingView/0/PACKFACTOR} : ${fastAppData>YLAP} }"
                type="Number"  visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}" description="{fastAppData>Currency}" enabled="false" fieldWidth="80%"/>  
                <Label text="{i18n>RoyalDecree}" required="true"/>
                <Select selectedKey="{fastAppData>RoyalDecree}" enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }"> 
                    <items>
                        <core:Item key="" text="" />
                        <core:Item key="Yes" text="Yes" />
                        <core:Item key="No" text="No" />									
                    </items>
                </Select>
                <Label text="{i18n>Liquidation}" required="true"/>
                <Select selectedKey="{fastAppData>Liquidation}" enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }"> 
                    <items>
                        <core:Item key="" text="" />
                        <core:Item key="Monthly" text="Monthly" />
                        <core:Item key="Quarterly" text="Quarterly" />
                        <core:Item key="Annually" text="Annually" />									
                    </items>
                </Select>
                <Label text="{i18n>PaymentBackDate}" required="true"/>
                <DatePicker
                        id="DP1"
                        value="{fastAppData>RefundDate}" 
                        valueFormat="yyyy-MM-dd" 
                        displayFormat="long"
                        placeholder="Enter Date"
                        change="handleChange"
                        enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }"
                        class="sapUiSmallMarginBottom"/>
                <Label text="{i18n>VolTreshold}" required="true"/>
                <MultiInput valueHelpOnly="true" valueHelpRequest=".onVolumeTreshhold" tokens="{fastAppData>DiscountConditions}" enabled="{= ${fastAppData>/EditMode} &amp;&amp; ${fastAppData>/RappelRequired} }">
                    <tokens>
                        <Token key="{fastAppData>Volume}" text="{fastAppData>Volume}" editable="false"></Token>
                    </tokens>
                </MultiInput>
            </form:content>
        </form:SimpleForm>
    </Panel>
</core:FragmentDefinition>