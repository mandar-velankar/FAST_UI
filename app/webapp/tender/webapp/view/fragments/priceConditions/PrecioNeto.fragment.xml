<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:l="sap.ui.layout" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <form:SimpleForm
            title="Precio Neto"
            editable="false"
            class="editableForm"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="4"
            emptySpanL="4"
            emptySpanM="4"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="false" >
            <form:content>
                <Label text="{i18n>PVL}" required="true"/>
                <Input  
                    value="{= !${fastAppData>/EditMode} 
                        ? ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>PriceConditionPVL'},
                            {value: 6},
                            {path:'fastAppData>PriceConditionClassificationID'},
                            {path:'fastAppData>/ExistingAgreementInPlace'},
                            {path:'fastAppData>Conversion'}
                        ],
                        formatter: '.formatter.formatUoMPrice'}
                        : ${parts: [
                                {path:'fastAppData>ProductCode'},
                                {path:'fastAppData>/ProductPricingView'},
                                {path:'fastAppData>PVL'},
                                {value: 6}
                            ],
                            formatter: '.formatter.formatUoMCurrentPrice'}
                        }"
                    description="{fastAppData>masterPriceCurrency}" 
                    enabled="false" 
                    fieldWidth="80%"
                />
                <Label text="{i18n>ConfidentialPrice}" required="true" visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}"/>
                <Input 
                    value="{= !${fastAppData>/EditMode}
                        ? ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>ConfidentialPrice'},
                            {value: 6},
                            {path:'fastAppData>PriceConditionClassificationID'},
                            {path:'fastAppData>/ExistingAgreementInPlace'},
                            {path:'fastAppData>Conversion'}
                        ],
                        formatter: '.formatter.formatUoMPrice'}
                        : ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>YLAP'},
                            {value: 6}
                        ],
                        formatter: '.formatter.formatUoMCurrentPrice'}
                        }"
                    visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}" 
                    description="{fastAppData>masterPriceCurrency}" 
                    enabled="false" 
                    fieldWidth="80%"
                />  
                <Label text="{i18n>RoyalDecreeApplies}" required="true"/> 
                <Select selectedKey="{= ${fastAppData>RoyalDecree} ? ${fastAppData>RoyalDecree} : 'No'}" enabled="false"> 
                    <items>
                        <core:Item key="No" text="No" />
                        <core:Item key="Yes" text="Yes" />
                    </items>
                </Select>
                <!--<Select selectedKey="{fastAppData>RoyalDecree}" enabled="false" change=".calculateDiscountsAndNetPricesPrecioNeto"> 
                    <items>
                        <core:Item key="" text="" />
                        <core:Item key="IncludeInPrecioNeto" text="Yes, (include in precio neto)" />
                        <core:Item key="ExcludeInPrecioNeto" text="Yes, (exclude in precio neto)" />
                        <core:Item key="No" text="No" />									
                    </items>
                </Select>-->
                <Label text="{i18n>StandardDiscount}" required="true"/>
                <Input value="{path:'fastAppData>StandardDiscount', type:'.types.percent'}" description="%" enabled="false" fieldWidth="80%"/>
                <Label text="{i18n>AdditionalDiscount}" required="true"/>
                <Input 
                    value="{path:'fastAppData>AdditionalDiscount', type:'.types.percent'}" 
                    description="%" 
                    enabled="false" 
                    fieldWidth="80%"
                />
                <Label text="{i18n>RoyalDecree}" required="true" visible="true" />
                <Input 
                    value="{path:'fastAppData>RoyalDecreePercentage', type:'.types.percent'}" 
                    description="%" 
                    enabled="false" 
                    fieldWidth="80%"
                    visible="{= ${fastAppData>RoyalDecree} === 'Yes'}"
                />
                <Label text="{i18n>NetPriceBeforeRC}" required="true"/>
                <Input 
                    fieldGroupIds="priceInputPrecioNeto"
                    value="{path:'fastAppData>NetPriceWithoutTaxBeforeDeductionRD', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 6, minFractionDigits: 6, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.' }}" 
                    enabled="{= ${fastAppData>/EditMode} &amp;&amp; !${fastAppData>/ExistingAgreementInPlace}}" 
                    description="{fastAppData>masterPriceCurrency}"
                    fieldWidth="60%" 
                    liveChange=".onLiveChangeNetPricesPrecioNeto"
                />
                <CheckBox text="{i18n>royalDecreeIncl}" enabled="{= ${fastAppData>/EditMode} &amp;&amp; !${fastAppData>/ExistingAgreementInPlace}}" visible="{= ${fastAppData>RoyalDecree} === 'Yes'}" selected="{fastAppData>RoyalDecreeIncl}" select=".onLiveChangeNetPricesPrecioNeto"/>
                <Label text="{i18n>RoyalDecreeValue}" required="false" />
                <Input 
                    value="{path:'fastAppData>RoyalDecreeValue', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 6, minFractionDigits: 6, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.'}}" 
                    enabled="false" 
                    description="{fastAppData>masterPriceCurrency}"
                    fieldWidth="80%"
                    visible="{= ${fastAppData>RoyalDecree} === 'Yes'}"
                />
                <Label text="{i18n>NetPriceAfterRC}" required="true"/>
                <Input 
                    value="{path:'fastAppData>NetPriceWithoutTaxAfterDeductionRD', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 6, minFractionDigits: 6, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.'}}" 
                    enabled="false" 
                    description="{fastAppData>masterPriceCurrency}"
                    fieldWidth="80%"
                    visible="{= ${fastAppData>RoyalDecree} === 'Yes'}"
                />
                <Label text="{i18n>MaximumPrice}" required="true"/>
                <Input fieldGroupIds="priceInputPrecioNeto" value="{path:'fastAppData>MaximumPrice', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 6, minFractionDigits: 6, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.' }}" enabled="false" description="{fastAppData>masterPriceCurrency}" fieldWidth="80%" liveChange=".validateMaximumPrice" visible="{= ${fastAppData>/Tender/Classification} === 'Tender'}"/>
                <Label text="{i18n>Tax}" required="true"/>
                <Input value="{path:'fastAppData>Tax', type:'.types.percent'}" description="%" enabled="false" fieldWidth="80%"/>
                <Label text="{i18n>NetPriceWtax}" required="true"/>
                <Input value="{path:'fastAppData>NetPriceWithTaxAfterDeductionRD', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 6, minFractionDigits: 6, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.'}}" enabled="false" description="{fastAppData>masterPriceCurrency}" fieldWidth="80%"/>
            </form:content>
        </form:SimpleForm>

</core:FragmentDefinition>