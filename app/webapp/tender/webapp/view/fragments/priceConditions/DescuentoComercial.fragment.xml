<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:l="sap.ui.layout" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <form:SimpleForm
        title="Descuento Comercial"
        editable="false"
        class="editableForm"
        layout="ResponsiveGridLayout"
        labelSpanXL="3"
        labelSpanL="3"
        labelSpanM="3"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="4"
        emptySpanL="4"
        emptySpanM="4"
        emptySpanS="0"
        columnsXL="1"
        columnsL="1"
        columnsM="1"
        singleContainerFullSize="false" >
        <form:content>
            <Label text="{i18n>PVL}" required="true"/>
            <Input 
                value="{
                    parts: [
                        {path:'fastAppData>/ProductPricingView/0/UOM'},
                        {path:'fastAppData>/ProductPricingView/0/PACKFACTOR'},
                        {path:'fastAppData>PVL'}
                    ],
                    formatter: '.formatter.formatUoMPrice'
                }"
                description="{fastAppData>Currency}" 
                enabled="false" 
                fieldWidth="80%"
            />
            <Label text="{i18n>ConfidentialPrice}" required="true" visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}"/>
            <Input 
                value="{
                    parts: [
                        {path:'fastAppData>/ProductPricingView/0/UOM'},
                        {path:'fastAppData>/ProductPricingView/0/PACKFACTOR'},
                        {path:'fastAppData>YLAP'}
                    ],
                    formatter: '.formatter.formatUoMPrice'
                }"
                visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}" 
                description="{fastAppData>Currency}" 
                enabled="false" 
                fieldWidth="80%"
            />
            <Label text="{i18n>Discount}" required="true"/>
            <Input value="{path:'fastAppData>Discount', type:'.types.percent'}" enabled="{fastAppData>/EditMode}" description="%" fieldWidth="80%" liveChange=".calculateNetPricesDescuentoComercial"/>
            <Label text="{i18n>RoyalDecree}" required="true"/> 
            <Select selectedKey="{fastAppData>RoyalDecree}" enabled="{fastAppData>/EditMode}" change=".calculateNetPricesDescuentoComercial"> 
                <items>
                    <core:Item key="" text="" />
                    <core:Item key="Yes" text="Yes" />
                    <core:Item key="No" text="No" />									
                </items>
            </Select>
            <Label text="{i18n>NetPriceWOtax}" required="true"/>
            <Input value="{path:'fastAppData>NetPriceWithoutTax', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2, minFractionDigits: 2, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.' }}" enabled="false" fieldWidth="80%"/>    
            <Label text="{i18n>Tax}" required="true"/>
            <Input value="{path:'fastAppData>Tax', type:'.types.percent'}" description="%" enabled="false" fieldWidth="80%"/>
            <Label text="{i18n>NetPriceWtax}" required="true"/>
            <Input value="{path:'fastAppData>NetPriceWithTax', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2, minFractionDigits: 2, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.' }}" enabled="false" fieldWidth="80%"/>
        </form:content>
    </form:SimpleForm>
</core:FragmentDefinition>