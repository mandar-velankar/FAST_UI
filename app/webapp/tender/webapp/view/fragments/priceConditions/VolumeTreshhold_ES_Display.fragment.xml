<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core">

	<Dialog title="Volume Treshhold" >
        <buttons>
            <Button text="{i18n>Cancel}" press=".onCancelDiscountCondition"/>
		</buttons>
        <Table id="idVolumeTresholdDisplay" items="{path:'fastAppData>PriceCondition/DiscountCondition/results'}">
            <columns>
                <Column>
                    <Text text="Volume"/>
                </Column>
                <Column>
                    <Text text="Discount"/>
                </Column>
                <Column>
                    <Text text="Tax"/>
                </Column>
                <Column>
                    <Text text="Net Price w/o Tax"/>
                </Column>    
                <Column>
                    <Text text="Net Price with Tax"/>
                </Column>             
            </columns>
            <ColumnListItem>
                <cells>
                    <HBox>
                        <Text text=">=" wrapping="false" class="sapUiSmallMarginTop"/>
                        <Input value="{fastAppData>Volume}" type="Number" fieldWidth="80%" enabled="false"/>
                    </HBox>
                    <Input value="{fastAppData>Discount}" type="Number" description="%" fieldWidth="80%" enabled="false"/>
                    <Input value="{path:'fastAppData>Tax', type:'.types.percent'}" type="Number"  description="%" enabled="false" fieldWidth="80%"/>
                    <Input value="{path:'fastAppData>NetPriceWithoutTax', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2, minFractionDigits: 2}}" type="Number" enabled="false" fieldWidth="80%"/>
                    <Input value="{path:'fastAppData>NetPriceWithTax', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2, minFractionDigits: 2}}" type="Number" enabled="false" fieldWidth="80%"/>
                </cells>
            </ColumnListItem>
        </Table>
   	</Dialog>	
</core:FragmentDefinition>