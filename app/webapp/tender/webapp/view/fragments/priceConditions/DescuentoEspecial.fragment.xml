<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:l="sap.ui.layout" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <form:SimpleForm 
        title="Descuento Especial"
        editable="false"
        class="editableForm"
        layout="ResponsiveGridLayout"
        labelSpanXL="3"
        labelSpanL="3"
        labelSpanM="3"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="4"
        emptySpanL="4"
        emptySpanM="4"
        emptySpanS="0"
        columnsXL="1"
        columnsL="1"
        columnsM="1"
        singleContainerFullSize="false" >
        <form:content>
            <Label text="{i18n>PVL}" required="true"/>
            <Input 
                value="{= !${fastAppData>/EditMode} 
                        ? ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>PriceConditionPVL'},
                            {value: 2},
                            {path: 'fastAppData>ExistingPriceConditionID'},
                            {path: 'fastAppData>ReferencePriceAgreement'}
                        ],
                        formatter: '.formatter.formatUoMPrice'}
                        : ${parts: [
                                {path:'fastAppData>ProductCode'},
                                {path:'fastAppData>/ProductPricingView'},
                                {path:'fastAppData>PVL'},
                                {value: 2}
                            ],
                            formatter: '.formatter.formatUoMPrice'}
                        }"
                description="{fastAppData>masterPriceCurrency}" 
                enabled="false" 
                fieldWidth="80%"
            />
            <Label text="{i18n>ConfidentialPrice}" required="true" visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}"/>
            <Input 
                value="{= !${fastAppData>/EditMode}
                        ? ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>ConfidentialPrice'},
                            {value: 2},
                            {path: 'fastAppData>ExistingPriceConditionID'},
                            {path: 'fastAppData>ReferencePriceAgreement'}
                        ],
                        formatter: '.formatter.formatUoMPrice'}
                        : ${parts: [
                            {path:'fastAppData>ProductCode'},
                            {path:'fastAppData>/ProductPricingView'},
                            {path:'fastAppData>YLAP'},
                            {value: 2}
                        ],
                        formatter: '.formatter.formatUoMPrice'}
                        }" 
                visible="{= ${fastAppData>/Tender/Institute/InstituteType} !== 'Private Account'}" 
                description="{fastAppData>masterPriceCurrency}" 
                enabled="false" 
                fieldWidth="80%"
            />
            <Label text="{i18n>Discount}" required="true"/>
            <Input value="{path:'fastAppData>Discount', type:'.types.percent'}" description="%" enabled="false" fieldWidth="80%"/>
            <Label text="{i18n>NetPriceWOtax}" required="true"/>
            <Input value="{= ${fastAppData>NetPriceWithoutTax} ? ${path:'fastAppData>NetPriceWithoutTax', type:'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 2, minFractionDigits: 2, groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.'}} : Number(0).toFixed(2)}" type="Number" description="{fastAppData>masterPriceCurrency}" enabled="false" fieldWidth="80%"/>
        </form:content>
    </form:SimpleForm>
</core:FragmentDefinition>