<core:FragmentDefinition controllerName="FAST_NS0FAST0.controller.OfferProducts" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form" xmlns:t="sap.ui.table" xmlns:u="sap.uxap" xmlns:l="sap.ui.layout">
	
	<!--<u:ObjectPageSubSection id="OfferProdNoOfferSubsection" title="{i18n>OfferProducts}">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<VBox>
						<FormattedText htmlText="Offer not available for offer products..."/>
					</VBox>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>-->
	
	<!-- TENDER OFFER -->
	<u:ObjectPageSubSection title="{i18n>tendrofr}" mode="Expanded">
		<u:actions>
			<Button text="Delete Offer" icon="sap-icon://delete" press="onDeleteProductOffer" enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>
			<Button text="New Offer" icon="sap-icon://add" press="onCreateProductOffer"/>
			<Button text="Revised Offer" icon="sap-icon://add" press="onReviewProductOffer" enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>
			<Button text="Continued Offer" icon="sap-icon://add" press="onContinuedProductOffer" enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>	
			<Button text="Duplicate Offer" icon="sap-icon://duplicate" press="onDuplicateOffer" enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}" visible="{= ${fastAppData>/Tender/CountryCode} === 'AR' }" />
			<Button text="Send Notification" icon="sap-icon://email" press=".onSendNotification"  visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }" />	<!-- TODO: Change this to ES -->
		</u:actions>
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell>
					<!--<VBox>-->
					
						<!-- Panel for offers so, we can hide the table 
						<Panel id="panelProductOfferTableID" expandable="true" width="auto" class="sapUiResponsiveMargin" expanded="false" expand="onExpandOfferTable" expandAnimation="false">
							

							<headerToolbar>
								<OverflowToolbar height="3rem">
									<Title level="H3" text="Offers"/>
								</OverflowToolbar>
							</headerToolbar>
							
							

							<content>

								<Table id="productOffersTableViewID" 
								       items="{ 
								    	path: 'fastAppData>/Tender/Offer/results',
								    	sorter: [
								    		{path: 'TenderOfferNo', descending: true},
								    		{path: 'RevisedOfferNo', descending: true}
								    	],
								    	filters: [
								    		{ path : 'Active', operator : 'EQ', value1 : '1'}, 
								    		{ path : 'ActiveOffer', operator : 'EQ', value1 : '1'}
								    	]}"  
								       inset="false"
									   class="sapFDynamicPageAlignContent" 
									   width="auto"
									   updateFinished="onProductOffersTableViewFinished"
									   > 
									   
									<columns>
										<Column id="productOffersTableOfferID" width="14rem">
											<Text text="{i18n>ofrid}"/>
										</Column>
										<Column>
											<Text text="{i18n>distbtr}"/>
										</Column>
										<Column width="6rem">
											<Text text="{i18n>ofrdte}"/>
										</Column>
										<Column width="10rem">
											<Text text="{i18n>OfferStatus}"/>
										</Column>
									</columns>
									
									<items>
										<ColumnListItem type="Navigation" press=".onProductOfferItemPress" >  
											<cells>
												
												<ObjectIdentifier title="{fastAppData>OfferID}"/>
												<Text text="{fastAppData>Distributor/DistributorName}"/>
												<Text text="{path :'fastAppData>OfferStatus/Date',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}"/>
												<Text text="{fastAppData>OfferStatus/STATUS}"/>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
								
								
							</content>
							
						</Panel>
						-->	
						
						<!-- FORM WITH OFFER DATA -->
						<form:SimpleForm id="offerDetailForm" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout"  labelSpanL="12" labelSpanM="12"
								emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="false">
								<form:content>
									<core:Title/>
									<Label text="{i18n>didtrbtrnme}" required="true"/>
									<Text id="idDist" text="{fastAppData>Distributor/DistributorName}" visible="{= ${fastAppData>Distributor/DistributorName} === 'No Distributor' ? false : true}"/>
									<Label text="{i18n>selncmpny}"  required="true"/>
									<Text text="{fastAppData>SellingCompanyDetails/LegalEntityName}"/>
                                    <Label text="{i18n>offerNumber}"  visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? true : false}"/>
									<Text text="{fastAppData>/SelectedOfferID}" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? true : false}"/>
									<core:Title/>
									<Label text="{i18n>intrnlduedte}" required="{= ${fastAppData>/Tender/CountryCode} === 'ES' ? false : true}"/>
									<!--<Text text="{path :'fastAppData>InternalBidDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}"/>-->
									<Text text="{path :'fastAppData>InternalBidDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>
									
									<Label text="{i18n>ofrduedte}"/>
									<!--<Text text="{path :'fastAppData>Tender/BidDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}"/>-->
									<Text text="{path :'fastData>BidDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>
									
									<core:Title/>
									<Label text="{i18n>whlseofr}" required="true"/>
									<Select selectedKey="{fastAppData>WholesaleOffer}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH' || ${fastAppData>/Tender/CountryCode} === 'AR' || ${fastAppData>/Tender/CountryCode} === 'CL' || ${fastAppData>/Tender/CountryCode} === 'IT'? false : true}">
										<items>
											<core:Item text="No" key="No"/>
											<core:Item text="Yes" key="Yes"/>
										</items>
									</Select>
									<Label text="{i18n>newOfferDate}" required="true" visible="{= ((${fastAppData>RevisedOfferNo} &amp;&amp; ${fastAppData>RevisedOfferNo} !== 0) || (${fastAppData>ContinuationOfferNo} &amp;&amp; ${fastAppData>ContinuationOfferNo} !== 0)) ? true : false }"/>
									<!--<Text text="{path :'fastAppData>NewOfferDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" visible="{= (${fastAppData>RevisedOfferNo} === 0 &amp;&amp; ${fastAppData>ContinuationOfferNo} === 0) ? false : true }" />-->
									<Text text="{path :'fastAppData>NewOfferDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" visible="{= ((${fastAppData>RevisedOfferNo} &amp;&amp; ${fastAppData>RevisedOfferNo} !== 0) || (${fastAppData>ContinuationOfferNo} &amp;&amp; ${fastAppData>ContinuationOfferNo} !== 0)) ? true : false }" />
									
									<Label text="{i18n>Division}" required="true"/>
									<Select selectedKey="{fastAppData>Division}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? false : true}">
										<items>
											<core:Item text="" key=""/>
											<core:Item text="Pharma" key="Pharma"/>
											<core:Item text="Radiology" key="Radiology"/>
										</items>
									</Select>
                                    <!-- Spain only -->
                                    <Label text="{i18n>Division}" required="true"/>
                                    <Select selectedKey="{fastAppData>Division}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'? true : false}">
										<items>
											<core:Item text="" key=""/>
											<core:Item text="Pharma" key="Pharma"/>
											<core:Item text="Radiology" key="Radiology"/>
                                            <core:Item text="Consumer Health" key="Consumer Health"/>
										</items>
									</Select>
							</form:content>
						</form:SimpleForm>
					
					<!--</VBox>-->
					
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	
	<!-- PRODUCT INFO -->
	<u:ObjectPageSubSection title="{i18n>prodinfo}">
		<u:blocks>
			<t:Table enableColumnReordering="false" 
				     id="offerProductId" 
				     selectionMode="Single" 
				     selectionBehavior="RowOnly" 
				     visibleRowCount="25"
					 alternateRowColors="true" 
					 editable="true" 
					 enableCellFilter="true" 
					 width="100%"
					 noData="There are no products for this offer..."
					 >
				<t:columns>
					<t:Column width="16rem" visible="{fastAppData>/permissions/tables/editofferProductId/Line/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Line/description',
									   formatter: '.formatter.offerProductsColumnName' }"
							   wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>Line}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="16rem" visible="{fastAppData>/permissions/tables/editofferProductId/Product/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Product/description',
									   formatter: '.formatter.offerProductsColumnName' }" 
							   wrapping="true"/>
						<t:template>
							<VBox>
								<Text text="{fastAppData>SKU/Product/HLEVEL6_NAME}" wrapping="true" visible="{fastAppData>/permissions/tables/editofferProductId/Package/visible}" />
								<Text text="{fastAppData>SKU/PRODUCTPACKNAME}" wrapping="true" visible="{= !${fastAppData>/permissions/tables/editofferProductId/Package/visible} }" />
							</VBox>
						</t:template>
					</t:Column>

					<t:Column width="100px" visible="{fastAppData>/permissions/tables/editofferProductId/PackFactor/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/PackFactor/description',
															formatter: '.formatter.offerProductsColumnName' }" 
														wrapping="true" />
						<t:template>
							<VBox>
								<Input value="{fastAppData>SKU/PACKFACTOR}" editable="false" maxLength="100" visible="{fastAppData>/permissions/tables/editofferProductId/PackFactor/visible}" />
							</VBox>
						</t:template>
					</t:Column>

					<t:Column width="7rem" visible="{fastAppData>/permissions/tables/editofferProductId/OfferType/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/OfferType/description',
							                          		 formatter: '.formatter.offerProductsColumnName' }" 
							   wrapping="true"/>
						<t:template>
							<Select selectedKey="{fastAppData>OfferType}" enabled="false">
								<items>
									<core:Item text="" key=""/>
									<core:Item text="Selling" key="Selling"/>
									<core:Item text="Rental" key="Rental"/>
									<core:Item text="Comodato" key="Comodato"/>
								</items>
								<layoutData>
									<l:GridData span="L6 M6 S6"/>
								</layoutData>
							</Select>
						</t:template>
					</t:Column>
					<t:Column width="7rem" visible="{fastAppData>/permissions/tables/editofferProductId/Reference/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Reference/description',
									   formatter: '.formatter.offerProductsColumnName' }"
							   wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>Reference}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="8rem" visible="{fastAppData>/permissions/tables/editofferProductId/AlternateOfferYN/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/AlternateOfferYN/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>AlternateOfferYN}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="8rem" visible="{fastAppData>/permissions/tables/editofferProductId/Requested/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Requested/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<HBox>
								<Input type="Number" value="{fastAppData>RequestedVolume}" editable="false" enabled="false"/>
								<Button icon="sap-icon://show-edit" press="onPressShowRequestedVolume" visible="{= ${fastAppData>/Tender/GroupPurchasing} === 2 ? true : false}"/>
							</HBox>
						</t:template>
					</t:Column>
					<t:Column width="8rem" visible="{fastAppData>/permissions/tables/editofferProductId/Unitpack/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Unitpack/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>UnitPerPack}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="16rem" visible="{fastAppData>/permissions/tables/editofferProductId/SapNo/visible}" >
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/SapNo/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>SKUCountry/ProductPack/ProductPackSKUs/results/SKUCode}" wrapping="true" />
						</t:template>
					</t:Column>

					<t:Column width="16rem" visible="{fastAppData>/permissions/tables/editofferProductId/CodeNational/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/CodeNational/description',
										formatter: '.formatter.offerProductsColumnName' }"
								wrapping="true"  />
						<t:template>
							<Text text="{fastAppData>SKUCountry/GOV_CODE}" wrapping="true" />
						</t:template>
					</t:Column>

					<t:Column width="10rem" visible="{fastAppData>/permissions/tables/editofferProductId/AicCnd/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/AicCnd/description',
										formatter: '.formatter.offerProductsColumnName' }"
								wrapping="true" />
						<t:template>
							<Text text="{fastAppData>SKUCountry/CODE1}" wrapping="true"/>
						</t:template>
					</t:Column>

					<t:Column width="10rem" visible="{fastAppData>/permissions/tables/editofferProductId/AtcRdm/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/AtcRdm/description',
										formatter: '.formatter.offerProductsColumnName' }"
								wrapping="true" />
						<t:template>
							<Text text="{fastAppData>SKUCountry/CODE2}" wrapping="true"/>
						</t:template>
					</t:Column>

					<t:Column width="16rem" visible="{fastAppData>/permissions/tables/editofferProductId/Package/visible}" >
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Package/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>SKU/PRODUCTPACKNAME}" wrapping="true" />
						</t:template>
					</t:Column>
					<t:Column width="7rem" visible="{fastAppData>/permissions/tables/editofferProductId/Sample/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Sample/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>SampleYN}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="7rem" visible="{fastAppData>/permissions/tables/editofferProductId/Quantity/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Quantity/description',
											       formatter: '.formatter.offerProductsColumnName' }"  wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>SampleQuantity}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="8rem" visible="{fastAppData>/permissions/tables/editofferProductId/Documents/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Documents/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>DocumentsRequired}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="8rem" visible="{fastAppData>/permissions/tables/editofferProductId/FirstShipment/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/FirstShipment/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>FirstShipment}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="8rem" visible="{fastAppData>/permissions/tables/editofferProductId/NoLots/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/NoLots/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>NoofLots}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="8rem" visible="{fastAppData>/permissions/tables/editofferProductId/IntervalBetweenShipments/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/IntervalBetweenShipments/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>IntervalBetweenShipments}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="12rem" visible="{fastAppData>/permissions/tables/editofferProductId/PaymentTerms/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/PaymentTerms/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>PaymentTerms}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="15rem" visible="{fastAppData>/permissions/tables/editofferProductId/INCOTerms/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/INCOTerms/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>INCOTerms}" wrapping="true"/>
						</t:template>
					</t:Column>
					<t:Column width="200px" visible="{fastAppData>/permissions/tables/editofferProductId/Decline/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Decline/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Select selectedKey="{fastAppData>ActiveProduct}" enabled="false">
									<items>
										<core:Item text="Product Included" key="1"/>
										<core:Item text="Product Declined" key="2"/>
									</items>
									<layoutData>
										<l:GridData span="L6 M6 S6"/>
									</layoutData>
							</Select>
						</t:template>
					</t:Column>
					<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/Comment/visible}" >
							<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Comment/description',
										   formatter: '.formatter.offerProductsColumnName' }" wrapping="true" />
							<t:template>
								<Input type="Text" value="{fastAppData>Comment}" placeholder="{i18n>Comment}" editable="false"/>
							</t:template>
					</t:Column>

					<t:Column width="200px" visible="{fastAppData>/permissions/tables/editofferProductId/MinInvoiceAmount/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/MinInvoiceAmount/description',
									   formatter: '.formatter.offerProductsColumnName' }"	   
								wrapping="true"/>
						<t:template>
							<Input type="Text" value="{fastAppData>MinInvoiceAmount}" placeholder="{i18n>minInvoiceAmount}" editable="false"/>
						</t:template>
					</t:Column>

					<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/Brand/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/Brand/description',
									   formatter: '.formatter.offerProductsColumnName' }" 
							   wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>SKU/Product/HLEVEL4_NAME}" />
						</t:template>
					</t:Column>

					<t:Column width="15rem" visible="{fastAppData>/permissions/tables/editofferProductId/MoleculeName/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/MoleculeName/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>SKU/MoleculeName}" />
						</t:template>
					</t:Column>

					<t:Column width="15rem" visible="{fastAppData>/permissions/tables/editofferProductId/DeliveryConditions/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/DeliveryConditions/description',
									   formatter: '.formatter.offerProductsColumnName' }" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>DeliveryConditions}" />
						</t:template>
					</t:Column>

					<t:Column width="300px" visible="{fastAppData>/permissions/tables/editofferProductId/PricingPolicyCluster/visible}">
						<Label text="{ path: 'fastAppData>/permissions/tables/editofferProductId/PricingPolicyCluster/description',
									   formatter: '.formatter.offerProductsColumnName' }"	   
							   wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>PricingPolicyCluster}"/>
						</t:template>
					</t:Column>

					<t:Column width="150px" visible="{= ${fastAppData>/Tender/CountryCode} === 'IT' || ${fastAppData>/Tender/CountryCode} === 'ES'}">
						<Label text="Price Agreement" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>OtherPriceAgreementsExist}"/>
						</t:template>
					</t:Column>

                    <t:Column width="300px" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }">
						<Label text="Anticipated or Requested" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>AnticipatedRequestedQuantity}"/>
						</t:template>
					</t:Column>

                    <t:Column width="150px" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }">
						<Label text="{i18n>bu}" wrapping="true"/>
						<t:template>
							<Text text="{fastAppData>SKUCountry/BU}"/>
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</u:blocks>
	</u:ObjectPageSubSection>

    
</core:FragmentDefinition>