<core:FragmentDefinition controllerName="FAST_NS0FAST0.controller.Detail" 
    xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <!-- QUOTATION TAB -->        
        <!-- TENDER OFFER TABLE -->
        <ObjectPageSubSection id="QuotationNoOfferSubsection" title="{i18n>Quotation}">
            <l:BlockLayout background="Light">
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
                        <m:VBox>
                            <m:FormattedText htmlText="Offer not available for quotation..."/>
                        </m:VBox>
                    </l:BlockLayoutCell>
                </l:BlockLayoutRow>
            </l:BlockLayout>
        </ObjectPageSubSection>
        
        <ObjectPageSubSection id="QuotationOfferSubsection" title="{i18n>Quotation}">
            <actions>
                <!-- DelayInSubmission -->	
                <m:Switch 
                    id="idDelayInSubmission" 
                    customTextOn="Yes" 
                    customTextOff="No" 
                    state="{= ${fastData>Quotation/DelayInSubmission} === 'Yes' ? true : false}" 
                    enabled="{= ${fastAppData>/SelectedOfferID} !== '' &amp;&amp; ${fastData>OfferStatus/STATUS} === 'Quotation Submitted' ? true : false}"
                    change="onSwitchDelayInSubmission" />
                
                <!-- Download Quotation -->	
                <m:Button
                    id="btnSaveQuotation"
                    text="{i18n>SaveQuotation}"
                    icon="sap-icon://save"
                    press=".onSaveDefaultQuotation"
                    enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>
                                            
                <m:Button
                    id="btnDownloadQuotation"
                    text="{i18n>DownloadQuotation}"
                    icon="sap-icon://download"
                    press=".onDownloadQuotation"
                    enabled="{= ${fastAppData>/SelectedOfferID} === '' ? false : true}"/>

                <!-- Bank Guarantee
                <m:Button
                    id="btnCreateBankGuarantee"
                    text="{= ${fastAppData>/newBankGuarantee/Status} ? ${i18n>EditGuarantee} : ${i18n>CreateGuarantee} }"
                    icon="sap-icon://create-form"
                    press=".onCreateGuarantee"
                    enabled="{= ${fastAppData>/newBankGuarantee/Status} !== 'Confirmed' &amp;&amp; ${fastAppData>/newBankGuarantee/Status} !== 'Expired' ? true : false }"/>-->	

                <!-- Submit Quotation -->	
                <m:Button
                    id="btnSubmitQuotation"
                    text="{i18n>SubmitQuotation}"
                    icon="sap-icon://sys-enter"
                    press=".onSubmitQuotation"
                    enabled="false"/>

            </actions>
            <l:BlockLayout background="Light">
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell><!--</l:BlockLayoutCell> backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">-->
                        <m:VBox>                            
                            <m:Label/>
                    
                    <form:SimpleForm id="IdQuotationInfo" editable="false" maxContainerCols="3" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
                        emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="true">
                        <form:content>
                            
                            <m:VBox fitContainer="true" alignItems="Stretch">
                                <m:items>
                                    <m:HBox>
                                        <m:items>
                                            <!-- Offer Party -->
                                            <m:VBox width="50%">
                                                <m:items>
                                                    <m:HBox width="50%">
                                                        <m:items>
                                                            <m:Label text="{i18n>OfferParty}" width="6rem" design="Bold"/>
                                                            <m:Text text="{fastAppData>/OfferValidation/DISTRIBUTORNAME}"/>
                                                        </m:items>
                                                    </m:HBox>
                                                    <m:HBox width="50%">
                                                        <m:items>
                                                            <m:Label text="{i18n>Address}" width="6rem"  design="Bold" visible="true"/>
                                                            <m:VBox width="40rem" >
                                                                <m:items>
                                                                    <!-- Address -->
                                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/DISTRIBUTORADDRESS}" width="10rem" class="sapMText" visible="true"/>
                                                                    
                                                                    <!-- Tel-->
                                                                    <m:HBox width="40rem" visible="true">
                                                                        <m:items>
                                                                            <m:Label text="{i18n>ContactNo}" class="sapUiSmallMarginEnd" design="Bold"/>
                                                                            <m:Text text="{fastAppData>/OfferValidation/DISTRIBUTORPHONE}"/>
                                                                        </m:items>
                                                                    </m:HBox>
                                                                    
                                                                    <!-- Fax -->
                                                                    <m:HBox width="40rem" visible="true">
                                                                        <m:items>
                                                                            <m:Label text="{i18n>ContactFax}" class="sapUiSmallMarginEnd" design="Bold"/>
                                                                            <m:Text text="{fastAppData>/OfferValidation/DISTRIBUTORFAX}"/>
                                                                        </m:items>
                                                                    </m:HBox>
                                                                </m:items>
                                                            </m:VBox>
                                                        </m:items>
                                                    </m:HBox>
                                                    <m:HBox width="50%" visible="true">
                                                        <m:items>
                                                            <m:Label text="{i18n>Contact}" width="6rem" design="Bold" visible="true"/>
                                                            <m:Text text="{fastAppData>/OfferValidation/DISTRIBUTORCONTACT}" visible="true"/>
                                                        </m:items>
                                                    </m:HBox>
                                                </m:items>
                                            </m:VBox>
                                            <m:VBox width="50%" alignItems="End">
                                                <m:HBox>
                                                    <m:items>
                                                            <f:Avatar src="{imageModel>/path}/Company-Logo-Blue.svg" displaySize="M" displayShape="Square" class="sapUiTinyMarginEnd"/>
                                                            <m:FormattedText htmlText="{fastAppData>/OfferValidation/LETTERHEAD}" class="sapMText"/>
                                                    </m:items>
                                                </m:HBox>
                                            </m:VBox>
                                        </m:items>
                                    </m:HBox>
                                    <m:Toolbar width="100%" height="1px"/>
                                    <!-- 4th row -->
                                    <m:HBox class="sapUiSmallMarginBottom">
                                        <m:items>
                                            <m:VBox width="73%">
                                                <m:items>
                                                    <m:HBox>
                                                        <m:items>
                                                            <!-- N° Invoice -->
                                                            <m:VBox width="20%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>InvoiceNo}" design="Bold"/>
                                                                    <m:Text text="{fastAppData>/OfferValidation/OFFERID}"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>
                                                            <!-- Tender refrence -->
                                                            <m:VBox width="28%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>TenderRef}" design="Bold"/>
                                                                    <m:Text text="{fastAppData>/OfferValidation/TENDER_REFERENCE}"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>
                                                            <!-- Offer Date -->
                                                            <m:VBox width="13%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>OfferDate}" design="Bold"/>
                                                                    <!--<m:DatePicker id="idQofferDate" value="{path :'fastAppData>/OfferValidation/OFFERDATE',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" enabled="false"/>-->
                                                                    <m:DatePicker id="idQofferDate" value="{path :'fastAppData>/OfferValidation/OFFERDATE', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>
                                                            <!-- Offer Validity -->
                                                            <m:VBox width="13%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>OfferValidity}" design="Bold"/>
                                                                    <!--<m:DatePicker id="idQofferValidity" value="{path :'fastAppData>/OfferValidation/OFFERVALIDITY',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" enabled="false"/>-->
                                                                    <m:DatePicker id="idQofferValidity" value="{path :'fastAppData>/OfferValidation/OFFERVALIDITY', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>
                                                            <!--Selling Company-->
                                                            <m:VBox width="18%" visible="true">
                                                                <m:items>
                                                                    <m:Label text="{i18n>selncmpny}" width="10rem" design="Bold"/>
                                                                    <m:Text text="{fastAppData>/OfferValidation/SELLINGCOMPANY}"/>
                                                                </m:items>
                                                            </m:VBox>
                                                        </m:items>
                                                    </m:HBox>
                                                    <m:Toolbar width="100%" height="1px"/>
                                                    <m:HBox>
                                                        <m:items>
                                                            <!-- Shipment Terms-->
                                                            <m:VBox width="50rem">
                                                                <m:items>
                                                                    <m:Label text="{i18n>qShipment}" design="Bold"/>
                                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/SHIPMENTTERMS}" class="sapMText"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            
                                                            <!-- Payment Terms -->
                                                            <m:VBox width="50rem">
                                                                <m:items>
                                                                    <m:Label text="{i18n>qPayment}" design="Bold"/>
                                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/PAYMENTTERMS}" class="sapMText"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            
                                                            <!-- Delivery Terms -->
                                                            <m:VBox width="50rem">
                                                                <m:items>
                                                                    <m:Label text="{i18n>qDelivery}" design="Bold"/>
                                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/DELIVERYTERMS}" class="sapMText"/>
                                                                </m:items>
                                                            </m:VBox>
                                                        </m:items>
                                                    </m:HBox>
                                                </m:items>
                                            </m:VBox>
                                            <m:VBox width="2%"/>
                                            <m:VBox width="25%">
                                                <m:items>
                                                    <m:VBox>
                                                        <m:items>
                                                            <m:Label text="{i18n>Bank}" width="10rem" design="Bold" visible="true"/>
                                                            <m:FormattedText htmlText="{fastAppData>/OfferValidation/SELLINGCOMPANYBANK}" class="sapMText" visible="true"/>
                                                        </m:items>
                                                    </m:VBox>
                                                </m:items>
                                            </m:VBox>
                                        </m:items>
                                    </m:HBox>
                                </m:items>
                            </m:VBox>
                            
                        </form:content>
                    </form:SimpleForm>
                </m:VBox>
        
            <!-- Quotation products -->
            <!--<ObjectPageSubSection id="idQuotationLineItems">-->
            <m:Table id="idQuotationTable"
                items="{path : 'fastAppData>/OfferProductValidation/', sorter: [{path: 'SORTER', descending: false}]}"
                inset="false" class="sapFDynamicPageAlignContent" width="auto"
                alternateRowColors="true" fixedLayout="true">
                <m:columns>
                    <!-- Contract ID -->
                    <m:Column width="4%">
                        <m:Text text="{i18n>TenderItemSorter}"/>
                    </m:Column>

                    <!-- SKU Code -->
                    <m:Column width="5%">
                        <m:Text text="{i18n>TenderItemCode}"/>
                    </m:Column>

                    <!-- Article Name -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>BayerProductDescription}"/>
                    </m:Column>

                    <!-- Manufacturer Name -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>ManufacturerName}" visible="true"/>
                    </m:Column>

                    <!-- Origin -->
                    <m:Column width="10%">
                        <m:Text text="{i18n>CountryOfOrigin}"/>
                    </m:Column>

                    <!-- Shelf Life -->
                    <m:Column width="7%" visible="true">
                        <m:Text text="{i18n>ShelfLife}"/>
                    </m:Column>

                    <!-- Pack Factor -->
                    <m:Column width="5%">
                        <m:Text text="{i18n>PackFactor}"/>
                    </m:Column>

                    <!-- Presentation -->
                    <m:Column width="6%">
                        <m:Text text="{i18n>Presentation}" visible="true"/>
                    </m:Column>

                    <!-- Quantity -->
                    <m:Column width="13%">
                        <m:Text text="{i18n>qQuantity}"/>
                    </m:Column>

                    <!-- Unit Price -->
                    <m:Column width="8%">
                        <m:Text text="{i18n>UnitPrice}"/>
                    </m:Column>

                    <!-- Pack Price -->
                    <m:Column width="8%">
                        <m:Text text="{i18n>PackPrice}" visible="true"/>
                    </m:Column>

                    <!-- Total -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>Total}"/>
                    </m:Column>

                </m:columns>
                <m:items>
                    <m:ColumnListItem>
                        <m:cells>
                            <!-- Contract ID -->
                            <m:Text text="{path :'fastAppData>SORTER'}"/>

                            <!-- SKU Code -->
                            <m:Text text="{parts: [{path :'fastAppData>CODE'}], formatter: '.formatter.nullToBlank'}"/>
                            
                            <!-- Article Name -->
                            <m:Text text="{path :'fastAppData>PRODUCTNAME'}"/>
                            
                            <!-- Manufacturer Name -->
                            <m:Text text="{path :'fastAppData>MANUFACTURER'}" visible="true"/>

                            <!-- Origin -->
                            <m:Text text="{path :'fastAppData>COUNTRYOFORIGIN'}"/>

                            <!-- SHelf Life -->
                            <m:Text text="{path :'fastAppData>SHELFLIFE'}"/>

                            <!-- Pack Factor -->
                            <m:Text text="{path :'fastAppData>PACKSIZE'}"/>

                            <!-- Presentation -->
                            <m:Text text="{path :'fastAppData>PRESENTATION'}" visible="true"/>

                            <!-- Quantity -->
                            <m:FormattedText htmlText="{path: 'fastAppData>REQUESTED_QUANTITY'}" class="sapMText"/>

                            <!-- Unit Price -->
                            <m:ObjectStatus
                                text="{parts: [
                                    {path: 'fastAppData>REQ_PRICE_UNIT_OFFER_CURRENCY'}, 
                                    {path: 'fastAppData>CURRENCY'}
                                ], formatter:'.formatter.priceTwoOrFour'}"
                                state="{ parts:[{path:'fastAppData>IS_LOWEST'}], formatter: '.formatter.statusPrice'}"
                            />

                            <!-- Pack Price -->
                            <m:ObjectStatus text="{parts: [ {path: 'fastAppData>REQ_PRICE_PACK_OFFER_CURRENCY'},  {path: 'fastAppData>CURRENCY'} ], formatter:'.formatter.price'}"
                                state="{ parts:[{path:'fastAppData>IS_LOWEST'}], formatter: '.formatter.statusPrice'}"
                                visible="true"
                            />

                            <!-- Total -->
                            <m:Text text="{parts: [
                                {path: 'fastAppData>GROSS_SALES_OFFER_CURRENCY'}, 
                                {path: 'fastAppData>CURRENCY'}
                            ], formatter:'.formatter.price'}"/>

                        </m:cells>
                    </m:ColumnListItem>
                </m:items>
            </m:Table>
                    
                    <form:SimpleForm id="IdQuotationInfo2" editable="false" maxContainerCols="3" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
                        emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="false">
                        <form:content>
                            
                            <m:VBox fitContainer="true" alignItems="Stretch">
                                <m:items>
                                    <m:HBox class="sapUiLargeMarginTop">
                                        <m:items>
                                            
                                            <!-- total amount -->
                                            <m:VBox width="50%">
                                                <m:Label text="{i18n>TotalAmount}" design="Bold"/>
                                            </m:VBox>
                                            <m:VBox width="50%" alignItems="End">
                                                <m:items>
                                                    <m:Text text="{parts: [
                                                        {path: 'fastAppData>/OfferValidation/AMOUNT_IN_NUMBERS'}, 
                                                        {path: 'fastAppData>/OfferValidation/CURRENCY'}
                                                    ], formatter:'.formatter.price'}" class="sapUiSmallMarginEnd"/>	
                                                    <m:Text text="({fastAppData>/OfferValidation/AMOUNT_IN_WORDS})" visible="true"/>
                                                </m:items>
                                            </m:VBox>

                                        </m:items>
                                    </m:HBox>
                                   
                                    <m:Toolbar width="100%" height="1px"/>
                                    <m:HBox visible="true">
                                        <m:items>
                                                
                                            <!-- Remarks -->
                                            <m:VBox class="sapUiSmallMarginEnd" width="50%" >
                                                <m:items>
                                                    <m:Label text="{i18n>qStandardRemark}" design="Bold"/>
                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/REMARKS}" class="sapMText" />
                                                </m:items>
                                            </m:VBox>
                                                    
                                            <!-- Additional remarks -->
                                            <m:VBox class="sapUiSmallMarginEnd" width="50%" alignItems="Start">
                                                <m:items>
                                                    <m:Label text="{i18n>qCustomRemark}" design="Bold"/>
                                                    <m:TextArea id="idCustomRemark" value="{path: 'fastAppData>/OfferValidation/CUSTOM_REMARKS'}" maxLength="500" enabled="false" height="10rem" width="30rem"/>
                                                </m:items>
                                            </m:VBox>									
                                                
                                        </m:items>
                                    </m:HBox>
                                    <m:Toolbar width="100%" height="1px" visible="true"/>	
                                    <m:HBox visible="true">
                                        <m:items>
                                            <!-- Issued by -->
                                            <m:VBox class="sapUiSmallMarginEnd" width="48%">
                                                <m:items>
                                                    <m:Label text="{i18n>qIssuedBy}" design="Bold"/>
                                                    <m:Select id="idSelectIssuedBy" 
                                                        showSecondaryValues="true"
                                                        selectedKey="{fastAppData>/OfferValidation/SELLING_COMPANY_AS1}" 
                                                        enabled="false" 
                                                            items="{ path: 'fastAppData>/EditOffer/Signatories/results'}">
                                                        <core:ListItem text="{fastAppData>NAME}" additionalText="{fastAppData>TITLE}" key="{fastAppData>AUTHORIZED_SIGNATORY}"/>
                                                    </m:Select>
                                                </m:items>
                                            </m:VBox>																
                                            <m:VBox width="4%">
                                            </m:VBox>	
                                            <!-- Company stamp -->
                                            <m:VBox class="sapUiSmallMarginEnd" width="48%" alignItems="Start">
                                                <m:items>
                                                    <m:Label text="{i18n>qCompanyStamp}" design="Bold"/>
                                                    <m:Select id="idSelectCompanyStamp" 
                                                        showSecondaryValues="true"
                                                        selectedKey="{fastAppData>/OfferValidation/SELLING_COMPANY_AS2}" 
                                                        enabled="false" 
                                                        items="{ path: 'fastAppData>/EditOffer/Signatories/results'}">
                                                            <core:ListItem text="{fastAppData>NAME}" additionalText="{fastAppData>TITLE}" key="{fastAppData>AUTHORIZED_SIGNATORY}"/>
                                                    </m:Select>
                                                </m:items>
                                            </m:VBox>
                                                    
                                        </m:items>
                                    </m:HBox>
                                    
                                    <!-- Creating additional space, so flickering of screen doesn't happen. This happens when content is almost fitting on the screen vs not -->
                                    <!-- these empty boxes solves this problem, since scrollbar is always shown -->
                                    <m:VBox fitContainer="true" height="500px">
                                    </m:VBox>
                                    
                                </m:items>
                            </m:VBox>
                            
                        </form:content>
                    </form:SimpleForm>
                    
                    </l:BlockLayoutCell >
                </l:BlockLayoutRow>
            </l:BlockLayout>
        </ObjectPageSubSection>
</core:FragmentDefinition>