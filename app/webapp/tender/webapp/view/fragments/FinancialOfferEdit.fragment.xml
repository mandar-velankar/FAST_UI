<core:FragmentDefinition controllerName="FAST_NS0FAST0.controller.OfferProducts" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form" xmlns:t="sap.ui.table" xmlns:u="sap.uxap" xmlns:l="sap.ui.layout" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	<u:ObjectPageSubSection title="{i18n>offersum}" mode="Expanded">
		<u:actions>
			<Button text="Scenario Planner" icon="sap-icon://customize" press=".onToggleScenarioPlanner"/>
		</u:actions>
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<VBox>
						<form:SimpleForm id="idEditCurrencyForm" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
							emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="true" title="">
							<Label text="{i18n>Currency}"/>
							<Select id="idEditCurrency" change=".onEditFinancialOffer"></Select>
							<Label text="{i18n>FOC}"/>
							<Select id="idEditFOCType" selectedKey="{fastAppData>/EditOffer/FOCType}">
								<items>
									<core:Item key="FOC 2" text="In addition to requested volume" />
									<core:Item key="FOC 1" text="Part of requested volume" />
								</items>
							</Select>
						</form:SimpleForm>
						
						<!-- Table with products -->
						<Table id="idEditFinancialOfferViewProduct" inset="false" class="sapFDynamicPageAlignContent" width="auto" updateFinished="onBindingItemsFinished" visible="false">
							<columns>
								<Column>
									<Text text="{i18n>Product}"/>
								</Column>
								<Column>
									<Text text="{i18n>Volume}"/>
								</Column>
								<Column>
									<Text text="{i18n>UoM}"/>
								</Column>
								<Column>
									<Text text="{i18n>NetPrice}"/>
								</Column>
								<Column>
									<Text text="{= ${fastAppData>/Tender/CountryCode} === 'TH' ? ${i18n>OfferPrice_TH} : ${i18n>OfferPrice}}"/>
								</Column>
								<Column visible="{= ${access>/tenderAccess/COGS} &amp;&amp; (${fastAppData>/Tender/CountryCode} !== 'CL' || (${fastAppData>/Tender/CountryCode} === 'CL' &amp;&amp; ${fastAppData>/Tender/Institute/InstituteType} === 'Cenabast' ) ? true : false)}">
									<Text text="{i18n>COGS}"/>
								</Column>
								<Column>
									<Text text="{i18n>GrossSales}"/>
								</Column>
								<Column visible="{access>/tenderAccess/COGS}">
									<Text text="{i18n>NetSales}"/>
								</Column>
								<Column visible="{access>/tenderAccess/COGS}">
									<Text text="{i18n>Profitability}"/>
								</Column>
									<!-- EHQUT-197393-MEA – change display in Offer Summary in Financial Offer tab -->
								<Column visible="{= ${access>/tenderAccess/COGS} &amp;&amp; (${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false )}">
									<Text text="{i18n>BudgetedProfitability}" />
								</Column>
								<Column visible="{= ${access>/tenderAccess/COGS} &amp;&amp; (${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false )}">
									<Text text="{i18n>ProfitabilityPercentage}" />
								</Column>
   							<!-- EHQUT-197393-MEA – change display in Offer Summary in Financial Offer tab -->
							</columns>
						</Table>
					</VBox>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	<u:ObjectPageSubSection id="idPricingOffer" title="Pricing Offer">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="2">
					<l:HorizontalLayout>
						<form:SimpleForm id="idEditPriceOffer" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
							emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="true" title=""></form:SimpleForm>
					</l:HorizontalLayout>
				</l:BlockLayoutCell>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="4">
					<Table id="idEditProfitabilityTable" visible="{= ${fastAppData>/Tender/CountryCode} !== 'CL' || (${fastAppData>/Tender/CountryCode} === 'CL' &amp;&amp; ${fastAppData>/Tender/Institute/InstituteType} === 'Cenabast' ) ? true : false}" ></Table>
					<viz:VizFrame id="idEditListToNetChart" uiConfig="{applicationSet:'fiori'}" height='20rem' width="100%" vizType='waterfall'
						vizProperties="{ title: {text : 'List-to-Net', visible : true}}" renderComplete="handleRenderComplete" legendVisible="false"></viz:VizFrame>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	<u:ObjectPageSubSection id="idScenarioPlanner" title="Scenario Planner" visible="false">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<l:Grid hSpacing="2" defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMargin">
						<l:VerticalLayout>
							<Button id="idSelectScenario1" text="Select Scenario 1" press=".onSelectScenario"/>
							<form:SimpleForm id="idEditPriceOfferScenario1" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12"
								labelSpanM="12" emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="false" title="Scenario 1"></form:SimpleForm>
							<Table id="idEditProfitabilityScenario1" alternateRowColors="true" visible="{= ${fastAppData>/Tender/CountryCode} !== 'CL' || (${fastAppData>/Tender/CountryCode} === 'CL' &amp;&amp; ${fastAppData>/Tender/Institute/InstituteType} === 'Cenabast' ) ? true : false}"></Table>
						</l:VerticalLayout>
						<l:VerticalLayout>
							<Button id="idSelectScenario2" text="Select Scenario 2" press=".onSelectScenario"/>
							<form:SimpleForm id="idEditPriceOfferScenario2" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12"
								labelSpanM="12" emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="false" title="Scenario 2"></form:SimpleForm>
							<Table id="idEditProfitabilityScenario2" alternateRowColors="true" visible="{= ${fastAppData>/Tender/CountryCode} !== 'CL' || (${fastAppData>/Tender/CountryCode} === 'CL' &amp;&amp; ${fastAppData>/Tender/Institute/InstituteType} === 'Cenabast' ) ? true : false}"></Table>
						</l:VerticalLayout>
						<l:VerticalLayout>
							<Button id="idSelectScenario3" text="Select Scenario 3" press=".onSelectScenario"/>
							<form:SimpleForm id="idEditPriceOfferScenario3" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12"
								labelSpanM="12" emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="false" title="Scenario 3"></form:SimpleForm>
							<Table id="idEditProfitabilityScenario3" alternateRowColors="true" visible="{= ${fastAppData>/Tender/CountryCode} !== 'CL' || (${fastAppData>/Tender/CountryCode} === 'CL' &amp;&amp; ${fastAppData>/Tender/Institute/InstituteType} === 'Cenabast' ) ? true : false}"></Table>
						</l:VerticalLayout>
					</l:Grid>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	<u:ObjectPageSubSection title="{i18n>offerhistory}">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<Table id="editTenderHistoryId" inset="false">
						<headerToolbar>
							<Toolbar>
								<content>
									<ToolbarSpacer/>
									<CheckBox id="editCurrentCountryCheckId" text="{i18n>CurrentCountry}" selected="true" select=".onHistoryFilterCheck" 
											  visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false }"/>
									<CheckBox id="editCurrentInstituteCheckId" text="{i18n>CurrentInstitute}" selected="true" select=".onHistoryFilterCheck"/>
									<CheckBox id="editParentInstituteCheckId" text="{i18n>ParentInstitute}" selected="false" select=".onHistoryFilterCheck"
											  visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false }"/>
									<CheckBox id="editWonCheckId" text="{i18n>Won}" selected="true" select=".onHistoryFilterCheck"/>
									<CheckBox id="editLossCheckId" text="{i18n>Loss}" selected="false" select=".onHistoryFilterCheck"/>
									<!-- EHQUT-218142-MEA - update the offer history section of the Financial Offer tab to include wholesale price offers and declined offers -->
									<CheckBox id="editwholesaleofferCheckId" text="{i18n>Wholesaleoffer}"  select=".onHistoryFilterCheck"
											  visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false }"/>
									<CheckBox id="editOfferDeclineCheckId" text="{i18n>OfferDeclined}"  select=".onHistoryFilterCheck"
											  visible="{= ${fastAppData>/Tender/Country/Region} === 'MEA' ? true : false }"/>
									<!-- EHQUT-218142-MEA - update the offer history section of the Financial Offer tab to include wholesale price offers and declined offers -->
								</content>
							</Toolbar>
						</headerToolbar>
						<columns>
							<Column>
								<Text text="{i18n>ID}"/>
							</Column>
							<Column>
								<Text text="{i18n>reference}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>OfferID}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>OfferDate}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>InstituteName}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>Product}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>UnitPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>PackPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>NetUnitPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>NetPackPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>UnitPack}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>FOC}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>Status}"/>
							</Column>
						</columns>
					</Table>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	<!--TEMP COMMENT
	<u:ObjectPageSubSection title="Tier Based Pricing">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<l:Grid hSpacing="2" defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMargin">
						<l:VerticalLayout>
							<form:SimpleForm id="idEditPriceOfferTier1" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12"
								labelSpanM="12" emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="false" title="Scenario 1"></form:SimpleForm>
						</l:VerticalLayout>
						<l:VerticalLayout>
							<form:SimpleForm id="idEditPriceOfferTier2" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12"
								labelSpanM="12" emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="false" title="Scenario 2"></form:SimpleForm>
						</l:VerticalLayout>
						<l:VerticalLayout>
							<form:SimpleForm id="idEditPriceOfferTier3" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12"
								labelSpanM="12" emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="false" title="Scenario 3"></form:SimpleForm>
						</l:VerticalLayout>
					</l:Grid>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	<u:ObjectPageSubSection title="Tender History">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<Table id="EdittenderHistoryId" inset="false">
						<headerToolbar>
							<Toolbar>
								<content>
									<ToolbarSpacer/>
									<CheckBox id="EditcurrentInstituteCheckId" text="{i18n>CurrentInstitute}"/>
									<CheckBox id="EditcurrentProductCheckId" text="{i18n>CurrentProduct}"/>
									<CheckBox id="EditwonCheckId" text="{i18n>Won}"/>
									<CheckBox id="EditlossCheckId" text="{i18n>Loss}"/>
								</content>
							</Toolbar>
						</headerToolbar>
						<columns>
							<Column>
								<Text text="{i18n>TenderID}"/>
							</Column>
							<Column>
								<Text text="{i18n>Tender}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>OfferID}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>OfferDate}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>InstituteName}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>Product}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>BidPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>Status}"/>
							</Column>
						</columns>
					</Table>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	-->
</core:FragmentDefinition>