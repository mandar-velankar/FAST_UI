<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:up="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:t="sap.ui.table" xmlns:l="sap.ui.layout">

	<VBox>
		<form:SimpleForm editable="true" title="" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
			adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
			singleContainerFullSize="false" backgroundDesign="Solid">
			<form:content>
				
				<!-- Block Institute & Type -->
				<core:Title text="Institute &amp; Type"/>
				<Label text="{i18n>tenderref}" design="Bold"  required="true"/>
				<Input value="{fastData>TenderName}" enabled="false"/>
				<Label text="{i18n>clasficn}" design="Bold" required="true"/>
				<Input id="idClassificationDisplay" value="{fastData>Classification}" enabled="false" />

				<!-- Argentina only -->
				<Label text="{i18n>BiddingTypeLevel1}" design="Bold" required="true" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR'  &amp;&amp; 
						(${fastData>BiddingTypeLevel1} ? true : false)
					}"
				/>
				<Input id="idBiddingTypeLevel1Display" value="{fastData>BiddingTypeLevel1}" enabled="false" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR'  &amp;&amp; 
						${fastData>BiddingTypeLevel1}.length > 0
					}"
				/>
				<Label text="{i18n>BiddingTypeLevel2}" design="Bold" required="true" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR'  &amp;&amp; 
						(${fastData>BiddingTypeLevel2} ? true : false)
					}"
				/>
				<Input id="idBiddingTypeLevel2Display" value="{fastData>BiddingTypeLevel2}" enabled="false" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR'  &amp;&amp;
						(${fastData>BiddingTypeLevel2} ? true : false)
					}"
				/>
				<Label text="{i18n>BiddingTypeLevel3}" design="Bold" required="true" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR'  &amp;&amp;
						(${fastData>BiddingTypeLevel3} ? true : false)
					}"
				/>
				<Input id="idBiddingTypeLevel3Display" value="{fastData>BiddingTypeLevel3}" enabled="false" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR'  &amp;&amp;
						(${fastData>BiddingTypeLevel3} ? true : false)
					}"
				/>
				<Label text="{i18n>Specifications}" design="Bold" required="true" visible="{= ${fastAppData>/Tender/CountryCode} === 'AR'}"/>
				<MultiComboBox
					id="idSpecificationsDisplay"
					visible="{= ${fastAppData>/Tender/CountryCode} === 'AR'}"
					enabled="false"
					items="{
						path: 'fastData>/Specifications',
						sorter: { path: 'Name' }
					}">
					<core:Item text="{fastData>Name}" key="{fastData>Name}"/>
				</MultiComboBox>
				<!-- /Argentina only -->
				<Label text="{i18n>insttyp}" design="Bold" required="true"/>
				<Input value="{fastData>Institute/InstituteType}" enabled="false"/>
				<Label text="{i18n>institnme}" design="Bold"  required="true"/>
				<Input value="{fastData>Institute/InstituteName}" enabled="false"/>

				<Label text="{i18n>institCode}" design="Bold"  required="false"/>
				<Input value="{fastData>Institute/CustomerID}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>
                
				<Label text="{i18n>institProvince}" design="Bold"   required="false"/>
				<Input value="{fastData>Institute/Province/Name}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>

				<Label text="{i18n>institRegion}" design="Bold"   required="false" visible="false"/>
				<Input value="{fastData>Institute/Region/Name}" enabled="false" visible="false"/>

				<Label text="{i18n>institPoblacion}" design="Bold"   required="false"/>
				<Input value="{fastData>Institute/City}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>
                
				<Label text="{i18n>institcifcode}" design="Bold"   required="false"/>
				<Input value="{fastData>Institute/CifCode}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>
                
				<Label text="{i18n>regionalhealthsystem}" design="Bold"   required="false"/>
				<Input value="{fastData>Institute/RegionalHealthSystem}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>

				<!-- Italy onlye -->
				<Label text="{i18n>region}" design="Bold" required="true"/>
				<MultiComboBox id="idRegionView" 
					selectionChange="handleRegionSelectionChange"
					selectionFinish="handleRegionSelectionFinish"
					enabled="false"
					items="{ 
						path: 'fastData>/CountryRegions',
						sorter: { path: 'Name' }
					}" 
					visible="{= (${fastData>Institute/InstituteType} === 'Region(s)' || ${fastData>/newTender/instituteType}  === 'Region(s)') &amp;&amp; (${fastAppData>/Tender/CountryCode} === 'IT' || ${fastAppData>/Tender/CountryCode} === 'ES') }">
					<core:Item text="{fastData>Name}" key="{fastData>ID}"/>
				</MultiComboBox>
				<!-- /Italy onlye -->
				<Label text="{i18n>typechnl}" design="Bold" required="true"/>
				<Input value="{fastData>TenderChannel}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} !== 'IT' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'ES' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'BR'}"/>
				<Label text="{i18n>grpurchsng}" design="Bold" required="true"/>
				<Select id="idGroupPurchasing" selectedKey="{fastData>GroupPurchasing}" enabled="false">
					<items>
						<core:Item text="No" key="0" />
						<core:Item text="Yes, Delivery Tracking Only" key="1"/>
						<core:Item text="Yes, Requested Quantity - Delivery Tracking" key="2"/>
					</items>
				</Select>
				<Label id="idLabelTenderType" text="{i18n>tendertype}" design="Bold" required="true"/>
				<Select id="idSelectTenderType" 
				selectedKey="{fastData>TENDER_TYPE_ID}" 
				enabled="false" 
				items="{ path: 'fastData>/TenderType', sorter: { path: 'ID' } }"
                visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}">

					<core:Item text="{fastData>NAME}" key="{fastData>ID}"/>
				</Select>

                <Label id="idLabelTenderType2" text="{i18n>tendertype2}" design="Bold" required="true"/>
				<Select id="idSelectTenderType2" 
				selectedKey="{fastData>TENDER_TYPE_2_ID}" 
				enabled="false" 
				items="{ path: 'fastData>/TenderType', sorter: { path: 'ID' } }"
                visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}">
					<core:Item text="{fastData>NAME}" key="{fastData>ID}"/>
				</Select>

                <Label id="idContent" text="{i18n>Content}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES'	}"/>
                <TextArea value="{fastData>CONTENT}" 
						  showExceededText="true" 
						  maxLength="500" 
						  width="100%" 
						  valueState="{= ${fastAppData>CONTENT}.length > 500 ? 'Warning' : 'None' }" 
						  valueLiveUpdate="false" 
						  liveChange="handleLiveChange" 
						  enabled="false"
                          visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>

                <Label id="idPortal" text="{i18n>Portal}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>
                <TextArea value="{fastData>PORTAL}" 
						  showExceededText="true" 
						  maxLength="500" 
						  width="100%" 
						  valueState="{= ${fastAppData>PORTAL}.length > 500 ? 'Warning' : 'None' }" 
						  valueLiveUpdate="false" 
						  liveChange="handleLiveChange" 
						  enabled="false"
                          visible="{= ${fastAppData>/Tender/CountryCode} === 'ES' }"/>
				<!-- Italy only -->
				<Label text="{i18n>CreatedBy}" design="Bold" />
				<Input value="{fastData>User/UserName}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'IT' || ${fastAppData>/Tender/CountryCode} === 'ES'}"/>
				<!-- Argentina only -->
				<Label text="{i18n>HighValue}" design="Bold" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR' &amp;&amp; ${fastData>TenderChannel} === 'Direct' &amp;&amp; ${fastData>BiddingTypeLevel3} === 'Nacional'
					}"
				/>
				<CheckBox 
					enabled="false"
					selected="{fastData>HighValue}" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'AR' &amp;&amp; ${fastData>TenderChannel} === 'Direct' &amp;&amp; ${fastData>BiddingTypeLevel3} === 'Nacional'
					}"
				/>
				<!-- / Argentina only -->
				
				<!-- Mexico changes-->
				<Label id="idLabelSalesType" text="{i18n>salestype}" design="Bold" required="true" visible="true"/>
				<Select id="idSelectSalesType" 
					selectedKey="{fastData>SALES_TYPE_ID}" 
					enabled="false" 
					items="{ path: 'fastData>/SalesType', sorter: { path: 'ID' } }">
						<core:Item text="{fastData>NAME}" key="{fastData>ID}"/>
				</Select>
				
				<!-- Mexico: Tender Origin-->
				<Label id="idLabelTenderOrigin" text="{i18n>tenderOrigin}" design="Bold" required="true" visible="true"/>
				<Select id="idSelectTenderOrigin" 
					selectedKey="{fastData>TENDER_ORIGIN_ID}" 
					enabled="false" 
					items="{ path: 'fastData>/TenderOrigin', sorter: { path: 'ID' } }">
						<core:Item text="{fastData>NAME}" key="{fastData>ID}"/>
				</Select>
				
				<!-- Mexico: Contract Type-->
				<Label id="idLabelContracType" text="{i18n>contracttype}" design="Bold" required="true" visible="true"/>
				<Select id="idSelectContractType" 
					selectedKey="{fastData>CONTRACT_TYPE_ID}" 
					enabled="false" 
					items="{ path: 'fastData>/ContractType', sorter: { path: 'ID' } }">
						<core:Item text="{fastData>NAME}" key="{fastData>ID}"/>
				</Select>
				<!-- End of Mexico Changes-->

				<!-- Thailand: Procurement Method-->
				<Label id="idLabelProcurementMethod" text="{i18n>procurementmethod}" design="Bold" required="true" visible="true"/>
				<Select id="idSelectProcurementMethod" 
					selectedKey="{fastData>PROCUREMENT_METHOD_ID}" 
					enabled="false" 
					items="{ path: 'fastData>/CountryProcurementMethod', sorter: { path: 'PROCUREMENT_METHOD_ID' } }">
						<core:Item text="{fastData>PROCUREMENT_METHOD_ID}" key="{fastData>PROCUREMENT_METHOD_ID}"/>
				</Select>

				<Label id="idLabelProcurementReason" text="{i18n>procurementmethodreason}" design="Bold" required="true" visible="true"/>
				<Input id="idProcurementReason" value="{fastData>PROCUREMENT_REASON}" enabled="false" visible="{= ${fastData>PROCUREMENT_METHOD_ID} === 'Other' ? true : false}"/>
				
				<Label text="{i18n>RequestorPphoneNnumber}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'}"/>
				<Input id="input13" value="{path: 'fastAppData>/Tender/Custom_Integer_1', type: 'sap.ui.model.type.Integer'}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'}"/>

				<Label text="{i18n>BayerRepresentativeName}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'}"/>
				<Input id="input14" value="{path: 'fastAppData>/Tender/Custom_String_1', type: 'sap.ui.model.type.Srting'}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'}"/>

				<Label text="{i18n>BayerRepresentativePhoneNumber}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'}"/>
				<Input id="input16" value="{path: 'fastAppData>/Tender/Custom_Integer_2', type: 'sap.ui.model.type.Integer'}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'}"/>

				<Label text="{i18n>PeriodOfBankGauranteeStart}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'  &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}"/>
				<DatePicker id="input17" value="{path: 'fastAppData>/Tender/Custom_Date_1', type: 'sap.ui.model.type.Date' , formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"  enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'  &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}"/>

				<Label text="{i18n>PeriodOfBankGauranteeEnd}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'  &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}"/>
				<DatePicker id="input18" value="{path: 'fastAppData>/Tender/Custom_Date_2', type: 'sap.ui.model.type.Date' , formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'  &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}"/>

				<Label text="{i18n>BGValueBaht}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'  &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}"/>
				<Input id="input19" value="{path: 'fastAppData>/Tender/Custom_Double_1', type:'.types.customDecimal'}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH'   &amp;&amp; ${fastAppData>/Tender/Classification} === 'Tender'}"/>
				<!-- End of Thailand Changes-->

				<!-- Brazil only -->
				<Label text="{i18n>IBIZId}" design="Bold" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'BR'
					}"
				/>
				<Input id="idIbizID"
					value="{fastData>IbizID}" 
					enabled="false"
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'BR'
					}"
				/>
				<Label text="{i18n>PublicNotice}" design="Bold" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'BR'
					}"
				/>
				<TextArea id="idPublicNotice" rows="8" 
					enabled="false"
					value="{fastData>PublicNotice}"
					showExceededText="true" 
					maxLength="500"
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'BR'
					}"
				/>
				<!-- End Brazil only -->
				
				<!-- Block Timeline -->
				<core:Title text="Timeline"/>
				<Label text="{i18n>pubcndte}" design="Bold" required="true" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<!--<Input id="input6" value="{path :'fastData>PublicationDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" enabled="false"/>-->
				<Input id="input6" value="{path :'fastAppData>/EditTender/PublicationDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<Label text="{i18n>offrdudte}" design="Bold" required="true" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<!--<Input id="input7" value="{path :'fastData>BidDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" enabled="false"/>-->
				<Input id="input7" value="{path :'fastAppData>/EditTender/BidDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<Label text="{i18n>expctawdte}" design="Bold" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<!--<Input id="input8" value="{path :'fastData>AwardDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" enabled="false"/>-->
				<Input id="input8" value="{path :'fastAppData>/EditTender/AwardDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<Label text="{i18n>nwpubdate}" design="Bold" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<!--<Input id="input9" value="{path :'fastData>NextPublicationDye',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" enabled="false"/>-->
				<Input id="input9" value="{path :'fastAppData>/EditTender/NextPublicationDye', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>

				<!-- EFRCL-217931-Italy - Tender expiry date field -->
				<Label text="{i18n>trmndte}" design="Bold" visible="{= ${fastAppData>/EditTender/CountryCode} === 'IT'}"/>
				<Input id="input15" value="{path :'fastAppData>/EditTender/TerminationDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} === 'IT'}"/>
				<!-- EFRCL-217931-Italy - Tender expiry date field -->

				<!-- CR1 -->


				<Label text="Effective Date" design="Bold" visible="{= ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Commercial Agreement' }" required="true"/>
				<Input id="input30" value="{path :'fastAppData>/EditTender/EffectiveDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Commercial Agreement'}"/>
				<Label text="Expiry Date" design="Bold" visible="{= ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Commercial Agreement' }" required="true"/>
				<Input id="input31" value="{path :'fastAppData>/EditTender/ExpiryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Commercial Agreement'}"/>


				<Label text="{i18n>offvad}" design="Bold" visible="{= ${fastAppData>/EditTender/CountryCode} === 'IT'}"/>
                <Input id="input171" value="{path :'fastAppData>/EditTender/OfferValidity', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false" visible="{= ${fastAppData>/EditTender/CountryCode} === 'IT'}"/>
				<!-- CR1 -->

				<!-- Brazil only -->
				<Label text="{i18n>OfferStartDate}" design="Bold"/>
				<DatePicker id="idOfferStartDate" 
					enabled="false"
					value="{path :'fastData>OfferStartDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" 
					visible="{= 
						${fastAppData>/Tender/CountryCode} === 'BR'
					}"
				/>
				<!-- End Brazil only -->

				<Label text="{i18n>contleng}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<Input id="input10" value="{fastData>ContractLength}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<Label text="{i18n>contextnprd}" design="Bold" visible="{= ${fastAppData>/Tender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>
				<Input id="input11" value="{fastData>ContractExtenseion}" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} !== 'ES' || ( ${fastAppData>/EditTender/CountryCode} === 'ES' &amp;&amp; ${fastAppData>/EditTender/Classification} === 'Tender')}"/>

                <!-- Spain only -->
                <Label text="{i18n>CreatedAt}" design="Bold"/>
                <Input id="idCreationDate" value="{path :'fastAppData>/Tender/createdAt', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
                <!-- End Spain only -->
				
				<!-- Status  tender -->
				<Label text="{i18n>tenderstatus}" design="Bold" visible="false"/>
				
				<Select id="input12" selectedKey="{fastData>TenderStatus}" enabled="false" visible="false">
					<items>
							<core:Item text="Open" key="Open"/>
							<core:Item text="Closed" key="Closed"/>
							<core:Item text="Submitted" key="Submitted"/>
							<core:Item text="Declined" key="Declined"/>
							<core:Item text="Cancelled" key="Cancelled"/>
					</items>
				</Select>
				
				
				<!-- TABLE with the award critiria -->
				<core:Title text="{i18n>tilawrcrit}"/>
				<Table id="awardCriteriaId" items="{tabModel>/Data}" inset="false"
								class="sapFDynamicPageAlignContent" width="auto">
								<columns>
									<Column>
										<Label text="{i18n>critr}" wrapping="true"/>
									</Column>
									<Column>
										<Label text="{i18n>weigh}" wrapping="true"/>
									</Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
										<Text text="{tabModel>AwardCriteria}" />
										<Text text="{path :'tabModel>Weight',formatter:'FAST_NS0FAST0.utils.Formatter.percentage'}"/>
										</cells>
									</ColumnListItem>
								</items>
				</Table>
				
				
			</form:content>
		</form:SimpleForm>

		<!-- Tender Information Only for Chile-->
		<form:SimpleForm id="idTenderInformationSimpleForm" editable="true" title="" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
			adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
			singleContainerFullSize="false" backgroundDesign="Solid" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? true : false }">
			<form:content>
				<!-- Block - Tender Information BEGIN-->
				<core:Title text="{i18n>tenderInformation}" />
				<Label />
				<Button xmlns="sap.m" icon="sap-icon://document" text="{i18n>btnDocuments}" type="Emphasized" width="9em" press="onDocumentsPress"/>
				<Label text="{i18n>Institute}" design="Bold"/>
				<Input value="{fastData>CountrySpecificInformation/Institute}" enabled="false"/>
				<Label text="{i18n>tenderref}" design="Bold"/>
				<Input value="{fastData>CountrySpecificInformation/TenderReference}" enabled="false"/>
				<Label text="{i18n>pubcndte}" design="Bold" required="true"/>
				<DatePicker enabled="false" value="{path :'fastData>CountrySpecificInformation/PublicationDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>
				<Label text="{i18n>ClosingDate}" design="Bold" required="true"/>
				<DatePicker  enabled="false" value="{path :'fastData>CountrySpecificInformation/ClosingDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" />
			</form:content>
		</form:SimpleForm>
	</VBox>
