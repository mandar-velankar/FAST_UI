<!-- Fragment for Creating a new contract -->
<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:l="sap.ui.layout" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:core="sap.ui.core"
	xmlns:dnd="sap.ui.core.dnd">

	<Dialog title="Create Contract"  contentWidth="30%">
		<buttons>
			<Button text="Create" press="onSaveNewContract" />
			<Button text="Cancel" press="onCancelNewContract" />
		</buttons>


		<!-- FORM WITH OFFER DATA -->
		<form:SimpleForm editable="true" title="" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="3"
			adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="1" columnsL="1" columnsM="1"
			singleContainerFullSize="true" backgroundDesign="Solid">

			<form:content>
			<core:Title/>

				<!-- Contract Type -->
				<Label text="{i18n>ContractType}" required="true"/>
				<Select id="idNewContractType" 
						change=".onChangeContractType"
						enabled="true">
					<core:Item text="" key=""/>
					<core:Item text="From Offer" key="From Offer" enabled="{fastAppData>/CreateContractFromOfferEnabled_BR}"/>
					<core:Item text="Additional Customer" key="Additional Customer"/>
					<core:Item text="Adhesion Contract" key="Adhesion Contract"/>
				</Select>

				<!-- Customer -->
				<Label text="{i18n>Customer}" required="true"/>
				<!--<Select id="idNewContractCustomerInstitute"  
						change=".onChangeContractCustomer($event,'Institute')"
						visible="false"
						items="{ path: 'fastAppData>/PT_TMINST/', templateShareable:false }"
						enabled="false">
					<core:Item text="{fastAppData>InstituteName}" key="{fastAppData>InstituteID}"/>
				</Select>-->
				<Input xmlns="sap.m" id="idNewContractCustomerInstitute" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="InstituteName_f4"
					value="{fastData>Institute/InstituteName}" enabled="false" visible="false"/>
					
				<Label text="{i18n>Customer}" required="true" />
				<!--<Select id="idNewContractCustomerDistributor"
						change=".onChangeContractCustomer($event,'Distributor')"
						visible="false"
						items="{ path: 'fastAppData>/PT_TMDIST/', templateShareable:false }"
						enabled="false">
					<core:Item text="{fastAppData>DistributorName}" key="{fastAppData>DistributorID}"/>
				</Select>-->

				<Input xmlns="sap.m" id="idNewContractCustomerDistributor" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="DistributorName_f4" enabled="false" visible="false"/>
			</form:content>
		</form:SimpleForm>
   	</Dialog>	
</core:FragmentDefinition>