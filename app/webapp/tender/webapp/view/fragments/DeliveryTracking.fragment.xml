<core:FragmentDefinition controllerName="FAST_NS0FAST0.controller.DeliveryTracking" xmlns="sap.uxap" xmlns:m="sap.m" xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:comp="sap.ui.comp"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

	<!-- DELIVERIES SUB SECTION PAGE -->
			<m:VBox >
				<!-- Buttons for editing -->
				<m:Toolbar id='deliveriesTableToolbarId'>
					<m:ToolbarSpacer/>
					<m:Button visible="{= ${fastAppData>/EditMode} === true ? true : false}" text="{i18n>AddDelivery}" icon="sap-icon://add" press="onAddDeliverie"/>
					<!--<m:Button id="idDelDelv" visible="false" text="{i18n>DeleteDelivery}" icon="sap-icon://delete" press="onDeleteDeliverie" enabled="{= ${fastAppData>/SelectedDeliverieProduct/Deliveries/results/length} > 0 }"/>-->
				</m:Toolbar>
				<!-- Deliveries table -->

                <m:ScrollContainer>
				<m:Table  id="deliveriesTableID" popinLayout="GridSmall" mode="{= ${fastAppData>/EditMode} === true ? 'Delete' : 'SingleSelectMaster'}" 
					delete=".onDeleteDeliverie" selectionChange=".onDeliveryItemSelect"
					items="{ 
						path: 'fastAppData>/SelectedDeliverieProduct/Deliveries/results/', 
						filters: [ 
							{ path : '_sOperation', operator : 'NE', value1 : 'DELETE' },
							{ path : 'Active', operator : 'NE', value1 : 0 } 
						] 
					}">
					<m:columns>
						<m:Column width="7rem">
							<m:Label text="{i18n>LocalOrDicectDelivery.}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>PlannedInAPO}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="8.5rem">
							<m:Label text="{i18n>RequestedDeliveryDate}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>RequestedQuantity}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="8.5rem">
							<m:Label text="{i18n>ActualDeliveryDate}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>ActualDeliveryQuantity}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
            <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->
                        <m:Column width= "15rem" visible="{= ${fastAppData>/Tender/CountryCode} !== 'AR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp;  ${fastAppData>/Tender/CountryCode} !== 'MX' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'TH' ? true : false}"> 
                        <m:Label text="{i18n>ActualDeliveredProduct}" wrapping="true"/>
						</m:Column>
                       
                        <m:Column width="7rem" visible="{= ${fastAppData>/Tender/CountryCode} !== 'AR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'MX' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'TH' ? true : false}">  
							<m:Label text="{i18n>ActualDeliveredProductQty}"  wrapping="true"/>
						</m:Column> 
        <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->
						<m:Column width="6rem">
							<m:Label text="{i18n>PaidOrFree}" required="{= ${fastAppData>/EditMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>PONumber}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>InvoiceNo}" wrapping="true"/>
						</m:Column>
         <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->
                        <m:Column width="6rem" visible="{= ${fastAppData>/Tender/CountryCode} !== 'AR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'MX' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'TH' ? true : false}"> 
                    	<m:Label text="{i18n>LocalDeliveryNoteNo}" wrapping="true"/>
						</m:Column>
        <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->
						<m:Column width="5.5rem">
							<m:Label text="{i18n>Penalty}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>Compensated}" required="{= ${fastAppData>/EditMode} === true ? true : false}"/>
						</m:Column>
					</m:columns>
					<m:items>
						<m:ColumnListItem type="{= ${fastAppData>/EditMode} === true ? 'DetailAndActive' : 'Navigation'}"
							detailPress=".onDeliveryItemDetail" press="{= ${fastAppData>/EditMode} === true ? '.onDeliveryItemSelect' : ''}">
							<m:cells>
								<!--<m:ObjectIdentifier title="{fastAppData>LocalOrDirectDelivery}"/>-->
								<m:Select selectedKey="{fastAppData>LocalOrDirectDelivery}" enabled="false">
									<m:items>
										<core:Item text="Direct" key="D"/>
										<core:Item text="Local" key="L"/>
									</m:items>
								</m:Select>
								<m:Select selectedKey="{fastAppData>PlannedInAPO}" enabled="false">
									<m:items>
										<core:Item text="Yes" key="Yes"/>
										<core:Item text="No" key="No"/>
									</m:items>
								</m:Select>
								<!--<m:DatePicker -->
								<!--	placeholder="{i18n>Select_date}" -->
								<!--	tooltip="{i18n>RequestedDeliveryDate}"-->
								<!--	dateValue="{fastAppData>RequestedDeliveryDate}"-->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	enabled="false"-->
								<!--/>-->
								<m:DatePicker
									value="{path :'fastAppData>RequestedDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="{i18n>RequestedDeliveryDate}" enabled="false" placeholder="{i18n>Select_date}"/>
								<m:Input value="{fastAppData>RequestedQuantity}" type="Number" enabled="false"/>
								<!--<m:DatePicker -->
								<!--	placeholder="{i18n>Select_date}" -->
								<!--	tooltip="{i18n>EffDate}"-->
								<!--	dateValue="{fastAppData>ActualDeliveryDate}"-->
								<!--	displayFormat="dd.MM.yyyy" -->
								<!--	required="true"-->
								<!--	enabled="false"/>-->
								<m:DatePicker
									value="{path :'fastAppData>ActualDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="{i18n>EffDate}" enabled="false" placeholder="{i18n>Select_date}"/>
								<m:Input value="{fastAppData>ActualDeliveryQuantity}"  enabled="false" required="true"/>
            <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->
            
              <m:Input enabled="false" valueHelpOnly="true" valueHelpRequest="onPress" showValueHelp= "true" value="{fastAppData>ActualDeliveredProduct}" visible="{= ${fastAppData>/Tender/CountryCode} !== 'AR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'MX' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'TH' ? true : false}"/>
              
          	  <m:Input value="{fastAppData>ActualDeliveredProductQty}" type="Number" enabled="false" visible="{= ${fastAppData>/Tender/CountryCode} !== 'AR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'MX' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'TH' ? true : false}"/>                      
        <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->  

                       
								<m:Select selectedKey="{fastAppData>PaidOrFree}" enabled="false">
									<m:items>
										<core:Item text="Paid" key="Paid"/>
										<core:Item text="Free" key="Free"/>
									</m:items>
								</m:Select>
								<m:Input value="{fastAppData>PO}" enabled="false"/>
								<m:Input value="{fastAppData>InvoiceNo}" enabled="false"/>
         <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->
                                <m:Input value="{fastAppData>LocalDeliveryNoteNo}" enabled="false" required="true" visible="{= ${fastAppData>/Tender/CountryCode} !== 'AR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'MX' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'TH' ? true : false}"/> 
          <!-- EHQUT OTT - 105262-Adding new 3 fields for delivery tracking tab -->
								<m:Select selectedKey="{fastAppData>Penalty}" change="onChangePenalty" enabled="false">
									<m:items>
										<core:Item text="Yes" key="Yes"/>
										<core:Item text="No" key="No"/>
									</m:items>
								</m:Select>
								<m:Select selectedKey="{fastAppData>Compensated}" change="onChangeCompensated" enabled="false">
									<m:items>
										<core:Item text="Yes" key="Yes"/>
										<core:Item text="No" key="No"/>
									</m:items>
								</m:Select>
							</m:cells>
						</m:ColumnListItem>
					</m:items>
				</m:Table>
                 </m:ScrollContainer>
			</m:VBox>

</core:FragmentDefinition>