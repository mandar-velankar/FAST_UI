<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<Dialog
		id="idTenderOverviewDialogBrazil"
		title="Tender Overview"
		contentWidth="50%"
		contentHeight="50%">
		<content>
			<Table id="idTenderOverviewTableBrazil"
				inset="false"
				columns="{fastAppData>/TenderOverview/columns}"
				items="{fastAppData>/TenderOverview/rows}">
				<columns>
					<Column width="12em">
						<ObjectIdentifier
								title="{fastAppData>OfferID}"
								text="{fastAppData>Distributor/DistributorName}"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem cells="{fastAppData>totalDiscounts}">
						<cells>
							<ObjectStatus
								text="{
									path: 'fastAppData>value',
									formatter:'.formatter.formatTotalDiscount'
								}"
								state="{= ${fastAppData>bSmallerDiscount} === true ? 'Error' : 'None'  }" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<!-- <beginButton>
			<Button text="Duplicate" press=".onDuplicateOfferDialogDuplicateOffer" />
		</beginButton> -->
		<endButton>
			<Button text="Close" press=".onBrazilTenderOverviewDialogClose" />
		</endButton>
	</Dialog>
	
</core:FragmentDefinition>