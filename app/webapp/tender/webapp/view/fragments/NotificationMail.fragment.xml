<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:rtx="sap.ui.richtexteditor" > 

    <Dialog title="Send Distributor Mail" stretch="true" id="SendNotificationMailDialog">
        <buttons>
                    <Button text="Send" press="onSubmitToDistributorTH" />
                    <Button text="Cancel" press="onCancelNotificationMailForTH" />
        </buttons> 

			<form:SimpleForm editable="true" 
                            maxContainerCols="1" 
                            layout="ResponsiveGridLayout"  
                            labelSpanL="1" 
                            labelSpanM="1"
                            emptySpanL="0" 
                            emptySpanM="0" 
                            columnsL="1" 
                            columnsM="1" 
                            class="editableForm" 
                            visible="true"
                            id="SendNotificationMailForm">           
				<form:content >
					<core:Title/>

                   <Label text="From" />
                   <MultiInput id="idFrom" width="70%" showValueHelp="false"  enabled="false"/>

                    <Label text="To" />
                    <!--<MultiInput id="idTo" width="70%" showValueHelp="false" />-->
                    <MultiInput id="idTo" width="70%" showValueHelp="false"  enabled="false" ></MultiInput>
                    <Label text="CC" />
                    <MultiInput id="idRecipientCC"  width="70%" showValueHelp="false"  enabled="true" change="onRecipientChange"></MultiInput>
                    <Label text="Subject" />
                    <Input id="idSubject" />

                   <Label text="Content" />
                   <rtx:RichTextEditor id="idRichTextEditor" 
                                       editorType="TinyMCE5"
                                       height="600px"
                                       customToolbar="true"
                                       showGroupFont="true"
                                       showGroupFontStyle="true"
                                       showGroupLink="true"
                                       showGroupStructure="true"
                                       showGroupTextAlign="true"
                                       showGroupUndo="true"
                                       />
                </form:content>
		</form:SimpleForm>
   	</Dialog>	
</core:FragmentDefinition>