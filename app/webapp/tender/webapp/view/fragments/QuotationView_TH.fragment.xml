<core:FragmentDefinition controllerName="FAST_NS0FAST0.controller.Detail" 
    xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <!-- QUOTATION TAB -->
        <ObjectPageSubSection id="QuotationNoOfferSubsection" title="{i18n>Quotation}">
            <l:BlockLayout background="Light">
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
                        <m:VBox>
                            <m:FormattedText htmlText="Offer not available for quotation..."/>
                        </m:VBox>
                    </l:BlockLayoutCell>
                </l:BlockLayoutRow>
            </l:BlockLayout>
        </ObjectPageSubSection>
        
        <ObjectPageSubSection id="QuotationOfferSubsection" title="{i18n>Quotation}">
            <actions>
                <!-- DelayInSubmission -->	
                <m:Switch 
                    id="idDelayInSubmission" 
                    customTextOn="Yes" 
                    customTextOff="No" 
                    state="{= ${fastData>Quotation/DelayInSubmission} === 'Yes' ? true : false}" 
                    enabled="{= ${fastAppData>/SelectedOfferID} !== '' &amp;&amp; ${fastData>OfferStatus/STATUS} === 'Quotation Submitted' ? true : false}"
                    change="onSwitchDelayInSubmission" />
                
                <!-- Download Quotation -->	
                <m:Button
                    id="btnSaveQuotation"
                    text="{i18n>SaveQuotation}"
                    icon="sap-icon://save"
                    press=".onSaveDefaultQuotation"
                    enabled="{= ${fastAppData>/SelectedOfferID} === '' || ${fastAppData>/SelectedOffer/ActiveOffer} !== 1 || ${fastAppData>/SelectedOffer/Active} !== 1 ? false : true}"/>

                <m:Button
                    id="btnDownloadQuotation"
                    text="{i18n>DownloadQuotation}"
                    icon="sap-icon://download"
                    press=".onDownloadQuotation"
                    enabled="{= ${fastAppData>/SelectedOfferID} === '' ? false : true}"/>

                <!-- Submit Quotation -->	
                <m:Button
                    id="btnSubmitQuotation"
                    text="{i18n>SubmitQuotation}"
                    icon="sap-icon://sys-enter"
                    press=".onSubmitQuotation"
                    enabled="false"/>
                    
                <m:MenuButton text="Download Word" id="btnDownloadWordQuotation" visible="{= ${fastAppData>/WordTemplates}.length > 0 }">
                    <m:menu>
                        <m:Menu itemSelected="onMenuAction" items="{fastAppData>/WordTemplates}">
                            <m:MenuItem text="{fastAppData>WordTemplates/name}" icon="sap-icon://download" press=".onDownloadWord"/>
                        </m:Menu>
                    </m:menu>
                </m:MenuButton>
                    
                <m:Button
                    id="btnExportToExcel"
                    text="{i18n>ExportToExcel}"
                    icon="sap-icon://excel-attachment"
                    press=".onExportToExcel"
                    enabled="{=${fastAppData>/SelectedOffer/OfferStatus/STATUS} === 'Offer Created' ||  ${fastAppData>/SelectedOffer/OfferStatus/STATUS} === 'Awaiting Approval' || ${fastAppData>/SelectedOffer/OfferStatus/STATUS} === 'In FOC Negotiation' || ${fastAppData>/SelectedOffer/OfferStatus/STATUS} === 'Offer Rejected' ? false : true}"/>

            </actions>
            <l:BlockLayout background="Light">
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell><!--</l:BlockLayoutCell> backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">-->
                        <m:VBox>                            
                            <m:Label/>
                            
                    <form:SimpleForm id="IdQuotationInfo" editable="false" maxContainerCols="3" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
                        emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="true">
                        <form:content>
                            
                            <m:VBox fitContainer="true" alignItems="Stretch">
                                <m:items>
                                    <m:HBox>
                                        <m:items>
                                            <!-- Offer Party -->
                                            <m:VBox width="50%">
                                                <m:items>
                                                    <m:HBox width="60%">
                                                        <m:items>
                                                            <m:Label text="{i18n>OfferParty}" width="6rem" design="Bold"/>
                                                            <m:Text text="{= ${fastAppData>/Tender/Institute/InstituteType} + ', ' + ${fastAppData>/Tender/Institute/InstituteName} + ', ' + ${fastAppData>/Tender/Institute/CustomerID} }"/>
                                                        </m:items>
                                                    </m:HBox>
                                                    <m:HBox width="50%">
                                                        <m:items>
                                                            <m:VBox width="40rem" >
                                                                <m:items>

                                                                    <!-- Procurement Method (thailand) -->
                                                                    <m:HBox width="40rem" visible="true">
                                                                        <m:items>
                                                                            <m:Label text="{i18n>procurementmethod}" class="sapUiSmallMarginEnd" design="Bold"/>
                                                                            <m:Text text="{fastAppData>/EditTender/PROCUREMENT_METHOD_ID} {fastAppData>/EditTender/PROCUREMENT_REASON}"/>
                                                                        </m:items>
                                                                    </m:HBox>
                                                                </m:items>
                                                            </m:VBox>
                                                        </m:items>
                                                    </m:HBox>
                                                </m:items>
                                            </m:VBox>
                                            <m:VBox width="50%" alignItems="End">
                                                <m:HBox>
                                                    <m:items>
                                                        <!--<m:VBox alignItems="End">-->
                                                            <f:Avatar src="{imageModel>/path}/Company-Logo-Blue.svg" displaySize="M" displayShape="Square" class="sapUiTinyMarginEnd"/>
                                                        <!--</m:VBox>-->
                                                        <!--<m:VBox alignItems="End">-->
                                                            <m:FormattedText htmlText="{fastAppData>/OfferValidation/LETTERHEAD}" class="sapMText"/>
                                                        <!--</m:VBox>-->
                                                    </m:items>
                                                </m:HBox>
                                            </m:VBox>
                                        </m:items>
                                    </m:HBox>
                                    <m:Toolbar width="100%" height="1px"/>
                                    <!-- 4th row -->
                                    <m:HBox class="sapUiSmallMarginBottom">
                                        <m:items>
                                            <m:VBox width="73%">
                                                <m:items>
                                                    <m:HBox>
                                                        <m:items>
                                                            <!-- N° Invoice -->
                                                            <m:VBox width="20%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>contractnumber}" design="Bold"/>
                                                                    <m:Text text="{fastAppData>/OfferValidation/OFFERID}"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>
                                                            <!-- Tender refrence -->
                                                            <m:VBox width="28%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>reference}" design="Bold"/>
                                                                    <m:Text text="{fastAppData>/OfferValidation/TENDER_REFERENCE}"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>
                                                            <!-- Offer Date -->
                                                            <m:VBox width="13%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>OfferDate}" design="Bold"/>
                                                                    <!--<m:DatePicker id="idQofferDate" value="{path :'fastAppData>/OfferValidation/OFFERDATE',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" enabled="false"/>-->
                                                                    <m:DatePicker id="idQofferDate" value="{path :'fastAppData>/OfferValidation/OFFERDATE', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>
                                                            <!-- Offer Validity -->
                                                            <m:VBox width="13%">
                                                                <m:items>
                                                                    <m:Label text="{i18n>OfferValidity}" design="Bold"/>
                                                                    <!--<m:DatePicker id="idQofferValidity" value="{path :'fastAppData>/OfferValidation/OFFERVALIDITY',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" enabled="false"/>-->
                                                                    <m:DatePicker id="idQofferValidity" value="{path :'fastAppData>/OfferValidation/OFFERVALIDITY', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            <m:VBox width="2%">
                                                            </m:VBox>

                                                        </m:items>
                                                    </m:HBox>
                                                    <m:Toolbar width="100%" height="1px"/>
                                                    <m:HBox>
                                                        <m:items>
                                                            <!-- Shipment Terms-->
                                                            <m:VBox width="50rem">
                                                                <m:items>
                                                                    <m:Label text="{i18n>qShipment}" design="Bold"/>
                                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/SHIPMENTTERMS}" class="sapMText"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            
                                                            <!-- Payment Terms -->
                                                            <m:VBox width="50rem">
                                                                <m:items>
                                                                    <m:Label text="{i18n>qPayment}" design="Bold"/>
                                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/PAYMENTTERMS}" class="sapMText"/>
                                                                </m:items>
                                                            </m:VBox>
                                                            
                                                            <!-- Delivery Terms -->
                                                            <m:VBox width="50rem">
                                                                <m:items>
                                                                    <m:Label text="{i18n>qDelivery}" design="Bold"/>
                                                                    <m:FormattedText htmlText="{fastAppData>/OfferValidation/DELIVERYTERMS}" class="sapMText"/>
                                                                </m:items>
                                                            </m:VBox>
                                                        </m:items>
                                                    </m:HBox>
                                                </m:items>
                                            </m:VBox>
                                            <m:VBox width="2%"/>
                                            <m:VBox width="25%">
                                                <m:items>
                                                    <m:VBox>
                                                        <m:items>
                                                            <m:Label text="{i18n>Bank}" width="10rem" design="Bold" visible="{= ${fastAppData>/OfferValidation/COUNTRYCODE} === 'TH' ? false : true}"/>
                                                            <m:FormattedText htmlText="{fastAppData>/OfferValidation/SELLINGCOMPANYBANK}" class="sapMText" visible="{= ${fastAppData>/OfferValidation/COUNTRYCODE} === 'TH' ? false : true}"/>
                                                        </m:items>
                                                    </m:VBox>
                                                </m:items>
                                            </m:VBox>
                                        </m:items>
                                    </m:HBox>
                                    <m:Toolbar width="100%" height="1px"/>
                                    <m:HBox>
                                        <m:items>
                                            <m:VBox width="23rem" class="sapUiSmallMarginEnd">
                                                <m:items>
                                                    <m:Label text="{i18n>qUnitofvalidityperiod}" design="Bold"/>
                                                    <m:Select class="sapUiSmallMarginEnd" width="100%" enabled="false" id="idqUnitofvalidityperiod" selectedKey="{fastAppData>/OfferValidation/Unitofvalidityperiod}">
                                                        <core:Item key="" text=""/>
                                                        <core:Item key="Days" text="Days"/>
                                                        <core:Item key="Months" text="Months"/>
                                                        <core:Item key="Years" text="Years"/>
                                                    </m:Select>
                                                </m:items>
                                            </m:VBox>
                                                <m:VBox width="13rem" class="sapUiSmallMarginEnd">
                                                <m:items>
                                                    <m:Label text="{i18n>qDeliveryDue}" design="Bold"/>
                                                    <m:Input class="sapUiSmallMarginEnd" id="idqDeliveryDue" enabled="false" value="{fastAppData>/OfferValidation/DeliveryDue}" type="Number"/>
                                                </m:items>
                                            </m:VBox>
                                                <m:VBox width="24rem">
                                                <m:items>
                                                    <m:Label text="{i18n>qUnitofdeliverydue}" design="Bold" />
                                                    <m:Select class="sapUiSmallMarginEnd" width="100%" enabled="false" id="idqUnitofdeliverydue" selectedKey="{fastAppData>/OfferValidation/Unitofdeliverydue}">
                                                        <core:Item key="" text=""/>
                                                        <core:Item key="Days" text="Days"/>
                                                        <core:Item key="Months" text="Months"/>
                                                        <core:Item key="Years" text="Years"/>
                                                    </m:Select>
                                                </m:items>
                                            </m:VBox>
                                        </m:items>
                                    </m:HBox>
                                    <m:Toolbar width="100%" height="1px" class="sapUiSmallMarginTop"/>
                                    <m:HBox>
                                        <m:items>
                                            <m:VBox width="30rem" class="sapUiSmallMarginEnd">
                                                <m:items>
                                                    <m:Label text="{i18n>qQuotationDeliverymethod}" design="Bold"/>
                                                    <m:MultiComboBox class="sapUiSmallMarginEnd" enabled="false" id="idqQuotationDeliverymethod" selectedKeys="{fastAppData>/OfferValidation/QuotationDeliverymethod}">
                                                        <core:Item key="DKSH Quotation Office" text="DKSH Quotation Office"/>
                                                        <core:Item key="Send to Bayer" text="Send to Bayer"/>
                                                        <core:Item key="Email" text="Email"/>
                                                        <core:Item key="Fax" text="Fax"/>
                                                        <core:Item key="Customer" text="Customer"/>
                                                    </m:MultiComboBox>
                                                </m:items>
                                            </m:VBox>
                                            <m:VBox width="30rem" class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
                                                <m:items>
                                                    <m:Label text="{i18n>qQuotationRecipientname}" design="Bold"/>
                                                    <m:Input class="sapUiSmallMarginEnd" enabled="false" id="idqQuotationRecipientname" value="{fastAppData>/OfferValidation/QuotationRecipientname}" />
                                                </m:items>
                                            </m:VBox>
                                        </m:items>
                                    </m:HBox>
                                     <m:Toolbar width="100%" height="1px" class="sapUiSmallMarginTop"/>
                                     <m:HBox>
                                        <m:items>
                                            <m:VBox width="30rem" class=" sapUiSmallMarginEnd">
                                                <m:items>
                                                    <m:Label text="{i18n>qQuotationRecipientcontact}" design="Bold"/>
                                                    <m:Input class="sapUiSmallMarginEnd" enabled="false" id="idqQuotationRecipientcontact" value="{fastAppData>/OfferValidation/QuotationRecipientcontact}"/>
                                                </m:items>
                                            </m:VBox>
                                            <m:VBox width="30rem" class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
                                                <m:items>
                                                    <m:Label text="{i18n>qExpectdatetoreceivethedocument}" design="Bold"/>
                                                    <m:DatePicker class="sapUiSmallMarginEnd" enabled="false" id="idqExpectdatetoreceivethedocument" value="{path:'fastAppData>/OfferValidation/Expectdatetoreceivethedocument',type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"/>
                                                </m:items>
                                            </m:VBox>
                                        </m:items>
                                    </m:HBox>
                                </m:items>
                            </m:VBox>
                            
                        </form:content>
                    </form:SimpleForm>
                    </m:VBox>
        
        <!-- Quotation products -->
            <m:Table id="idQuotationTable"
                items="{path : 'fastAppData>/OfferProductValidation/', sorter: [{path: 'SORTER', descending: false}]}"
                inset="false" class="sapFDynamicPageAlignContent" width="auto"
                alternateRowColors="true" fixedLayout="true">
                <m:columns>
                    <!-- SKU Code -->
                    <m:Column width="9%">
                        <m:Text text="{i18n>SKUCode}"/>
                    </m:Column>

                    <!-- Article Name -->
                    <m:Column width="16%">
                        <m:Text text="{i18n>articleName}"/>
                    </m:Column>

                    <!-- Quantity -->
                    <m:Column width="13%">
                        <m:Text text="{i18n>qQuantity}"/>
                    </m:Column>

                    <!-- Pack Factor -->
                    <m:Column width="6%">
                        <m:Text text="{i18n>PackFactor}"/>
                    </m:Column>

                    <!-- MSP Excl Vat / Unit Price -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>mspExclVAT}"/>
                    </m:Column>

                    <!-- MSP Incl VAT -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>mspInclVAT}"/>
                    </m:Column>

                    <!-- Total -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>Total}"/>
                    </m:Column>

                    <!-- Total incl VAT -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>TotalWithVAT}"/>
                    </m:Column>
                    
                    <!-- Samples -->
                    <m:Column width="7%">
                        <m:Text text="{i18n>samplesTH}"/>
                    </m:Column>

                    <!-- Origin -->
                    <m:Column width="10%">
                        <m:Text text="{i18n>CountryOfOrigin}"/>
                    </m:Column>

                    <!-- Contract ID -->
                    <m:Column width="12%">
                        <m:Text text="{i18n>contractid}"/>
                    </m:Column>

                    <!-- FOC -->
                    <m:Column width="9%">
                        <m:Text text="{i18n>focQtyInUnits}"/>
                    </m:Column>

                    <!-- Total Qty -->
                    <m:Column width="10%">
                        <m:Text text="{i18n>TotalQty}"/>
                    </m:Column>

                    <!-- NSP -->
                    <m:Column width="10%">
                        <m:Text text="{i18n>NSPperPack}"/>
                    </m:Column>

                </m:columns>
                <m:items>
                    <m:ColumnListItem>
                        <m:cells>
                            <!-- SKU Code -->
                            <m:Text text="{parts: [{path :'fastAppData>SKU'}], formatter: '.formatter.nullToBlank'}"/>
                            
                            <!-- Article Name -->
                            <m:Text text="{path :'fastAppData>PRODUCT_UNIT_NAME'}"/>
                            
                            <!-- Quantity -->
                            <m:FormattedText htmlText="{= ${fastAppData>PAID_VOLUME} + ' ' + ${fastAppData>UNIT} + 's'}" class="sapMText"/>
                            
                            <!-- Pack Factor -->
                            <m:Text text="{fastAppData>PACKSIZE}"/>
                            
                            <!-- MSP Excl Vat / Unit Price -->
                            <m:ObjectStatus
                                text="{parts: [
                                    {path: 'fastAppData>OFFER_PRICE'}, 
                                    {path: 'fastAppData>CURRENCY'}
                                ], formatter:'.formatter.priceTwoOrFour'}"
                                state="{ parts:[{path:'fastAppData>IS_LOWEST'}], formatter: '.formatter.statusPrice'}"
                            />

                            <!-- MSP Incl VAT -->
                            <m:ObjectStatus text="{parts: [ {path: 'fastAppData>OFFER_PRICE_VAT'},  {path: 'fastAppData>CURRENCY'} ], formatter:'.formatter.price'}"
                                state="{ parts:[{path:'fastAppData>IS_LOWEST'}], formatter: '.formatter.statusPrice'}"/>

                            <!-- Total -->
                            <m:Text text="{parts: [
                                {path: 'fastAppData>GROSS_SALES_OFFER_CURRENCY'}, 
                                {path: 'fastAppData>CURRENCY'}
                            ], formatter:'.formatter.price'}"/>

                            <!-- Total incl VAT -->
                            <m:Text text="{parts: [
                                {path: 'fastAppData>GROSS_SALES_OFFER_CURRENCY_VAT'}, 
                                {path: 'fastAppData>CURRENCY'}
                            ], formatter:'.formatter.price'}"/>
                            
                            <!-- Samples -->
                            <m:Text text="{path :'fastAppData>SAMPLES'}"/>

                            <!-- Origin -->
                            <m:Text text="{path :'fastAppData>COUNTRYOFORIGIN'}"/>

                            <!-- Contract ID -->
                            <m:Text text="{= ${path :'fastAppData>OFFER_ID'} + '-' + ${path :'fastAppData>SORTER'} }"/>
                    
                            <!-- FOC -->
                            <m:FormattedText htmlText="{= ${fastAppData>FOC} }" 
                                                class="sapMText"/>

                            <!-- Total Qty-->
                            <m:FormattedText htmlText="{= ${fastAppData>UNIT} === 'Unit' ? ${fastAppData>TOTAL_QUANTITY_UNITS} + ' ' + ${fastAppData>UNIT} + 's' : (${fastAppData>TOTAL_QUANTITY_UNITS} / ${fastAppData>PACKSIZE}) + ' ' + ${fastAppData>UNIT} + 's' } " class="sapMText"/>

                            <!-- NSP -->
                            <m:Text text="{parts: [
                                {path: 'fastAppData>NET_PRICE'}, 
                                {path: 'fastAppData>CURRENCY'}
                            ], formatter:'.formatter.price'}"/>

                        </m:cells>
                    </m:ColumnListItem>
                </m:items>
            </m:Table>
                    
                    <form:SimpleForm id="IdQuotationInfo2" editable="false" maxContainerCols="3" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
                        emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="false">
                        <form:content>
                            
                            <m:VBox fitContainer="true" alignItems="Stretch">
                                <m:items>
                                    <m:HBox class="sapUiLargeMarginTop">
                                        <m:items>
                                            
                                            <!-- total amount -->
                                            <m:VBox width="50%">
                                                <m:Label text="{i18n>TotalAmount}" design="Bold"/>
                                            </m:VBox>
                                            <m:VBox width="50%" alignItems="End">
                                                <m:items>
                                                    <m:Text text="{parts: [
                                                        {path: 'fastAppData>/OfferValidation/AMOUNT_IN_NUMBERS'}, 
                                                        {path: 'fastAppData>/OfferValidation/CURRENCY'}
                                                    ], formatter:'.formatter.price'}" class="sapUiSmallMarginEnd"/>
                                                </m:items>
                                            </m:VBox>

                                        </m:items>
                                    </m:HBox>
                                    <m:HBox class="sapUiSmallMarginTop" visible="true">
                                        <m:items>
                                            
                                            <!-- VAT amount -->
                                            <m:VBox width="50%">
                                                <m:Label text="{i18n>VATAmount}" design="Bold"/>
                                            </m:VBox>
                                            <m:VBox width="50%" alignItems="End">
                                                <m:items>
                                                    <m:Text text="{parts: [
                                                        {path: 'fastAppData>/OfferValidation/VAT_TOTAL'}, 
                                                        {path: 'fastAppData>/OfferValidation/CURRENCY'}
                                                    ], formatter:'.formatter.price'}" class="sapUiSmallMarginEnd"/>
                                                </m:items>
                                            </m:VBox>

                                        </m:items>
                                    </m:HBox>
                                    <m:HBox class="sapUiSmallMarginTop"  visible="true">
                                        <m:items>
                                            
                                            <!-- total amount -->
                                            <m:VBox width="50%">
                                                <m:Label text="{i18n>TotalAmountWithVAT}" design="Bold"/>
                                            </m:VBox>
                                            <m:VBox width="50%" alignItems="End">
                                                <m:items>
                                                    <m:Text text="{parts: [
                                                        {path: 'fastAppData>/OfferValidation/AMOUNT_IN_NUMBERS_VAT'}, 
                                                        {path: 'fastAppData>/OfferValidation/CURRENCY'}
                                                    ], formatter:'.formatter.price'}" class="sapUiSmallMarginEnd"/>	
                                                </m:items>
                                            </m:VBox>

                                        </m:items>
                                    </m:HBox>
                                    <m:Toolbar width="100%" height="1px"/>
                                    
                                    <!-- Creating additional space, so flickering of screen doesn't happen. This happens when content is almost fitting on the screen vs not -->
                                    <!-- these empty boxes solves this problem, since scrollbar is always shown -->
                                    <m:VBox fitContainer="true" height="500px">
                                    </m:VBox>
                                    
                                </m:items>
                            </m:VBox>
                            
                        </form:content>
                    </form:SimpleForm>
                    
                    </l:BlockLayoutCell >
                </l:BlockLayoutRow>
            </l:BlockLayout>
        </ObjectPageSubSection>
</core:FragmentDefinition>