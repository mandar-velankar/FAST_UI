<mvc:View controllerName="FAST_NS0FAST0.controller.FinancialOffer_IT" 
		  xmlns="sap.m" 
		  xmlns:f="sap.f"
		  xmlns:form="sap.ui.layout.form" 
		  xmlns:mvc="sap.ui.core.mvc" 
		  xmlns:t="sap.ui.table" 
		  xmlns:core="sap.ui.core" 
		  xmlns:l="sap.ui.layout"
		  xmlns:viz.data="sap.viz.ui5.data" 
		  xmlns:viz="sap.viz.ui5.controls" 
		  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" 
		  xmlns:u="sap.uxap">

	<!-- TENDER OFFER SUBSECTION -->
	<u:ObjectPageSubSection id="FinNoOfferSubsection" title="Financial Offer">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<VBox>
						<FormattedText htmlText="Offer not available for financial offer..."/>
					</VBox>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	
	<!-- TENDER OFFER SUBSECTION -->
	<u:ObjectPageSubSection id="FinTenderOfferSubsection" title="Tender Offer" mode="Expanded">
		<u:actions>
			<Button id="ApprovalButtonId" text="Approvals" icon="sap-icon://validate" press="onApprovalsPress" enabled="false"/>
			<Button text="Tender Overview" icon="sap-icon://manager-insight" press="onTenderOverviewPress" visible="{= ${fastAppData>/Tender/CountryCode} === 'AR' }" />	
			
		</u:actions>
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<VBox>
						
						<!-- Form with selected offer data -->
						<form:SimpleForm id="idCurrencyForm" editable="true" maxContainerCols="2" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
							emptySpanL="0" emptySpanM="0" columnsL="1" columnsM="1" class="editableForm" visible="true" title="">
							<Label text="{i18n>Currency}"/>
							<Select id="idCurrency" enabled="false"></Select>
							<Label text="{i18n>FOC}"/>
							<Select id="idFOCType" selectedKey="{fastAppData>/EditOffer/FOCType}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}">
								<items>
									<core:Item key="FOC 2" text="In addition to requested volume" />
									<core:Item key="FOC 1" text="Part of requested volume" />									
								</items>
							</Select>
						</form:SimpleForm>
						
						<!-- Table with products -->
						<Table id="idFinancialOfferViewProduct" 
							   items="{path : 'fastAppData>/OfferProductsItaly'}"
							   inset="false" 
							   class="sapFDynamicPageAlignContent" width="auto">
							<columns>
								<Column>
									<Text text="{i18n>Product}"/>
								</Column>
								<Column>
									<Text text="{i18n>Volume}"/>
								</Column>
								<Column>
									<Text text="{i18n>UoM}"/>
								</Column>
								<Column>
									<Text text="{i18n>NetPrice}"/>
								</Column>
								<Column>
									<Text text="${i18n>OfferPrice}"/>
								</Column>
								<Column>
									<Text text="{i18n>COGS}"/>
								</Column>
								<Column>
									<Text text="{i18n>GrossSales}"/>
								</Column>
								<Column>
									<Text text="{i18n>NetSales}"/>
								</Column>
								<Column>
									<Text text="{i18n>Profitability}"/>
								</Column>
							</columns>
							<items>
								<ColumnListItem type="Navigation" press="onDetailPress" detailPress="onDetailPress">
									<cells>
										<Text text="{fastAppData>ProductPackName}"/>
									</cells>
									<cells>
										<Text text="{fastAppData>RequestedVolume}"/>
									</cells>
									<cells>
										<Text text="{fastAppData>UOM}"/>
									</cells>
									<!--<cells>
										<Text text="{fastAppData>NetPrice}"/>
									</cells>
									<cells>
										<Text text="{fastAppData>OfferPrice}"/>
									</cells>
									<cells>
										<Text text="{fastAppData>COGS}"/>
									</cells>
									<cells>
										<Text text="{fastAppData>GrossSales}"/>
									</cells>
									<cells>
										<Text text="{fastAppData>NetSales}"/>
									</cells>
									<cells>
										<Text text="{fastAppData>Profitability}"/>
									</cells>-->
									<cells>
										<Text text="TBD"/>
									</cells>
									<cells>
										<Text text="TBD"/>
									</cells>
									<cells>
										<Text text="TBD"/>
									</cells>
									<cells>
										<Text text="TBD"/>
									</cells>
									<cells>
										<Text text="TBD"/>
									</cells>
									<cells>
										<Text text="TBD"/>
									</cells>
									
								</ColumnListItem>
							</items>
						</Table>
						
					</VBox>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	
	
	<!-- PRICING OFFER SUBSECTION -->
	<u:ObjectPageSubSection title="Pricing Offer" id="idFinPricingOfferSubsection">
		<l:BlockLayout background="Light">

			<!-- Selling -->
			<l:BlockLayoutRow visible="{= ${fastAppData>OfferType} === 'Selling'}">
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="2">
					<form:SimpleForm id="idSelling"
							editable="false"
							class="editableForm"
							layout="ResponsiveGridLayout"
							labelSpanXL="3"
							labelSpanL="3"
							labelSpanM="3"
							labelSpanS="12"
							adjustLabelSpan="false"
							emptySpanXL="4"
							emptySpanL="4"
							emptySpanM="4"
							emptySpanS="0"
							columnsXL="1"
							columnsL="1"
							columnsM="1"
							singleContainerFullSize="false" >
							<form:content>
								<Label text="Warranty" />
								<Input value="{fastAppData>Warranty}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/> <!-- visible="{= ${Division} === 'Radiology'}" -->
								<Label text="Status of device" /> <!-- visible="{= ${Division} === 'Radiology'}" -->
								<ComboBox
									visible="true" 
									enabled="false"
									items="{
										path: '/DummyCollection',
										sorter: { path: 'dummy' }
									}">
									<core:Item key="{key}" text="{text}" />
								</ComboBox>
								<Label text="Consumer Price (w/o VAT) per pack" />
								<Input value="{fastAppData>ConsumerPriceExclPP}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Consumer Price (with VAT) per pack" />
								<Input value="{fastAppData>ConsumerPriceInclPP}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Consumer Price (w/o VAT) per unit" />
								<Input value="{fastAppData>ConsumerPriceExclPU}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Consumer Price (with VAT) per unit" />
								<Input value="{fastAppData>ConsumerPriceInclPU}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Tax (VAT) per pack" />
								<Input value="{fastAppData>VatPerPack}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="Mandatory / Ex-factory discount" />
								<Input value="{fastAppData>MandatoryDiscount}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="I° confidential discount" />
								<Input value="{fastAppData>ConfidentialDiscount1}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="II° confidential discount" />
								<Input value="{fastAppData>ConfidentialDiscount2}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="Total Discount" />
								<Input value="{fastAppData>TotalDiscount}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="Max Price for NHS per pack w/o VAT" />
								<Input value="{fastAppData>MaxPriceNhsPP}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Max Price for NHS per unit w/o VAT" />
								<Input value="{fastAppData>MaxPriceNhsPU}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Additional Discount" />
								<Input value="{fastAppData>AdditionalDiscount}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="Total Discount" />
								<Input value="{fastAppData>TotalDiscount}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Free goods same product" />
								<Input value="{fastAppData>FreeGoodsSame}" visible="true" enabled="true" fieldWidth="80%"/>
								<Label text="Net Offer Price per pack" />
								<Input value="{fastAppData>NetOfferPricePP}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="Net Offer Price per unit" />
								<Input value="{fastAppData>NetOfferPricePU}" visible="true" enabled="false" fieldWidth="80%"/>
								<Label text="Free goods for other product(s)" />
								<MultiInput
									suggestionItems="{
										path: '/FreeGoodsOther',
										sorter: { path: 'ProductPackId' }
									}"
									valueHelpRequest="handleValueHelp">
									<core:Item key="{ProductId}" text="{Name}" />
								</MultiInput>
							</form:content>
						</form:SimpleForm>
				</l:BlockLayoutCell>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="4">
					<Table id="idProfitabilityTable" alternateRowColors="true" visible="false" ></Table>
					<viz:VizFrame id="idListToNetChart" uiConfig="{applicationSet:'fiori'}" height='20rem' width="100%" vizType='waterfall'
						vizProperties="{ title: {text : 'List-to-Net', visible : true}}" renderComplete="handleRenderComplete" legendVisible="false"></viz:VizFrame>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
			
			<!-- Rental -->
			<l:BlockLayoutRow visible="{= ${fastAppData>OfferType} === 'Rental'}">
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="2">
					<form:SimpleForm id="idRental"
							editable="false"
							class="editableForm"
							layout="ResponsiveGridLayout"
							labelSpanXL="3"
							labelSpanL="3"
							labelSpanM="3"
							labelSpanS="12"
							adjustLabelSpan="false"
							emptySpanXL="4"
							emptySpanL="4"
							emptySpanM="4"
							emptySpanS="0"
							columnsXL="1"
							columnsL="1"
							columnsM="1"
							singleContainerFullSize="false" >
							<form:content>
								<Label text="Warranty" />
								<Input value="{fastAppData>Warranty}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/> <!-- visible="{= ${Division} === 'Radiology'}" -->
								<Label text="Duration of agreement " />
								<Input value="{fastAppData>AgreementDuration}" visible="true" description="months" enabled="false" fieldWidth="80%"/>
								<Label text="Monthly rent" />
								<Input value="{fastAppData>MonthlyRent}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Months per invoice" />
								<Input value="{fastAppData>MonthsPerInvoice}" visible="true" description="months" enabled="false" fieldWidth="80%"/>
								<Label text="Contract start date" />
								<DatePicker 
									value="{
										path :'fastAppData>ContractStartDate', 
										type: 'sap.ui.model.type.Date', 
										formatOptions: { pattern: 'yyyy-MM-dd' , UTC:true}
									}" 
									enabled="false"/>
								<Label text="Value of devices" />
								<Input value="{fastAppData>ValueOfDevices}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Status of device" />
								<ComboBox
									visible="true" 
									enabled="false"
									items="{
										path: 'fastAppData>StatusOfDevice',
										sorter: { path: 'dummy' }
									}">
									<core:Item key="{key}" text="{text}" />
								</ComboBox>
								<Label text="free goods same product" />
								<Input value="{fastAppData>FreeGoodsSame}" visible="true" enabled="true" fieldWidth="80%"/>
								<Label text="free goods for other product(s)" />
								<MultiInput
									suggestionItems="{
										path: '{fastAppData>FreeGoodsOther}',
										sorter: { path: 'Name' }
									}"
									valueHelpRequest="handleValueHelp">
									<core:Item key="{ProductId}" text="{Name}" />
								</MultiInput>
							</form:content>
						</form:SimpleForm>
				</l:BlockLayoutCell>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="4">
					<Table id="idProfitabilityTable2" alternateRowColors="true" visible="false" ></Table>
					<viz:VizFrame id="idListToNetChart2" uiConfig="{applicationSet:'fiori'}" height='20rem' width="100%" vizType='waterfall'
						vizProperties="{ title: {text : 'List-to-Net', visible : true}}" renderComplete="handleRenderComplete" legendVisible="false"></viz:VizFrame>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>

			<!-- Comodato -->
			<l:BlockLayoutRow visible="{= ${fastAppData>OfferType} === 'Comodato'}">
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="2">
					<form:SimpleForm id="idComodato"
							editable="false"
							class="editableForm"
							layout="ResponsiveGridLayout"
							labelSpanXL="3"
							labelSpanL="3"
							labelSpanM="3"
							labelSpanS="12"
							adjustLabelSpan="false"
							emptySpanXL="4"
							emptySpanL="4"
							emptySpanM="4"
							emptySpanS="0"
							columnsXL="1"
							columnsL="1"
							columnsM="1"
							singleContainerFullSize="false" >
							<form:content>
								<Label text="Warranty" />
								<Input value="{Warranty}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/> <!-- visible="{= ${Division} === 'Radiology'}" -->
								<Label text="Duration of agreement " />
								<Input value="3" visible="true" description="months" enabled="false" fieldWidth="80%"/>
								<Label text="Minimum contractual commitment" />
								<Input value="2" visible="true" description="years" enabled="false" fieldWidth="80%"/>
								<Label text="Minimum annual purchase amount" />
								<Input value="66.36" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Contract start date" />
								<DatePicker 
									value="{
										path :'ctr>/currentContract/contractDate', 
										type: 'sap.ui.model.type.Date', 
										formatOptions: { pattern: 'yyyy-MM-dd' , UTC:true}
									}" 
									enabled="false"/>
								<Label text="Value of devices" />
								<Input value="{fastAppData>ValueOfDevices}" visible="true" description="EUR" enabled="false" fieldWidth="80%"/>
								<Label text="Status of device" />
								<ComboBox
									visible="true" 
									enabled="false"
									items="{
										path: '/DummyCollection',
										sorter: { path: 'dummy' }
									}">
									<core:Item key="{key}" text="{text}" />
								</ComboBox>
								<Label text="free goods for other product(s)" />
								<MultiInput
									suggestionItems="{
										path: '/ProductCollection',
										sorter: { path: 'Name' }
									}"
									valueHelpRequest="handleValueHelp">
									<core:Item key="{ProductId}" text="{Name}" />
								</MultiInput>
							</form:content>
						</form:SimpleForm>
				</l:BlockLayoutCell>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA" width="4">
					<Table id="idProfitabilityTable3" alternateRowColors="true" visible="false" ></Table>
					<viz:VizFrame id="idListToNetChart3" uiConfig="{applicationSet:'fiori'}" height='20rem' width="100%" vizType='waterfall'
						vizProperties="{ title: {text : 'List-to-Net', visible : true}}" renderComplete="handleRenderComplete" legendVisible="false"></viz:VizFrame>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>

		</l:BlockLayout>
	</u:ObjectPageSubSection>

	
	<!-- TENDER HISTORY SUBSECTION -->
	<u:ObjectPageSubSection id="FinTenderHistorySubsection" title="Tender History">
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<Table id="tenderHistoryId" inset="false">
						<headerToolbar>
							<Toolbar>
								<content>
									<ToolbarSpacer/>
									<CheckBox id="currentCountryCheckId" text="{i18n>CurrentCountry}" selected="true" select=".onHistoryFilterCheck"
											  visible="{= ${fastAppData>/Tender/CountryCode} !== 'AR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'CL' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'MX' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'BR' &amp;&amp; ${fastAppData>/Tender/CountryCode} !== 'TH' ? true : false }"/>
									<CheckBox id="currentInstituteCheckId" text="{i18n>CurrentInstitute}" selected="true" select=".onHistoryFilterCheck"/>
									<CheckBox id="parentInstituteCheckId" text="{i18n>ParentInstitute}" selected="false" select=".onHistoryFilterCheck"/>
									<CheckBox id="wonCheckId" text="{i18n>Won}" selected="true" select=".onHistoryFilterCheck"/>
									<CheckBox id="lossCheckId" text="{i18n>Loss}" selected= "false" select=".onHistoryFilterCheck"/>
								</content>
							</Toolbar>
						</headerToolbar>
						<columns>
							<Column>
								<Text text="{i18n>TenderID}"/>
							</Column>
							<Column>
								<Text text="{i18n>Tender}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>OfferID}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>OfferDate}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>InstituteName}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>Product}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>UnitPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>PackPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>NetUnitPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>NetPackPrice}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>UnitPack}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>FOC}"/>
							</Column>
							<Column minScreenWidth="Tablet" demandPopin="true">
								<Text text="{i18n>Status}"/>
							</Column>
						</columns>
					</Table>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>
	</u:ObjectPageSubSection>
	
</mvc:View>