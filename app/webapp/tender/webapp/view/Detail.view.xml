				<!--		<m:FlexItemData growFactor="1"/>-->
				<!--	</m:layoutData>-->
				<!--</m:PDFViewer>-->
				<!--			</m:FlexBox>-->
				<!--		</m:ScrollContainer>-->
				<!--	</blocks>-->
				<!--</ObjectPageSubSection>-->
				</subSections>
			</ObjectPageSection>
			
			
			
			<!-- TENDER RESULTS TAB -->
			<ObjectPageSection id="tenderResultsId" title="{i18n>TenderResults}">
				
				<subSections>
					
					<ObjectPageSubSection id="TenderResNoOfferSubsection" title="{i18n>TenderResults}">
						<l:BlockLayout background="Light">
							<l:BlockLayoutRow>
								<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
									<m:VBox>
										<m:FormattedText htmlText="Offer not available for tender results..."/>
									</m:VBox>
								</l:BlockLayoutCell>
							</l:BlockLayoutRow>
						</l:BlockLayout>
					</ObjectPageSubSection>
					
					<!-- TENDER OFFER SUB SECTION PAGE -->
					<ObjectPageSubSection id="TenderResOfferSubsection" title="Tender Offer" visible="false">
						<l:BlockLayout background="Light">
							<l:BlockLayoutRow>
								<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
									<m:VBox>
										
										<m:Label/>
										
									</m:VBox>
								</l:BlockLayoutCell>
							</l:BlockLayoutRow>
						</l:BlockLayout>
					</ObjectPageSubSection>
					
					<ObjectPageSubSection id="TenderResOfferAwardedComp" title="Tender Results">
						<!-- outcome awarded companies -->
						
						<blocks>
							<!-- REMARK! As described here (https://github.com/SAP/openui5/issues/1822)
								filter has no effect when 
								sorter: [{path: 'SORTER', descending: false}],
								filters: [ 
									{ path : 'Active', operator : 'EQ', value1 : '1'},   
									{ path : 'ActiveProduct', operator : 'NE', value1 : '2'}, 
									{ path : '_sOperation', operator : 'NE', value1 : 'DELETE'}
								]}" 
							-->
							<m:VBox>
								<m:Title text="Outcome Awarded Companies" />
							
								<t:TreeTable
									id="idOutcomeTable"
									rows="{
										path : 'fastAppData>/ResultsForTree/',
										parameters: {
											arrayNames:['OutcomeLevel'],
											numberOfExpandedLevels: 1 }
										}" 
									selectionMode="Single"
									enableSelectAll="false"
									ariaLabelledBy="title">
									<t:extension>
										<m:OverflowToolbar>
											<m:Button id="btnAddAwardProduct" text="Add awarded product" icon="sap-icon://add" press="onAddAwardedProduct" enabled="{= ${fastAppData>/EditMode} === true ? true : false}"/>
											<m:Button id="btnDeleteAwardProduct" text="Remove awarded product" icon="sap-icon://delete" press="onDeleteAwardedProduct" enabled="{= ${fastAppData>/EditMode} === true ? true : false}"/>
											<m:ToolbarSpacer/>
											<m:Button text="Collapse all" press="onCollapseOutcome"/>
											<m:Button text="Expand all" press="onExpandOutcome"/>
										</m:OverflowToolbar>
									</t:extension>
									<t:columns>
										<t:Column width="16rem">
											<m:Label text="Product"/>
											<t:template>
												<m:Input id="resultsForTreeProduct" value="{fastAppData>PRODUCT}" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}"/>
											</t:template>
										</t:Column>
										<t:Column width="13rem">
											<m:Label text="Awarded Company"/>
											<t:template>
												<m:Input id="resulsForTreeAwardedCompany" value="{fastAppData>AWARDEDCOMPANY}" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' &amp;&amp; ${fastAppData>_sOperation} === 'POST' ? true : false}"/>
											</t:template>
										</t:Column>
										<t:Column width="9rem">
											<m:Label text="Awarded Price"/>
											<t:template>
												<m:Input type="Number" id="resultsForTreeAwardedPrice" value="{fastAppData>AWARDEDPRICE}" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}" liveChange="onAwardedQtyLiveChange" change="onAwardedQtyChange"/>
											</t:template>
										</t:Column>
										<t:Column width="7rem">
											<m:Label text="Currency"/>
											<t:template>
												<m:Select id="resultsForTreeCurrency" selectedKey="{fastAppData>CURRENCY}" items="{ path: 'fastAppData>/CountryCurrency/', templateShareable: false, sorter: { path: 'COUNTRY_CODE' } }" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}">
													<core:Item key="{fastAppData>CURRENCY}" text="{fastAppData>CURRENCY}"/>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="9rem">
											<m:Label text="Requested Volume"/>
											<t:template>
												<m:Input type="Number" id="resultsForTreeRequestedVol" value="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? ${fastAppData>REQUESTEDVOLUME} : ''  }" enabled="false"/>
											</t:template>
										</t:Column>
										<t:Column width="9rem">
											<m:Label text="FOC"/>
											<t:template>
												<m:Input id="resultsForTreeFoc" value="{ parts:[ 
																							{ path: 'fastAppData>AWARDEDCOMPANY'}, 
																							{ path: 'fastAppData>FOC'}, 
																							{ path: 'fastAppData>FOC_ABS_PCT'},
																							{ path: 'fastAppData>FOCTYPE'}, 
																							{ path: 'fastAppData>UNITPERPACK'} 
																						 ], formatter: '.formatter.focQuotation'}" enabled="false"/>
											</t:template>
										</t:Column>
										<t:Column width="7rem">
											<m:Label text="Awarded Qty"/>
											<t:template>
												<m:Input type="Number" id="resultsForTreeAwardedQty" value="{fastAppData>AWARDEDQTY}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}" />
											</t:template>
										</t:Column>
										<t:Column width="6rem">
											<m:Label text="UoM"/>
											<t:template>
												<m:Select id="resultsForTreeUom" selectedKey="{fastAppData>UOM}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}">
	                                                <m:items>
	                                                    <core:Item text="Unit" key="Unit"/>
	                                                    <core:Item text="Pack" key="Pack"/>
	                                                </m:items>
	                                            </m:Select>
											</t:template>
										</t:Column>
										<t:Column width="7rem">
											<m:Label text="Subm. Error"/>
											<t:template>
												<!--<m:Input value="{fastAppData>ERRORINSUBMISSION}" editable="false"/>-->
												<m:Select id="resultsForTreeError" selectedKey="{fastAppData>ERRORINSUBMISSION}" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? true : false}">
													<m:items>
														<core:Item text="" key=""/>
														<core:Item text="No" key="No"/>
														<core:Item text="Yes" key="Yes"/>
													</m:items>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="9rem">
											<m:Label text="Outcome"/>
											<t:template>
												<!--<m:Input value="{fastAppData>OUTCOME}" editable="false"/>-->
												<m:Select id="resultsForTreeOutcome" selectedKey="{fastAppData>OUTCOME}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}" change="onChangeOutcome" width="20rem">
													<m:items>
														<core:Item text="" key=""/>
														<core:Item text="Decision Pending" key="Decision Pending"/>
														<core:Item text="Won" key="Won"/>
														<core:Item text="Lost" key="Lost"/>
														<core:Item text="Cancelled" key="Cancelled"/>
													</m:items>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="14rem">
											<m:Label text="Reason"/>
											<t:template>
												<m:Select id="resultsForTreeReason" selectedKey="{fastAppData>REASON}" items="{ path: 'fastAppData>LISTOUTCOMEREASONS/', templateShareable: false, sorter: { path: 'TenderOutcomeReasons' } }" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; (${fastAppData>OUTCOME} === 'Won' || ${fastAppData>OUTCOME} === 'Lost') ? true : false}">
														<core:Item key="{fastAppData>TenderOutcomeReasons}" text="{fastAppData>TenderOutcomeReasons}"/>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="14rem">
											<m:Label text="Comment"/>
											<t:template>
												<m:Input id="resultsForTreeComment" value="{fastAppData>COMMENT}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}"/>
											</t:template>
										</t:Column>
									</t:columns>
								</t:TreeTable>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			
			
			<!-- DELIVERY TRACKING TAB -->
			<ObjectPageSection id="deliveryTrackingId" title="{i18n>DeliveryTracking}">
				<subSections>
					<ObjectPageSubSection id="deliveryTrackingSubSectionId">
						<mvc:XMLView id="deliveryTrackingViewId" viewName="FAST_NS0FAST0.view.DeliveryTracking"/>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
		
		<!-- footer action buttons -->
		<footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer />
				<m:Button type="Accept" text="{i18n>Save}" press=".onSaveButtonPress"/>
				<m:Button type="Reject" text="{i18n>Cancel}" press=".onCancelButtonPress"/>
			</m:OverflowToolbar>
		</footer>
		
	</ObjectPageLayout>
</mvc:View>