<mvc:View id="TenderDetailViewId" controllerName="FAST_NS0FAST0.controller.Detail" 
	xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	
	<!-- ObjectPage Layout -->
	<ObjectPageLayout 
		id="DetailPage" 
		showTitleInHeaderContent="true" 
		alwaysShowContentHeader="true" 
		preserveHeaderStateOnScroll="false"
		headerContentPinnable="true" 
		isChildPage="true" 
		toggleHeaderOnTitleClick="true" 
		showFooter="true" 
		upperCaseAnchorBar="false"
		enableLazyLoading="false" 
		useIconTabBar="true" 
		navigate="onNavigate"
		selectedSection="basicInformationId"
		showAnchorBarPopover="false">
		
		<!-- APP TITLE & NAVIGATION BUTTONS -->
		<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				
				<!-- Heading part that is used when heading is not collapsed -->
				<expandedHeading>
					<m:Title text="{fastData>TenderID}" id="tenderId" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>
				
				<!-- Heading part that is always visible also when collapsed -->
				<snappedHeading>
					<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Center">
						<m:FlexBox wrap="NoWrap" fitContainer="true" alignItems="Center" class="sapUiTinyMarginEnd" >
							
							<!-- LOGO 
							<m:VBox fitContainer="true">
								<f:Avatar src="{imageModel>/path}/Company-Logo-Blue.svg" displaySize="S" displayShape="Square" class="sapUiTinyMarginEnd"/>
							</m:VBox>
							-->
							
							<!-- Selected tender ID & offer ID + product Name is always visible -->
							<m:VBox alignItems="Start" justifyContent="Start" fitContainer="true">
								<m:items>
									
									<m:Title text="{fastData>TenderID}" wrapping="true"/>
									
									<!-- Offer & Product next to each other -->
									<m:HBox>
										<m:items>
											
											<!-- Offer -->
											<m:VBox> 
												<m:items>
													<m:Label text="{i18n>OfferID}:" labelFor="selectedOfferIDinHeading" />
													<m:Text id="selectedOfferIDinHeading" text="{= ${fastAppData>/SelectedOfferID} === '' ? 'No offer selected' : ${fastAppData>/SelectedOfferID} }"/>
												</m:items>
											</m:VBox>

											<!-- Empty -->
											<m:VBox> 
												<m:items>
													<m:Label text="" width="8rem"/>
												</m:items>
											</m:VBox>
											
											<!-- product -->
											<m:VBox>
												<m:items>
													<m:Label text="{i18n>productnme}:" labelFor="selectedProductNameinHeading"/>
													<m:Text id="selectedProductNameinHeading" text="{= ${fastAppData>/SelectedProductName} === '' ? 'No product selected' : ${fastAppData>/SelectedProductName} }"/>													
												</m:items>
											</m:VBox>
											
											<!-- Empty -->
											<m:VBox> 
												<m:items>
													<m:Label text="" width="8rem"/>
												</m:items>
											</m:VBox>
											
											<!-- product -->
											<m:VBox visible="{= ${fastData>Origin/CODE} === 'NA' ?  false : true }" >
												<m:items>
													<m:Label text="{i18n>tenderOrigin}:" labelFor="selectedOrigininHeading"  />
													<m:Text id="selectedOrigininHeading" text="{fastData>Origin/CODE}"/>													
												</m:items>
											</m:VBox>
											

											
										</m:items>
									</m:HBox>
									
								</m:items>
							</m:VBox>
						</m:FlexBox>
					</m:FlexBox>
				</snappedHeading>
				
				<!-- WINDOW ACTIONS -->
				<navigationActions>
					<m:OverflowToolbarButton id="enterFullScreenButton" type="Transparent" icon="sap-icon://full-screen" press=".handleFullScreen"
						tooltip="Enter Full Screen Mode" visible="true"/>
					<m:OverflowToolbarButton id="exitFullScreenButton" type="Transparent" icon="sap-icon://exit-full-screen" press=".handleExitFullScreen"
						tooltip="Exit Full Screen Mode" visible="true"/>
					<m:OverflowToolbarButton id="closeScreenButton" type="Transparent" icon="sap-icon://decline" press=".handleClose" tooltip="Close column"
						visible="true"/>
				</navigationActions>
				
				<!-- ACTIONS -->
				<actions>
					<m:Button id="deleteTenderButtonId" icon="sap-icon://delete" text="Delete" type="Reject" press="onDeleteTenderPress" enabled="true" />
					<m:Button id="cloneButtonId" icon="sap-icon://copy" text="Clone" enabled="true" type="Accept" press="onCloneButtonPress"/>
					<m:Button id="folderButtonId" icon="sap-icon://browse-folder" text="Documents" type="Emphasized" press="._onFolderButtonPress" visible="{= ${fastData>FoldersCreated} === 1}"/>
					<m:Button id="refreshButtonId" icon="sap-icon://refresh" type="Emphasized" press="onRefresh" enabled="true"/>
					<!--<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditButtonPress" enabled="true"/>-->
					<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditButtonPress" enabled="true}"/>
				</actions>
				
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>
		
		<!-- HEADER INFORMATION: this part will be collapsed when scrolling down -->
		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
				
				<!-- LOGO 
				<f:Avatar src="{imageModel>/path}/Company-Logo-Blue.svg" displaySize="L" displayShape="Square" class="sapUiTinyMarginEnd"></f:Avatar>
				-->
				
				<!-- INSTITUTE INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>Institute}"/>
					<m:Text id="idhdrInstNme" text="{fastData>Institute/InstituteName}"/>
					<m:Text id="idhdrInstID" text="{fastData>Institute/InstituteID}" visible="false"/>
				</m:VBox>
				
				<!-- SELECTED TENDER INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>TenderName}"/>
					<m:Text id="idHdrTndrNme" text="{fastData>TenderName}"/>
				</m:VBox>
				
				<!-- SELECTED OFFER INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>OfferID}"/>
					<m:Text  text="{= ${fastAppData>/SelectedOfferID} === '' ? 'No offer selected' : ${fastAppData>/SelectedOfferID} }"/>
				</m:VBox>

				<!-- SELECTED PRODUCT INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>productnme}"/>
					<m:Text text="{= ${fastAppData>/SelectedProductName} === '' ? 'No product selected' : ${fastAppData>/SelectedProductName} }"/>
				</m:VBox>				
				
				<!-- Tender origin -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd" visible="{= ${fastData>Origin/CODE} === 'NA' ? false : true }">
				<!--<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd" visible="{= ${fastAppData>/CountryTenderOrigin/length} > 2 ? true : false}">-->
					<m:Label text="{i18n>tenderOrigin}:"/>
					<m:Text text="{fastData>Origin/CODE}"/>		
				</m:VBox>
				
			</m:FlexBox>
		</headerContent>
		
		<!-- TABS -->
		<sections>
			
			<!-- BASIC INFORMATION TAB -->
			<ObjectPageSection id="basicInformationId" title="{i18n>basicInformation}" visible="{fastAppData>/permissions/tabs/basicInformationId/visible}">
				<subSections>
					<ObjectPageSubSection id="basicInformationSubSectionId">
						<core:Fragment fragmentName="FAST_NS0FAST0.view.BasicInformationView" type="XML" id="basicInformationFragmentId"></core:Fragment>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			
			<!-- OFFER PRODUCTS TAB -->
			<ObjectPageSection id="offerProductsId" title="{i18n>OfferProducts}" showTitle="true" visible="{fastAppData>/permissions/tabs/offerProductsId/visible}">
				<subSections>
					<core:Fragment fragmentName="FAST_NS0FAST0.view.OfferProductsView" type="XML" id="offerProductsFragmentId"></core:Fragment>
				</subSections>
			</ObjectPageSection>
			
			<!-- FINANCIAL OFFER TAB -->
			<ObjectPageSection id="financialOfferId" title="{i18n>FinancialOffer}" showTitle="true" visible="{fastAppData>/permissions/tabs/financialOfferId/visible}">
				<subSections>
					<core:Fragment fragmentName="FAST_NS0FAST0.view.FinancialOfferView" type="XML" id="financialOfferFragmentId"></core:Fragment>
				</subSections>
			</ObjectPageSection>
			
			<!-- QUOTATION TAB -->
			<ObjectPageSection id="quotationId" title="{i18n>Quotation}" visible="{fastAppData>/permissions/tabs/quotationId/visible}">
				<subSections>
					<core:Fragment id="quotationFragmentId" type="XML" fragmentName="FAST_NS0FAST0.view.QuotationView"/>
				</subSections>
			</ObjectPageSection>
			
			<!-- TENDER RESULTS TAB -->
			<ObjectPageSection id="tenderResultsId" title="{i18n>TenderResults}" visible="{fastAppData>/permissions/tabs/tenderResultsId/visible}">

				<subSections>

					<ObjectPageSubSection id="TenderResNoOfferSubsection" title="{i18n>TenderResults}">
						<l:BlockLayout background="Light">
							<l:BlockLayoutRow>
								<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
									<m:VBox>
										<m:FormattedText htmlText="Offer not available for tender results..."/>
									</m:VBox>
								</l:BlockLayoutCell>
							</l:BlockLayoutRow>
						</l:BlockLayout>
					</ObjectPageSubSection>

					<!-- TENDER OFFER SUB SECTION PAGE -->
					<ObjectPageSubSection id="TenderResOfferSubsection" title="Tender Offer" visible="false">
						<l:BlockLayout background="Light">
							<l:BlockLayoutRow>
								<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
									<m:VBox>

										<m:Label/>

									</m:VBox>
								</l:BlockLayoutCell>
							</l:BlockLayoutRow>
						</l:BlockLayout>
					</ObjectPageSubSection>

					<ObjectPageSubSection id="TenderResOfferAwardedComp" title="Tender Results">
						<!-- outcome awarded companies -->

						<blocks>
							<!-- REMARK! As described here (https://github.com/SAP/openui5/issues/1822)
								filter has no effect when 
								sorter: [{path: 'SORTER', descending: false}],
								filters: [ 
									{ path : 'Active', operator : 'EQ', value1 : '1'},   
									{ path : 'ActiveProduct', operator : 'NE', value1 : '2'}, 
									{ path : '_sOperation', operator : 'NE', value1 : 'DELETE'}
								]}" 
							-->
							<m:VBox>
								<m:Title text="Outcome Awarded Companies" />

								<t:TreeTable
									id="idOutcomeTable"
									rows="{
										path : 'fastAppData>/ResultsForTree/',
										parameters: {
											arrayNames:['OutcomeLevel'],
											numberOfExpandedLevels: 1 }
										}" 
									selectionMode="Single"
									enableSelectAll="false"
									ariaLabelledBy="title">
									<t:extension>
										<m:OverflowToolbar>
											<m:Button id="btnAddAwardProduct" text="Add awarded product" icon="sap-icon://add" press="onAddAwardedProduct" enabled="{= ${fastAppData>/EditMode} === true ? true : false}"/>
											<m:Button id="btnDeleteAwardProduct" text="Remove awarded product" icon="sap-icon://delete" press="onDeleteAwardedProduct" enabled="{= ${fastAppData>/EditMode} === true ? true : false}"/>
											<m:ToolbarSpacer/>
											<m:Button text="Collapse all" press="onCollapseOutcome"/>
											<m:Button text="Expand all" press="onExpandOutcome"/>
										</m:OverflowToolbar>
									</t:extension>
									<t:columns>
										<t:Column width="13rem">
											<m:Label text="ContractNo"/>
											<t:template>
												<m:Input id="resultsForTreeContractNo" value="{fastAppData>CONTRACT_NO}" visible="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' }" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} === 'Bayer'}"/>
											</t:template>
										</t:Column>

										<t:Column width="13rem">
											<m:Label text="Awarded Company"/>
											<t:template>
												<m:VBox>
													<m:Input value="{fastAppData>AWARDEDCOMPANY}" 
															 enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}"
															 visible="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? true : false}"/>

													<m:Select selectedKey="{fastAppData>AWARDEDCOMPANYCOMP}" 
															  enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}"
															  items="{
																  path: 'fastAppData>/CountryCompetitors/'
															  }"
															  visible="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? false : true}"
															  change="onChangeAwardedCompanyCompetitor">
														<m:items>
															<core:Item text="{fastAppData>CompetitorCompany}" key="{fastAppData>CompetitorCompany}"/>
														</m:items>
													</m:Select>

													<m:Input 
																value="{fastAppData>OTHERCOMPANY}" 
																enabled="{= ${fastAppData>/EditMode} === true &amp;&amp;  ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false }"
																visible="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? false : true &amp;&amp; ${fastAppData>AWARDEDCOMPANYCOMP} === 'Other' }"/>
												</m:VBox>
											</t:template>
										</t:Column>

										<t:Column width="16rem">
											<m:Label text="Product"/>
											<t:template>
												<m:VBox>
													<m:items>
														<m:Input 
																value="{fastAppData>PRODUCT}" 
																enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}"
																visible="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? true : false}"/>

														 <m:Select 
																selectedKey="{fastAppData>PRODUCTCOMP}" 
																enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}"
																items="{ path: 'fastAppData>/CountryCompetitors/'}"
																visible="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? false : true}"
																change="onChangeAwardedProductCompetitor">
															<m:items>
																<core:Item text="{fastAppData>CompetitorProduct}" key="{fastAppData>CompetitorProduct}"/>
															</m:items>
														</m:Select>

														<m:Input 
																value="{fastAppData>OTHERPRODUCT}" 
																enabled="{= ${fastAppData>/EditMode} === true &amp;&amp;  ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false }"
																visible="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? false : true &amp;&amp; ${fastAppData>PRODUCTCOMP} === 'Other' }"/>
													</m:items>
												</m:VBox>
											</t:template>

										</t:Column>
										
										<t:Column width="9rem">
											<m:Label text="Awarded Price"/>
											<t:template>
												<m:Input type="Number" id="resultsForTreeAwardedPrice" value="{fastAppData>AWARDEDPRICE}" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}" liveChange="onAwardedQtyLiveChange" change="onAwardedQtyChange"/>
											</t:template>
										</t:Column>
										<t:Column width="7rem">
											<m:Label text="Currency"/>
											<t:template>
												<m:Select id="resultsForTreeCurrency" selectedKey="{fastAppData>CURRENCY}" items="{ path: 'fastAppData>/CountryCurrency/', templateShareable: false, sorter: { path: 'COUNTRY_CODE' } }" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} !== 'Bayer' ? true : false}">
													<core:Item key="{fastAppData>CURRENCY}" text="{fastAppData>CURRENCY}"/>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="9rem">
											<m:Label text="Requested Volume"/>
											<t:template>
												<m:Input type="Number" id="resultsForTreeRequestedVol" value="{= ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? ${fastAppData>REQUESTEDVOLUME} : ''  }" enabled="false"/>
											</t:template>
										</t:Column>
										<t:Column width="9rem">
											<m:Label text="FOC"/>
											<t:template>
												<m:Input id="resultsForTreeFoc" value="{ parts:[ 
																							{ path: 'fastAppData>AWARDEDCOMPANY'}, 
																							{ path: 'fastAppData>FOC'}, 
																							{ path: 'fastAppData>FOC_ABS_PCT'},
																							{ path: 'fastAppData>FOCTYPE'}, 
																							{ path: 'fastAppData>UNITPERPACK'} 
																						 ], formatter: '.formatter.focQuotation'}" enabled="false"/>
											</t:template>
										</t:Column>
										<t:Column width="7rem">
											<m:Label text="Awarded Qty"/>
											<t:template>
												<m:Input type="Number" id="resultsForTreeAwardedQty" value="{fastAppData>AWARDEDQTY}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}" />
											</t:template>
										</t:Column>
										<t:Column width="6rem">
											<m:Label text="UoM"/>
											<t:template>
												<m:Select id="resultsForTreeUom" selectedKey="{fastAppData>UOM}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}">
	                                                <m:items>
	                                                    <core:Item text="Unit" key="Unit"/>
	                                                    <core:Item text="Pack" key="Pack"/>
	                                                </m:items>
	                                            </m:Select>
											</t:template>
										</t:Column>
										<t:Column width="7rem">
											<m:Label text="Subm. Error"/>
											<t:template>
												<!--<m:Input value="{fastAppData>ERRORINSUBMISSION}" editable="false"/>-->
												<m:Select id="resultsForTreeError" selectedKey="{fastAppData>ERRORINSUBMISSION}" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; ${fastAppData>AWARDEDCOMPANY} === 'Bayer' ? true : false}">
													<m:items>
														<core:Item text="" key=""/>
														<core:Item text="No" key="No"/>
														<core:Item text="Yes" key="Yes"/>
													</m:items>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="9rem">
											<m:Label text="Outcome"/>
											<t:template>
												<!--<m:Input value="{fastAppData>OUTCOME}" editable="false"/>-->
												<m:Select id="resultsForTreeOutcome" selectedKey="{fastAppData>OUTCOME}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}" change="onChangeOutcome" width="20rem">
													<m:items>
														<core:Item text="" key=""/>
														<core:Item text="Decision Pending" key="Decision Pending"/>
														<core:Item text="FOC negotiation" key="FOC negotiation"/>
														<core:Item text="Won" key="Won"/>
														<core:Item text="Lost" key="Lost"/>
														<core:Item text="Cancelled" key="Cancelled"/>
													</m:items>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="14rem">
											<m:Label text="Reason"/>
											<t:template>
												<m:Select id="resultsForTreeReason" selectedKey="{fastAppData>REASON}" items="{ path: 'fastAppData>LISTOUTCOMEREASONS/', templateShareable: false, sorter: { path: 'TenderOutcomeReasons' } }" enabled="{= ${fastAppData>/EditMode} === true &amp;&amp; (${fastAppData>OUTCOME} === 'Won' || ${fastAppData>OUTCOME} === 'Lost') ? true : false}">
														<core:Item key="{fastAppData>TenderOutcomeReasons}" text="{fastAppData>TenderOutcomeReasons}"/>
												</m:Select>
											</t:template>
										</t:Column>
										<t:Column width="14rem">
											<m:Label text="Comment"/>
											<t:template>
												<m:Input id="resultsForTreeComment" value="{fastAppData>COMMENT}" enabled="{= ${fastAppData>/EditMode} === true ? true : false}"/>
											</t:template>
										</t:Column>
									</t:columns>
								</t:TreeTable>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
						
			<!-- DELIVERY TRACKING TAB -->
			<ObjectPageSection id="deliveryTrackingId" title="{i18n>DeliveryTracking}" visible="{fastAppData>/permissions/tabs/deliveryTrackingId/visible}">
				<subSections>
					<ObjectPageSubSection id="deliveryTrackingSubSectionId">
						<mvc:XMLView id="deliveryTrackingViewId" viewName="FAST_NS0FAST0.view.DeliveryTracking"/>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
		
		<!-- footer action buttons -->
		<footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer />
				<m:Button type="Accept" text="{i18n>Save}" press=".onSaveButtonPress"/>
				<m:Button type="Reject" text="{i18n>Cancel}" press=".onCancelButtonPress"/>
			</m:OverflowToolbar>
		</footer>
		
	</ObjectPageLayout>
</mvc:View>