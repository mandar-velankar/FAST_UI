														text="{i18n>SubmitQuotation}"
														icon="sap-icon://sys-enter"
														press=".onSubmitQuotation"
														enabled="false"/>
											</m:OverflowToolbar>
										</m:headerToolbar>-->
										<!-- TABLE WITH TENDER OFFERS - filter on not e{ path : 'OfferStatus/STATUS', operator : 'NE', value1 : 'Tender Recorded'} -->
										<!-- <m:content>
											<m:Table id="quotationOffersTableViewID"
