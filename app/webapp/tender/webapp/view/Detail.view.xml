<mvc:View id="TenderDetailViewId" controllerName="FAST_NS0FAST0.controller.Detail" 
	xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	
	<!-- ObjectPage Layout -->
	<ObjectPageLayout 
		id="DetailPage" 
		showTitleInHeaderContent="true" 
		alwaysShowContentHeader="true" 
		preserveHeaderStateOnScroll="false"
		headerContentPinnable="true" 
		isChildPage="true" 
		toggleHeaderOnTitleClick="true" 
		showFooter="true" 
		upperCaseAnchorBar="false"
		enableLazyLoading="false" 
		useIconTabBar="true" 
		navigate="onNavigate"
		selectedSection="basicInformationId"
		showAnchorBarPopover="false">
		
		<!-- APP TITLE & NAVIGATION BUTTONS -->
		<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				
				<!-- Heading part that is used when heading is not collapsed -->
				<expandedHeading>
					<m:Title text="{fastData>TenderID}" id="tenderId" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>
				
				<!-- Heading part that is always visible also when collapsed -->
				<snappedHeading>
					<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Center">
						<m:FlexBox wrap="NoWrap" fitContainer="true" alignItems="Center" class="sapUiTinyMarginEnd" >
							
							<!-- LOGO 
							<m:VBox fitContainer="true">
								<f:Avatar src="{imageModel>/path}/Company-Logo-Blue.svg" displaySize="S" displayShape="Square" class="sapUiTinyMarginEnd"/>
							</m:VBox>
							-->
							
							<!-- Selected tender ID & offer ID + product Name is always visible -->
							<m:VBox alignItems="Start" justifyContent="Start" fitContainer="true">
								<m:items>
									
									<m:Title text="{fastData>TenderID}" wrapping="true"/>
									
									<!-- Offer & Product next to each other -->
									<m:HBox>
										<m:items>
											
											<!-- Offer -->
											<m:VBox> 
												<m:items>
													<m:Label text="{i18n>OfferID}:" labelFor="selectedOfferIDinHeading" />
													<m:Text id="selectedOfferIDinHeading" text="{= ${fastAppData>/SelectedOfferID} === '' ? 'No offer selected' : ${fastAppData>/SelectedOfferID} }"/>
												</m:items>
											</m:VBox>

											<!-- Empty -->
											<m:VBox> 
												<m:items>
													<m:Label text="" width="8rem"/>
												</m:items>
											</m:VBox>
											
											<!-- product -->
											<m:VBox>
												<m:items>
													<m:Label text="{i18n>productnme}:" labelFor="selectedProductNameinHeading"/>
													<m:Text id="selectedProductNameinHeading" text="{= ${fastAppData>/SelectedProductName} === '' ? 'No product selected' : ${fastAppData>/SelectedProductName} }"/>													
												</m:items>
											</m:VBox>
											
											<!-- Empty -->
											<m:VBox> 
												<m:items>
													<m:Label text="" width="8rem"/>
												</m:items>
											</m:VBox>
											
											<!-- product -->
											<m:VBox visible="{= ${fastAppData>/Tender/CountryCode} === 'MX' ? true : false }" >
												<m:items>
													<m:Label text="{i18n>tenderOrigin}:" labelFor="selectedOrigininHeading" />
													<m:Text id="selectedOrigininHeading" text="{fastData>Origin/CODE}"/>													
												</m:items>
											</m:VBox>
											

											
										</m:items>
									</m:HBox>
									
								</m:items>
							</m:VBox>
						</m:FlexBox>
					</m:FlexBox>
				</snappedHeading>
				
				<!-- WINDOW ACTIONS -->
				<navigationActions>
					<m:OverflowToolbarButton id="enterFullScreenButton" type="Transparent" icon="sap-icon://full-screen" press=".handleFullScreen"
						tooltip="Enter Full Screen Mode" visible="true"/>
					<m:OverflowToolbarButton id="exitFullScreenButton" type="Transparent" icon="sap-icon://exit-full-screen" press=".handleExitFullScreen"
						tooltip="Exit Full Screen Mode" visible="true"/>
					<m:OverflowToolbarButton id="closeScreenButton" type="Transparent" icon="sap-icon://decline" press=".handleClose" tooltip="Close column"
						visible="true"/>
				</navigationActions>
				
				<!-- ACTIONS -->
				<actions>
					<m:Button id="deleteTenderButtonId" icon="sap-icon://delete" text="Delete" type="Reject" press="onDeleteTenderPress" enabled="true" />
					<m:Button id="cloneButtonId" icon="sap-icon://copy" text="Clone" enabled="true" type="Accept" press="onCloneButtonPress"/>
					<m:Button id="folderButtonId" icon="sap-icon://browse-folder" text="Documents" type="Emphasized" press="._onFolderButtonPress" visible="{= ${fastData>FoldersCreated} === 1}"/>
					<m:Button id="refreshButtonId" icon="sap-icon://refresh" type="Emphasized" press="onRefresh" enabled="true"/>
					<!--<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditButtonPress" enabled="true"/>-->
					<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditButtonPress" enabled="true}"/>
				</actions>
				
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>
		
		<!-- HEADER INFORMATION: this part will be collapsed when scrolling down -->
		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
				
				<!-- LOGO 
				<f:Avatar src="{imageModel>/path}/Company-Logo-Blue.svg" displaySize="L" displayShape="Square" class="sapUiTinyMarginEnd"></f:Avatar>
				-->
				
				<!-- INSTITUTE INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>Institute}"/>
					<m:Text id="idhdrInstNme" text="{fastData>Institute/InstituteName}"/>
					<m:Text id="idhdrInstID" text="{fastData>Institute/InstituteID}" visible="false"/>
				</m:VBox>
				
				<!-- SELECTED TENDER INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>TenderName}"/>
					<m:Text id="idHdrTndrNme" text="{fastData>TenderName}"/>
				</m:VBox>
				
				<!-- SELECTED OFFER INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>OfferID}"/>
					<m:Text  text="{= ${fastAppData>/SelectedOfferID} === '' ? 'No offer selected' : ${fastAppData>/SelectedOfferID} }"/>
				</m:VBox>

				<!-- SELECTED PRODUCT INFO -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>productnme}"/>
					<m:Text text="{= ${fastAppData>/SelectedProductName} === '' ? 'No product selected' : ${fastAppData>/SelectedProductName} }"/>
				</m:VBox>				
				
				<!-- Tender origin -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd" visible="{= ${fastAppData>/Tender/CountryCode} === 'MX' ? true : false }">
				<!--<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd" visible="{= ${fastAppData>/CountryTenderOrigin/length} > 2 ? true : false}">-->
					<m:Label text="{i18n>tenderOrigin}"/>
					<m:Text text="{fastData>Origin/CODE}"/>		
				</m:VBox>

				<!-- Tender origin -->
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd" visible="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? true : false }">
				<!--<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd" visible="{= ${fastAppData>/CountryTenderOrigin/length} > 2 ? true : false}">-->
					<m:Label text="{i18n>mercadoreference}"/>
					<m:Text text="{fastData>CountrySpecificInformation/TenderReference}"/>		
				</m:VBox>
				
			</m:FlexBox>
		</headerContent>
		
		<!-- TABS -->
		<sections>
			
			<!-- BASIC INFORMATION TAB -->
			<ObjectPageSection id="basicInformationId" title="{i18n>basicInformation}" visible="{fastAppData>/permissions/tabs/basicInformationId/visible}">
				<subSections>
					<ObjectPageSubSection id="basicInformationSubSectionId">
						<core:Fragment fragmentName="FAST_NS0FAST0.view.fragments.BasicInformationView" type="XML" id="basicInformationFragmentId"/>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			
			<!-- OFFER PRODUCTS TAB -->
			<ObjectPageSection id="offerProductsId" title="{i18n>OfferProducts}" showTitle="true" visible="{fastAppData>/permissions/tabs/offerProductsId/visible}">
				<subSections>
					<core:Fragment fragmentName="FAST_NS0FAST0.view.fragments.OfferProductsView" type="XML" id="offerProductsFragmentId"/>
				</subSections>
			</ObjectPageSection>
			
			<!-- FINANCIAL OFFER TAB -->
			<ObjectPageSection id="financialOfferId" title="{i18n>FinancialOffer}" showTitle="true" visible="{fastAppData>/permissions/tabs/financialOfferId/visible}">
				<subSections>
					<core:Fragment fragmentName="FAST_NS0FAST0.view.fragments.FinancialOfferView" type="XML" id="financialOfferFragmentId"/>
				</subSections>
			</ObjectPageSection>

			<!-- FINANCIAL OFFER ITALY TAB -->
			<ObjectPageSection id="financialOfferId_IT" title="{i18n>FinancialOffer}" showTitle="true" visible="{fastAppData>/permissions/tabs/financialOfferId_IT/visible}">
				<subSections>
					<ObjectPageSubSection id="financialOffer_IT_SubSectionId">
						<mvc:XMLView id="financialOfferViewId_IT" viewName="FAST_NS0FAST0.view.FinancialOffer_IT"/>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<!-- FINANCIAL OFFER SPAIN TAB -->
			<ObjectPageSection id="financialOfferId_ES" title="{i18n>FinancialOffer}" showTitle="true" visible="{fastAppData>/permissions/tabs/financialOfferId_ES/visible}">
				<subSections>
					<ObjectPageSubSection id="financialOffer_ES_SubSectionId">
						<mvc:XMLView id="financialOfferViewId_ES" viewName="FAST_NS0FAST0.view.FinancialOffer_ES"/>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

            <!-- FINANCIAL OFFER BRAZIL TAB -->
			<ObjectPageSection id="financialOfferId_BR" title="{i18n>FinancialOffer}" showTitle="true" visible="{fastAppData>/permissions/tabs/financialOfferId_BR/visible}">
				<subSections>
					<ObjectPageSubSection id="financialOffer_BR_SubSectionId">
						<mvc:XMLView id="financialOfferViewId_BR" viewName="FAST_NS0FAST0.view.FinancialOffer_BR"/>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<!-- QUOTATION TAB -->
			<ObjectPageSection id="quotationId" title="{i18n>Quotation}" visible="{fastAppData>/permissions/tabs/quotationId/visible}">
				<subSections>
					<core:Fragment id="quotationFragmentId" type="XML" fragmentName="FAST_NS0FAST0.view.fragments.QuotationView"/>
				</subSections>
			</ObjectPageSection>
			
			<!-- TENDER RESULTS TAB -->
			<ObjectPageSection id="tenderResultsId" title="{i18n>TenderResults}" visible="{fastAppData>/permissions/tabs/tenderResultsId/visible}">
				<subSections>
					<core:Fragment id="tenderResultsFragmentId" type="XML" fragmentName="FAST_NS0FAST0.view.fragments.TenderResults"/>
				</subSections>
			</ObjectPageSection>
						
			<!-- DELIVERY TRACKING TAB -->
			<ObjectPageSection id="deliveryTrackingId" title="{= ${fastAppData>/Tender/CountryCode} === 'CL' ? ${i18n>PurchaseOrders} : ${i18n>DeliveryTracking} }" visible="{fastAppData>/permissions/tabs/deliveryTrackingId/visible}">
				<subSections>
					<ObjectPageSubSection id="deliveryTrackingSubSectionId">
						<mvc:XMLView id="deliveryTrackingViewId" viewName="FAST_NS0FAST0.view.DeliveryTracking"/>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
		
		<!-- footer action buttons -->
		<footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer />
				<m:Button type="Accept" text="{i18n>Save}" press=".onSaveButtonPress"/>
				<m:Button type="Reject" text="{i18n>Cancel}" press=".onCancelButtonPress"/>
			</m:OverflowToolbar>
		</footer>
		
	</ObjectPageLayout>
</mvc:View>