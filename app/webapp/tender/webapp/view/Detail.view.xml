								<m:VBox>
									<!-- Panel for offers so, we can hide the table -->	
									<!--<m:Panel id="panelQuotationOfferTableID" expandable="true" width="auto" class="sapUiResponsiveMargin" expanded="false" expand="onExpandOfferTable" expandAnimation="false">-->
										
										<!-- BUTTONS -->
										<!--<m:headerToolbar>
											<m:OverflowToolbar height="3rem">
												
													<m:Title level="H3" text="Offers"/>
