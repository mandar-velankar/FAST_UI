										</cells>
										<cells>
											<Text text="{fastAppData>INSTITUTE_NAME}"/>
										</cells>
										<cells>
											<Text text="{fastAppData>PRODUCT_NAME}"/>
										</cells>
										<cells>
											<Text text="{fastAppData>UNIT_PRICE}"/>
										</cells>
										<cells>
											<Text text="{fastAppData>PACK_PRICE}"/>
										</cells>
										<cells>
											<Text text="{fastAppData>PVL}"/>
										</cells>
                                        <cells>
											<Text text="{fastAppData>CONFIDENTIAL_PRICE}"/>
										</cells>
                                        <cells>
											<Text text="{fastAppData>PRICE_CONDITION}"/>
										</cells>
										<cells>
											<Text text="{fastAppData>ROYALDECREE}"/>
										</cells>
                                        <cells>
											<Text text="{fastAppData>DISCOUNT}"/>
										</cells>
                                        <cells>
											<Text text="{fastAppData>FOC}"/>
										</cells>
                                        <cells>
											<Text text="{fastAppData>RAPPEL}"/>
										</cells>
                                         <cells>
											<Text text="{fastAppData>OUTCOME}"/>
										</cells>
									</ColumnListItem>
								</items>                             -->
						</Table>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
			</l:BlockLayout>
		</Panel>
	</u:ObjectPageSubSection>
	
</mvc:View>