{
	"_version": "1.7.0",
	"sap.app": {
		"id": "FAST_NS0FAST0",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"applicationVersion": {
			"version": "2.2.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"dataSources": {
			"tender": {
				"uri": "/v2/tender/",
				"type": "OData",
				"settings": {
					"localUri": "localService/tender/metadata.xml"
				}
			}
		},
		"sourceTemplate": {
			"id": "servicecatalog.connectivityComponentForManifest",
			"version": "0.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": [
			"sap_belize"
		]
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "FAST_NS0FAST0.view.App",
			"type": "XML",
			"async": true,
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.30.0",
			"libs": {
				"sap.collaboration": {},
				"sap.f": {},
				"sap.m": {},
				"sap.suite.ui.microchart": {},
				"sap.ui.commons": {},
				"sap.ui.comp": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.ushell": {},
				"sap.uxap": {}
			}
		},
		"resourceRoots":{
		},
		"contentDensities": {
			"compact": true,
			"cozy": false
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "FAST_NS0FAST0.i18n.i18n"
				}
			},
			"fastData": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "tender",
				"preload": true
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css",
					"id": ""
				}
			],
			"js": []
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"viewType": "XML",
				"viewPath": "FAST_NS0FAST0.view",
				"transition": "slide",
				"bypassed": {
					"target": []
				},
				"async": true
			},
			"routes": [
				{
					"pattern": "",
					"name": "launch",
					"target": "launch"
				},
				{
					"pattern": ":country:/:layout:",
					"name": "master",
					"target": [
						"master",
						"detail"
					]
				},
				{
					"pattern": "detail/{country}/{tender}/:offer:/:tab:/:samePage:/{layout}",
					"name": "detail",
					"target": [
						"master",
						"detail"
					]
				},
				{
					"pattern": "detail/{tender}/detailDetail/{institute}/{layout}",
					"name": "detailDetail",
					"target": [
						"master",
						"detail",
						"detailDetail"
					]
				},
				{
					"pattern": "aboutPage",
					"name": "aboutPage",
					"target": "aboutPage",
					"layout": "EndColumnFullScreen"
				}
			],
			"targets": {
				"launch": {
					"viewName": "Main",
					"viewLevel": 1,
					"controlId": "app",
					"controlAggregation": "pages"
				},
				"tendermngt": {
					"viewName": "TenderManagement",
					"viewLevel": 1,
					"controlId": "app",
					"controlAggregation": "pages"
				},
				"master": {
					"viewName": "TenderMaster",
					"parent": "tendermngt",
					"controlId": "flexibleColumnLayout",
					"controlAggregation": "beginColumnPages",
					"viewLevel": 2
				},
				"detail": {
					"viewName": "Detail",
					"viewId": "tenderManagementDetailId",
					"parent": "tendermngt",
					"controlId": "flexibleColumnLayout",
					"controlAggregation": "midColumnPages",
					"viewLevel": 2
				},
				"detailDetail": {
					"viewName": "DetailDetail",
					"parent": "tendermngt",
					"controlId": "flexibleColumnLayout",
					"controlAggregation": "endColumnPages",
					"viewLevel": 2
				},
				"aboutPage": {
					"viewName": "AboutPage",
					"parent": "tendermngt",
					"controlId": "flexibleColumnLayout",
					"controlAggregation": "endColumnPages",
					"viewLevel": 2
				}
			}
		}
	}
}