<mvc:View controllerName="com.bayer.tender.contracts.controller.DeliveryTracking" xmlns="sap.uxap" xmlns:m="sap.m" xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	
		<l:BlockLayout background="Light">
			<l:BlockLayoutRow>
				<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">
					<m:VBox>
						<m:Label/>
						<!-- TABLE WITH PRODUCTS FOR DELIVERY TRACKING -->
						<m:Table
							id="idDeliveryTrackViewProductTable" inset="false" 
							class="sapFDynamicPageAlignContent" width="auto"
							items="{ 
								path: 'ctr>/currentContract/products',
								sorter: {path: 'sorter', descending: false},
								filters: [
									{path: 'enabled', operator: 'EQ', value1: true}
								]
							}"
							mode="SingleSelectMaster" 
							selectionChange="onProductItemSelect"
							updateFinished="onBindingProductsFinished"
							visible="true">
							<m:columns>
								<m:Column>
									<m:Text text="{i18n>product}"/>
								</m:Column>
							</m:columns>
							<m:items>
								<m:ColumnListItem type="Navigation"
									press="onProductItemSelect">
									<m:cells>
										<m:Text text="{ctr>product/pRODUCTPACKNAME}"/>
									</m:cells>
								</m:ColumnListItem>
							</m:items>
						</m:Table>
					</m:VBox>
				</l:BlockLayoutCell>
			</l:BlockLayoutRow>
		</l:BlockLayout>

	
</mvc:View>