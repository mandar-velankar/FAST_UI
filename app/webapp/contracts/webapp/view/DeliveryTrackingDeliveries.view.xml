<mvc:View controllerName="com.bayer.tender.contracts.controller.DeliveryTracking" xmlns="sap.uxap" xmlns:m="sap.m" xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:t="sap.ui.table" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
	
		
			<m:VBox>
				<!-- Buttons for editing -->
				<m:Toolbar design="Solid">
					<m:ToolbarSpacer/>
					<m:Button id="idAddDelv" visible="{ctr>/editMode}" text="{i18n>AddDelivery}" icon="sap-icon://add" press="onAddDelivery"/>
					<!--<m:Button id="idDelDelv" visible="false" text="{i18n>DeleteDelivery}" icon="sap-icon://delete" press="onDeleteDeliverie" enabled="{= ${fastAppData>/SelectedDeliverieProduct/Deliveries/results/length} > 0 }"/>-->
				</m:Toolbar>
				<!-- Deliveries table -->
				<m:Table 
					id="deliveriesTableID" 
					popinLayout="GridSmall" 
					mode="{= ${ctr>/editMode} === true ? 'Delete' : 'SingleSelectMaster'}"
					delete=".onDeleteDelivery" 
					selectionChange=".onDeliveryItemSelect"
					items="{
						path: 'ctr>/currentContract/selectedProduct/deliveries',
						filters: [
							{path: 'enabled', operator: 'EQ', value1: true}
						]
					}"
				>
					<m:columns>
						<m:Column width="7rem">
							<m:Label text="{i18n>LocalOrDicectDelivery}" required="{= ${ctr>/editMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>PlannedInAPO}" required="{= ${ctr>/editMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="8.5rem">
							<m:Label text="{i18n>RequestedDeliveryDate}" required="{= ${ctr>/editMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>RequestedQuantity}" required="{= ${ctr>/editMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="8.5rem">
							<m:Label text="{i18n>ActualDeliveryDate}" required="{= ${ctr>/editMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>ActualDeliveryQuantity}" required="{= ${ctr>/editMode} === true ? true : false}" wrapping="true"/>
						</m:Column>
						<!--<m:Column width="6rem">
							<m:Label text="{i18n>PaidOrFree}" required="{= ${ctr>/editMode} === true ? true : false}" wrapping="true"/>
						</m:Column>-->
						<m:Column width="6rem">
							<m:Label text="{i18n>PONumber}" wrapping="true"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>InvoiceNo}" wrapping="true"/>
						</m:Column>
						<!--<m:Column width="5.5rem">
							<m:Label text="{i18n>Penalty}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>
						<m:Column width="6rem">
							<m:Label text="{i18n>Compensated}" required="{= ${ctr>/editMode} === true ? true : false}"/>
						</m:Column>-->
					</m:columns>
					<m:items>
						<m:ColumnListItem id="deliveriesTableListID" type="{= ${ctr>/editMode} === true ? 'DetailAndActive' : 'Navigation'}"
							press=".onDeliveryItemSelect" detailPress=".onDeliveryItemSelect">
							<m:cells>
								<m:Select selectedKey="{ctr>localOrDirect}" enabled="false">
									<m:items>
										<core:Item text="Direct" key="D"/>
										<core:Item text="Local" key="L"/>
									</m:items>
								</m:Select>
								<m:Select selectedKey="{ctr>plannedInApo}" enabled="false">
									<m:items>
										<core:Item text="Yes" key="Yes"/>
										<core:Item text="No" key="No"/>
									</m:items>
								</m:Select>
								<m:DatePicker
									value="{path :'ctr>requestedDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="{i18n>RequestedDeliveryDate}" enabled="false" placeholder="{i18n>Select_date}"/>
								<m:Input value="{ctr>requestedDeliveryQuantity}" type="Number" enabled="false"/>
								<m:DatePicker
									value="{path :'ctr>actualDeliveryDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}"
									tooltip="{i18n>EffDate}" enabled="false" placeholder="{i18n>Select_date}"/>
								<m:Input value="{ctr>actualDeliveryQuantity}" type="Number" enabled="false" required="true"/>
								<!--<m:Select selectedKey="{ctr>paidOrFree}" enabled="false">
									<m:items>
										<core:Item text="Paid" key="Paid"/>
										<core:Item text="Free" key="Free"/>
									</m:items>
								</m:Select>-->
								<m:Input value="{ctr>pO}" enabled="false"/>
								<m:Input value="{ctr>invoiceNo}" enabled="false"/>
								<!--<m:Select id="idPenaltyDrop" selectedKey="{ctr>penalty}" change="onChangePenalty" enabled="false">
									<m:items>
										<core:Item text="No" key="false"/>
										<core:Item text="Yes" key="true"/>
									</m:items>
								</m:Select>
								<m:Select id="idCompensatedDrop" selectedKey="{ctr>compensated}" change="onChangeCompensated" enabled="false">
									<m:items>
										<core:Item text="Yes" key="Yes"/>
										<core:Item text="No" key="No"/>
									</m:items>
								</m:Select>-->
							</m:cells>
						</m:ColumnListItem>
					</m:items>
				</m:Table>
			</m:VBox>
		

	
</mvc:View>