<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<ViewSettingsDialog
		id="viewSettingsDialog"
		confirm=".onConfirmViewSettingsDialog">
		<sortItems>
			<ViewSettingsItem
				text="{i18n>sortByBrand}"
				key="BrandName"
				selected="true"
			/>
		</sortItems>
		<filterItems>
			<ViewSettingsFilterItem
				id="filterCountryItems"
				text="{i18n>Country}"
				multiSelect="false"
				items="{path: 'ppa>/countries', 
								filters: {
									filters: [
										{ path: 'Application', operator: 'EQ', value1: 'PPA' },
										{ path: 'Application', operator: 'EQ', value1: 'ALL' }
									],
									and: false
						}}">
				<items>
					<ViewSettingsItem 
						selected="{= ${ppa>country/countryCode} === 'TH'}"
						key="{ppa>country/countryCode}"
						text="{ppa>country/countryName}" 
					/>
				</items>
			</ViewSettingsFilterItem>
			<ViewSettingsFilterItem
				id="filterDivisionItems"
				text="{i18n>Division}"
				multiSelect="false"
				items="{path: 'ppa>/divisions'}">
				<items>
					<ViewSettingsItem 
						key="{ppa>divisionId}"
						text="{ppa>divisionName}" 
					/>
				</items>
			</ViewSettingsFilterItem>
		</filterItems>
	</ViewSettingsDialog>

</core:FragmentDefinition>