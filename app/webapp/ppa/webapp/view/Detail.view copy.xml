<mvc:View
	controllerName="com.bayer.tender.ppa.controller.Detail"
	xmlns="sap.uxap" 
	xmlns:m="sap.m"
	xmlns:semantic="sap.f.semantic"
	xmlns:mvc="sap.ui.core.mvc">

	<semantic:SemanticPage
		id="detailPage"
		busy="{detailView>/busy}"
		busyIndicatorDelay="{detailView>/delay}">

		<semantic:titleHeading>
			<m:Title text="{i18n>titleDetailPage}" level="H2"/>
		</semantic:titleHeading>

		<semantic:content>

			<!-- Sections with diferent tabs -->
		<sections>
			<ObjectPageSection titleUppercase="false" title="examples">
				<subSections>

					<ObjectPageSubSection title="Subsection with action buttons" titleUppercase="false">
						<blocks>
							<blockcolor:BlockBlue id="b1"/>
						</blocks>
						<actions>
							<m:Button icon="sap-icon://synchronize"/>
							<m:Button icon="sap-icon://expand"/>
						</actions>
					</ObjectPageSubSection>

					<ObjectPageSubSection title="Subsection without action buttons" titleUppercase="false">
						<blocks>
							<blockcolor:BlockBlue id="b2"/>
						</blocks>

					</ObjectPageSubSection>


				</subSections>
			</ObjectPageSection>
		</sections>
			
		</semantic:content>

		<!-- close detail screen -->
		<semantic:closeAction>
			<semantic:CloseAction
					id="closeColumn"
					press=".onCloseDetailPress"/>
		</semantic:closeAction>

		<!-- full screen for application -->
		<semantic:fullScreenAction>
			<semantic:FullScreenAction
					id="enterFullScreen"
					visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}"
					press=".toggleFullScreen"/>
		</semantic:fullScreenAction>

		<!-- exit full screen for application -->
		<semantic:exitFullScreenAction>
			<semantic:ExitFullScreenAction
					id="exitFullScreen"
					visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"
					press=".toggleFullScreen"/>
		</semantic:exitFullScreenAction>

	</semantic:SemanticPage>

</mvc:View>