<!-- Fragment for policy tab -->
<core:FragmentDefinition 
	xmlns:u="sap.uxap" 	
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:semantic="sap.f.semantic"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout"
	xmlns:form="sap.ui.layout.form">

	<VBox>
		<HBox>
			<VBox width="50%">
				<!-- Brand Policy panel -->
				<Panel expandable="false" width="100%">

					<!-- Toolbar for Brand Policy -->
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Brand Policy for {ppa>/brand/brandName} "/>
							<ToolbarSpacer />
							<Button id="idBtnEditEffctvDate" text="Edit" visible="true" 
									enabled="{= ${ppa>/approvalRequest/status} !== 'Awaiting Approval' &amp;&amp; !${ppa>/productPolicy/mspEditMode} }" 
									press=".onEditEffctvDate"
							/>
						</OverflowToolbar>
					</headerToolbar>
					<content>
						<form:SimpleForm 
							editable="true" layout="ResponsiveGridLayout" 
							labelSpanL="1" labelSpanM="1" labelSpanS="1"
							columnsXL="1" columnsL="1" columnsM="1"
							adjustLabelSpan="false" 
							singleContainerFullSize="false">
							
							<form:content>
								<VBox>
									<HBox>
										<!-- Labels -->
										<VBox width="200px">
											<Text text="Draft Effective Date:"/>
										</VBox>
										<!-- Effective Date -->
										<VBox>
											<DatePicker
												id="idEffectiveDate"
												tooltip="{i18n>Effective Date}"
												placeholder="{i18n>Select_date}"
												change="handleEffectiveDateChange"
												enabled="false"
												minDate="{= ${ppa>/aggregatedBrandPolicy/approvedBrandPolicy/validFrom} ? ${ppa>/aggregatedBrandPolicy/approvedBrandPolicy/validFrom} : ${dateModel>/minDate} }"
												value="{
															path : 'ppa>/aggregatedBrandPolicy/draftBrandPolicy/validFrom',
															type: 'sap.ui.model.type.Date', 
															formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}
														}"
											/>
										</VBox>
									</HBox>	

									<HBox>
										<!-- Labels -->
										<VBox width="200px">
											<Text text="Last Approved Effective Date:"/>
										</VBox>
										<!-- Effective Date -->
										<VBox>
											<DatePicker
												id="idLatestApprEffectiveDate"
												tooltip="{i18n>Effective Date}"
												placeholder="{i18n>Select_date}"
												change="handleEffectiveDateChange"
												enabled="false"
												minDate="{dateModel>/minDate}"
												value="{
															path :'ppa>/aggregatedBrandPolicy/approvedBrandPolicy/validFrom', 
															type: 'sap.ui.model.type.Date', 
															formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}
														}"
											/>
										</VBox>
									</HBox>	
									
									<!-- Save & Cancel buttons -->
									<HBox>
										<HBox width="100%" alignItems="center" class="sapUiSmallMarginTop">
											<Button id="idBtnSaveEffctvDate" text="Save" type="Accept" press="onSaveEffctvDate" visible="false" enabled="{dateModel>/enabled}" class="sapUiTinyMarginEnd"/>
											<Button id="idBtnCancelEffctvDate" text="Cancel" type="Reject" press="onCancelEffctvDate" visible="false" />	
										</HBox>	
									</HBox>
								</VBox>
							</form:content>
						</form:SimpleForm>
					</content>
				</Panel>
			</VBox>
			<VBox width="50%">
				<!-- Price Reduction panel -->
				<Panel expandable="false" width="100%">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Price reduction"/>
							<ToolbarSpacer />
							<Button id="idBtnEditPriceReduction" text="Edit" visible="true" 
									enabled="{= ${ppa>/approvalRequest/status} !== 'Awaiting Approval' &amp;&amp; (${ppa>/brandPolicy/status} === 'Approved' ? false : !!${ppa>/brand/validFrom}) }" 
									press="onEditPriceReduction"
							/>
						</OverflowToolbar>
					</headerToolbar>
					<content>
						<form:SimpleForm 
							editable="true" layout="ResponsiveGridLayout" 
							labelSpanL="1" labelSpanM="1" labelSpanS="1"
							columnsXL="1" columnsL="1" columnsM="1"
							adjustLabelSpan="false" 
							singleContainerFullSize="false">
							<form:content>
								<VBox>

									<HBox>

										<!-- Labels -->
										<VBox width="80px">
											<Text text="MSP Price:"/>
										</VBox>
										<!-- MSP Price -->
										<VBox>
											<Input 
												id="idMspPriceReductionInput"
												type="Number"
												enabled="false"
												value="0"
												editable="{= ${ppa>/productPolicy/priceReductionEditMode} }"
											/>
										</VBox>
										<VBox width="20px" class="sapUiTinyMarginBegin" justifyContent="Center">
											<Label text="%"/>
										</VBox>
									</HBox>	
									<HBox>
										<!-- Labels -->
										<VBox width="80px">
											<Text text="NSP Price:"/>
										</VBox>
										<!-- NSP Price -->
										<VBox>
											<Input 
												id="idNspPriceReductionInput"
												type="Number"
												enabled="false"
												value="0"
												editable="{= ${ppa>/productPolicy/priceReductionEditMode} }"
											/>
										</VBox>
										<VBox width="20px" class="sapUiTinyMarginBegin" justifyContent="Center">
											<Label text="%"/>
										</VBox>
									</HBox>
									<!-- Save & Cancel buttons -->
									<HBox>
										<HBox width="100%" alignItems="center" class="sapUiSmallMarginTop">
											<Button id="idBtnSavePriceReduction" text="Save" type="Accept" press="onSavePriceReduction" visible="false" class="sapUiTinyMarginEnd"/>
											<Button id="idBtnCancelPriceReduction" text="Cancel" type="Reject" press="onCancelPriceReduction" visible="false" />	
										</HBox>	
									</HBox>
								</VBox>
							</form:content>
						</form:SimpleForm>
					</content>
				</Panel>
			</VBox>
			
		</HBox>
		<!-- Products Panel -->
		<Panel expandable="false" width="100%">
			<!-- Toolbar for Products panel -->
			<headerToolbar>
				<OverflowToolbar>
					<Title text="Products"/>
				</OverflowToolbar>
			</headerToolbar>
			<content>
				<!-- diferent colour for backround products table-->
				<l:BlockLayout background="Light">

					<l:BlockLayoutRow>
						<l:BlockLayoutCell backgroundColorSet="ColorSet10" backgroundColorShade="ShadeA">

							<!--TABLE WITH PRODUCTS FOR DELIVERY TRACKING -->
							<Table id="idProductsTable" inset="false" 
								class="sapFDynamicPageAlignContent" width="auto"
								visible="true"
								mode="SingleSelectMaster"
								selectionChange="onProductItemSelect"
								items="{path:'ppa>/products', templateShareable:false}">

								<!-- table header with title & buttons -->
								<headerToolbar>
										<OverflowToolbar>
											<content>
												<ToolbarSpacer />
												<!-- This will be handled outside this application -->
												<Button id="idBtnRefreshPolicy" icon="sap-icon://refresh" text="{i18n>Refresh}" type="Default" press="onRefreshPolicyPress" enabled="true"/>
											</content>
										</OverflowToolbar>
								</headerToolbar>

								<columns>
									<Column>
										<Text text="{i18n>product}"/>
									</Column>
									<Column>
										<Text text="{i18n>listPrice}"/>
									</Column>
									<Column>
										<Text text="{i18n>mspStatus}"/>
									</Column>
									<Column>
										<Text text="{i18n>nspStatus}"/>
									</Column>
								</columns>
								<items>
									<ColumnListItem type="Navigation">
										<cells>
											<Text text="{ppa>productName}"/>
										</cells>
										<cells>
											<VBox>
												<Text 
													text="{
														path:'ppa>listPrice', 
														type: '.customTypes.Price'
													} {ppa>currency}"
													visible="{= ${ppa>listPrice} !== '' ? true : false }"
												/>
												<ObjectStatus
													text="No Price"
													state="Error" 
													visible="{= ${ppa>listPrice} === '' ? true : false }"
												/>
											</VBox>
										</cells>
										<cells>
											<ObjectStatus
												class="sapUiSmallMarginBottom"
												text="{ppa>mspStatus}"
												state="{parts:[{path:'ppa>mspStatus'}], formatter: '.formatter.status'}"
											/>
										</cells>
										<cells>
											<ObjectStatus
												class="sapUiSmallMarginBottom"
												text="{ppa>nspStatus}"
												state="{parts:[{path:'ppa>nspStatus'}], formatter: '.formatter.status'}"
											/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>

						</l:BlockLayoutCell>
					</l:BlockLayoutRow>
				</l:BlockLayout>

			</content>
		</Panel>

		<VBox id="idProductPricingFragment">
		</VBox>
	</VBox>

</core:FragmentDefinition>