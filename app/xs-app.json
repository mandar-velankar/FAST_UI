{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "/PolicyPricingService/(.*)$",
      "target": "/ppa/$1",
      "authenticationType": "basic",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/FAST/PolicyPricingService/(.*)$",
      "target": "/FAST/ppa/$1",
      "authenticationType": "basic",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/FAST/(.*)$",
      "target": "/FAST/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/ODataDev/(.*)$",
      "target": "/ODataDev/$1",
      "authenticationType": "basic",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "^/app/(.*)$",
      "target": "$1",
      "localDir": "dist/landingspage/webapp"
    },
    {
      "source": "^/appdebug/(.*)$",
      "target": "$1",
      "localDir": "webapp/landingspage/webapp"
    },
    {
      "source": "^/epa/(.*)$",
      "target": "$1",
      "localDir": "dist/epa/webapp"
    },
    {
      "source": "^/contracts/(.*)$",
      "target": "$1",
      "localDir": "dist/contracts/webapp"
    },
    {
      "source": "^/tender/(.*)$",
      "target": "$1",
      "localDir": "dist/tender/webapp"
    },
    {
      "source": "^/ppa/(.*)$",
      "target": "$1",
      "localDir": "dist/ppa/webapp"
    },
    {
      "source": "^/uilib/(.*)$",
      "target": "$1",
      "localDir": "dist/uilib/src/com/bayer/tender/uilib"
    },
    {
      "source": "^/pdf/(.*)$",
      "target": "$1",
      "localDir": "dist/pdf"
    },
    {
      "source": "^/reporting/(.*)$",
      "target": "/FAST/$1",
      "authenticationType": "basic",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "/FAST/$1",
      "authenticationType": "basic",
      "destination": "srv_api",
      "csrfProtection": true
    }
  ]
}