{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "/v4/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/v2/(.*)$",
      "target": "/v2/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "^/app/(.*)$",
      "target": "$1",
      "localDir": "dist"
    },
    {
      "source": "^/appdebug/(.*)$",
      "target": "$1",
      "localDir": "webapp"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "localDir": "dist"
    }
  ]
}