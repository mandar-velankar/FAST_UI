{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/app/logged-out.html"
  },
  "routes": [
    {
      "source": "/v4/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/v2/(.*)$",
      "target": "/v2/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/app/admin/(.*)$",
      "target": "$1",
      "destination": "adminapp"
    },
    {
      "source": "/admin/(.*)$",
      "target": "$1",
      "destination": "adminapp"
    },
    {
      "source": "^/app/index.html(.*)$",
      "localDir": "dist/landingspage/webapp",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/app/(.*)$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/appdebug/(.*)$",
      "target": "$1",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/salesopportunity/(.*)$",
      "target": "$1",
      "localDir": "dist/salesopportunity/webapp"
    },
    {
      "source": "/createsalesopportunity/(.*)$",
      "target": "$1",
      "destination": "createSalesOppApp"
    },    
    {
      "source": "^(.*)$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "xsuaa"
    }
  ]
}