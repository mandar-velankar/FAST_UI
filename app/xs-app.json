{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "/v4/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/v2/(.*)$",
      "target": "/v2/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "localDir": "dist"
    },
    {
      "source": "^/appdebug/(.*)$",
      "target": "$1",
      "localDir": "webapp/landingspage/webapp"
    },
    {
      "source": "^/epa/(.*)$",
      "target": "$1",
      "localDir": "dist/epa/webapp"
    },
    {
      "source": "^/contracts/(.*)$",
      "target": "$1",
      "localDir": "dist/contracts/webapp"
    },
    {
      "source": "^/tender/(.*)$",
      "target": "$1",
      "localDir": "dist/tender/webapp"
    },
    {
      "source": "^/ppa/(.*)$",
      "target": "$1",
      "localDir": "dist/ppa/webapp"
    },
    {
      "source": "^/uilib/(.*)$",
      "target": "$1",
      "localDir": "dist/uilib/src/com/bayer/tender/uilib"
    },
    {
      "source": "^/pdf/(.*)$",
      "target": "$1",
      "localDir": "dist/pdf"
    }
  ]
}