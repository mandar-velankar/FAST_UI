{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/app/logged-out.html"
  },
  "routes": [
    {
      "source": "/v4/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/v2/(.*)$",
      "target": "/v2/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },{
      "source": "^/app/index.html(.*)$",
      "localDir": "dist/landingspage/webapp",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/app/(.*)$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/tender/(.*)$",
      "target": "$1",
      "localDir": "dist/tender/webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/epa/(.*)$",
      "target": "$1",
      "localDir": "dist/epa/webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/contracts/(.*)$",
      "target": "$1",
      "localDir": "dist/contracts/webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/ppa/(.*)$",
      "target": "$1",
      "localDir": "dist/ppa/webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/appdebug/(.*)$",
      "target": "$1",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "xsuaa"
    }
  ]
}