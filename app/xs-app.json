{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/app/logged-out.html"
  },
  "routes": [
    {
      "source": "/app/whc/v2/(.*)$",
      "target": "/v2/$1",
      "authenticationType": "xsuaa",
      "destination": "fast-whc-api",
      "csrfProtection": true
    },
    {
      "source": "/whc/v2/catalog/(.*)$",
      "target": "/v2/catalog/$1",
      "authenticationType": "xsuaa",
      "destination": "fast-whc-api",
      "csrfProtection": true
    },
    {
      "source": "/app/ccma/odata/(.*)$",
      "target": "/odata/$1",
      "authenticationType": "xsuaa",
      "destination": "fast-ccma-api",
      "csrfProtection": true
    },
    {
      "source": "/ccma/odata/(.*)$",
      "target": "/odata/$1",
      "authenticationType": "xsuaa",
      "destination": "fast-ccma-api",
      "csrfProtection": true
    },
    {
      "source": "/ccmabasic/odata/(.*)$",
      "target": "/odata/$1",
      "authenticationType": "basic",
      "destination": "fast-ccma-api",
      "csrfProtection": false
    },
    {
      "source": "/v4/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/v2/(.*)$",
      "target": "/v2/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/UITemplates/(.*)$",
      "target": "/UITemplates/$1",
      "authenticationType": "xsuaa",
      "destination": "fast-templates-api",
      "csrfProtection": true
    },
    {
      "source": "/cs/(.*)$",
      "target": "/cs/$1",
      "authenticationType": "xsuaa",
      "destination": "fast-templates-api",
      "csrfProtection": true
    },
    {
      "source": "/app/admin/(.*)$",
      "target": "$1",
      "destination": "adminapp"
    },
    {
      "source": "/admin/(.*)$",
      "target": "$1",
      "destination": "adminapp"
    },
    {
      "source": "/app/createsalesopportunity/(.*)$",
      "target": "$1",
      "destination": "createSalesOppApp"
    },  
    {
      "source": "/createsalesopportunity/(.*)$",
      "target": "$1",
      "destination": "createSalesOppApp"
    }, 	
    {
      "source": "/app/bankguarantees/(.*)$",
      "target": "$1",
      "destination": "bankGuaranteesApp"
    },  
    {
      "source": "/bankguarantees/(.*)$",
      "target": "$1",
      "destination": "bankGuaranteesApp"
    },  
    {
      "source": "/app/brazilcontracting/(.*)$",
      "target": "$1",
      "destination": "brazilContractingApp"
    },  
    {
      "source": "/brazilcontracting/(.*)$",
      "target": "$1",
      "destination": "brazilContractingApp"
    }, 
    {
      "source": "/app/priceagreements/(.*)$",
      "target": "$1",
      "destination": "priceAgreementsApp"
    },  
    {
      "source": "/priceagreements/(.*)$",
      "target": "$1",
      "destination": "priceAgreementsApp"
    },
    {
      "source": "^/standardtender/(.*)",
      "target": "/combayertenderstatenderapp/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/app/standardtender/(.*)",
      "target": "/combayertenderstatenderapp/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/ccma/(.*)",
      "target": "/combayertenderccma/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/app/ccma/(.*)",
      "target": "/combayertenderccma/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/whc/(.*)",
      "target": "/combayertenderwhcapp/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/app/whc/(.*)",
      "target": "/combayertenderwhcapp/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/claims/(.*)",
      "target": "/combayertenderclaims/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/app/claims/(.*)",
      "target": "/combayertenderclaims/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/app/index.html(.*)$",
      "target":"index.html$1",
      "localDir": "dist",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/app/(.*)$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/appdebug/(.*)$",
      "target": "$1",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    },     
    {
      "source": "^(.*)$",
      "target": "$1",
      "localDir": "dist",
      "authenticationType": "xsuaa"
    }
  ]
}