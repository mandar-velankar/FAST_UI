name: lint
on:
  push:
    branches:
      - '*'
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v2
    - name: Install eslint
      working-directory: ./app
      run: npm i eslint
    - name: Run a ESLint
      working-directory: ./app
      run: npm run lint
    - name: Run a install and build ui5
      working-directory: ./app
      run: npm i